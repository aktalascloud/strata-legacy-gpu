diff --git a/serve/test_connection_deadline.py b/serve/test_connection_deadline.py
new file mode 100644
index 0000000000000000000000000000000000000000..522921a65d09e52f0098ae043bfee3e4514fca48
--- /dev/null
+++ b/serve/test_connection_deadline.py
@@ -0,0 +1,177 @@
+"""A client that has stopped does not own a handler thread, and does not own the engine's single turn.
+
+The handler's connection has a deadline (PEER_STALL_S, STRATA_PEER_STALL_S): the longest a socket operation may block
+with nothing moving either way.  Two peers that used to hold on for good:
+
+  * one that connects and sends nothing at all - not even a request line;
+  * one that asks for a streamed answer and then never reads it, which blocks the write while the generator is
+    suspended inside the turn that holds the engine.
+
+A client that is still working is never cut off: this is a deadline for one stalled operation, not a bound on a
+request, and a peer that keeps sending or reading never reaches it.
+
+    python -m unittest serve.test_connection_deadline -v
+"""
+import json
+import socket
+import time
+import unittest
+from types import SimpleNamespace
+import urllib.request
+from pathlib import Path
+from unittest import mock
+
+import serve.server as server
+from serve.frontend import ChatTemplate
+from serve.server import ByteTokenizer, MockEngine, Service, serve
+
+ROOT = Path(__file__).resolve().parent.parent
+STALL = 1.0                                     # the deadline under test: the tests must not wait for the default
+LONG = "the quick brown fox jumps over the lazy dog. " * 4000   # a script whose SSE encoding outruns the socket buffers
+
+
+def wire(body) -> bytes:
+    b = json.dumps(body).encode()
+    return (b"POST /v1/chat/completions HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\n"
+            b"Content-Length: " + str(len(b)).encode() + b"\r\n\r\n" + b)
+
+
+class PeerStall(unittest.TestCase):
+    def server(self, script: str, small_buffer=False):
+        """A server whose handler was built with the short deadline.  PEER_STALL_S is read where the handler class is
+        made, so it has to be patched around serve() rather than around the requests."""
+        with mock.patch.object(server, "PEER_STALL_S", STALL):
+            tok = ByteTokenizer()
+            svc = Service(MockEngine(tok, script, max_context=65536), tok,
+                          ChatTemplate(ROOT / "serve/chat_template.jinja"))
+            httpd = serve(svc, port=0)
+        if small_buffer:
+            setup = httpd.RequestHandlerClass.setup
+            def small_send_buffer(handler):
+                handler.request.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 4096)
+                setup(handler)
+            httpd.RequestHandlerClass.setup = small_send_buffer
+        self.addCleanup(httpd.server_close)
+        self.addCleanup(httpd.shutdown)
+        return httpd.server_address[1]
+
+    def test_a_client_that_says_nothing_is_let_go(self):
+        port = self.server("hello there")
+        s = socket.create_connection(("127.0.0.1", port), timeout=30)
+        try:
+            s.settimeout(20.0)
+            t0 = time.monotonic()
+            try:
+                first = s.recv(1)              # nothing to read: the server ends the connection instead of waiting
+            except socket.timeout:
+                self.fail("the connection was still held: the handler thread is parked on a client that said nothing")
+            took = time.monotonic() - t0
+            self.assertEqual(first, b"", "the connection is ended, nothing is sent to a client that made no request")
+            self.assertGreaterEqual(took, STALL * 0.5, "the deadline, not a race")
+            self.assertLess(took, 10, "it has to be let go at the deadline")
+        finally:
+            s.close()
+
+    def test_a_stream_nobody_reads_does_not_hold_the_turn(self):
+        port = self.server(LONG, small_buffer=True)
+        # Set before connect: Windows receive autotuning must not absorb the whole synthetic answer.
+        slow = socket.socket()
+        slow.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1024)
+        slow.settimeout(30)
+        slow.connect(("127.0.0.1", port))
+        other = None
+        try:
+            slow.sendall(wire({"messages": [{"role": "user", "content": "hi"}], "max_tokens": 20000, "stream": True}))
+            slow.settimeout(10.0)
+            self.assertTrue(slow.recv(256).startswith(b"HTTP/1.0 200"), "the stream has to open")
+            # from here the client reads nothing, so the server's write blocks with the turn held
+            time.sleep(0.5)
+            other = socket.create_connection(("127.0.0.1", port), timeout=30)
+            other.sendall(wire({"messages": [{"role": "user", "content": "hi"}], "max_tokens": 4}))
+            other.settimeout(20.0)
+            t0 = time.monotonic()
+            answer = other.recv(256)
+            took = time.monotonic() - t0
+            self.assertTrue(answer.startswith(b"HTTP/1.0 200"), answer)
+            self.assertLess(took, 15, "the second client waited for the turn a stalled stream was holding")
+        finally:
+            # closing them releases the server side whatever state it is in, so a failing run cannot park a thread
+            slow.close()
+            if other is not None:
+                other.close()
+
+    def test_a_slow_but_reading_client_is_served(self):
+        # the deadline is per socket operation, so reading a little at a time is not a stall: this one reads the whole
+        # stream, slowly, and has to get all of it
+        port = self.server("the quick brown fox jumps over the lazy dog. " * 100)
+        s = socket.create_connection(("127.0.0.1", port), timeout=30)
+        try:
+            s.sendall(wire({"messages": [{"role": "user", "content": "hi"}], "max_tokens": 20000, "stream": True}))
+            s.settimeout(30.0)
+            seen = b""
+            while b"data: [DONE]" not in seen:
+                piece = s.recv(8192)
+                if not piece:
+                    break
+                seen += piece
+                time.sleep(0.02)               # a reader slower than the writer, but always reading
+            self.assertIn(b"data: [DONE]", seen)
+        finally:
+            s.close()
+
+    def test_the_deadline_can_be_switched_off(self):
+        # 0 means the old behaviour (wait for ever), which is what #1317 chose for the engine's own reads
+        with mock.patch.object(server, "PEER_STALL_S", None):
+            tok = ByteTokenizer()
+            svc = Service(MockEngine(tok, "hello there", max_context=4096), tok,
+                          ChatTemplate(ROOT / "serve/chat_template.jinja"))
+            httpd = serve(svc, port=0)
+        try:
+            self.assertIsNone(httpd.RequestHandlerClass.timeout)
+            s = socket.create_connection(("127.0.0.1", httpd.server_address[1]), timeout=30)
+            try:
+                s.sendall(wire({"messages": [{"role": "user", "content": "hi"}], "max_tokens": 4}))
+                s.settimeout(20.0)
+                self.assertTrue(s.recv(256).startswith(b"HTTP/1.0 200"))
+            finally:
+                s.close()
+        finally:
+            httpd.shutdown()
+            httpd.server_close()
+
+
+class PeerConfiguration(unittest.TestCase):
+    def test_finite_settings_and_invalid_values(self):
+        for value, expected in ((0, None), ('0', None), (-1, None), ('0.25', 0.25),
+                                ('nan', 120), ('inf', 120), ('-inf', 120), ('bad', 120), (None, 120), (False, 120)):
+            with self.subTest(value=value):
+                self.assertEqual(server.peer_stall_timeout(value), expected)
+
+    def test_explicit_config_value_takes_precedence(self):
+        with mock.patch.object(server, 'PEER_STALL_S', 120):
+            self.assertIsNone(server.make_handler(SimpleNamespace(peer_stall_s=server.peer_stall_timeout('0'))).timeout)
+            self.assertEqual(server.make_handler(SimpleNamespace(peer_stall_s=server.peer_stall_timeout('0.2'))).timeout, 0.2)
+
+    def test_long_generation_is_not_a_request_deadline(self):
+        tok = ByteTokenizer()
+        svc = Service(MockEngine(tok, '</think>\n\nhello, steady client', max_context=4096, delay_s=0.02),
+                      tok, ChatTemplate(ROOT / 'serve/chat_template.jinja'))
+        svc.peer_stall_s = 0.2
+        httpd = serve(svc, port=0)
+        try:
+            body = {'messages': [{'role': 'user', 'content': 'hi'}], 'max_tokens': 100}
+            request = urllib.request.Request(f'http://127.0.0.1:{httpd.server_address[1]}/v1/chat/completions',
+                                             data=json.dumps(body).encode(), headers={'Content-Type': 'application/json'})
+            started = time.monotonic()
+            with urllib.request.urlopen(request, timeout=5) as response:
+                result = json.load(response)
+                self.assertEqual(response.status, 200)
+            self.assertGreater(time.monotonic()-started, 2*svc.peer_stall_s)
+            self.assertIn('hello, steady client', result['choices'][0]['message']['content'])
+        finally:
+            httpd.shutdown()
+            httpd.server_close()
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/serve/test_control_notify.py b/serve/test_control_notify.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ffaed10c04e8f432220a9379f64b4f8cf8fb52c
--- /dev/null
+++ b/serve/test_control_notify.py
@@ -0,0 +1,257 @@
+"""Control fairness notifications, without a process, GPU or wall-clock sleeps."""
+import threading
+import collections
+import unittest
+from unittest import mock
+from types import SimpleNamespace
+from serve import server
+from serve.server import EngineDied, QueueWaitExpired, StrataEngine
+
+
+class Condition(threading.Condition):
+    def __init__(self, owner):
+        super().__init__()
+        self.owner = owner
+        self.exits = 0
+        self.after_check = None
+        self.on_wait = None
+        self.waits = []
+        self.notifications = 0
+
+    def __exit__(self, *args):
+        result = super().__exit__(*args)
+        self.exits += 1
+        # The first exit follows registration; the second follows the fairness
+        # predicate read. Inject the producer after that lock was released.
+        if self.exits == 2 and self.after_check is not None:
+            callback, self.after_check = self.after_check, None
+            callback()
+        return result
+
+    def wait(self, timeout=None):
+        self.waits.append(timeout)
+        if self.on_wait:
+            self.on_wait()
+        return True
+
+    def notify_all(self):
+        self.notifications += 1
+        return super().notify_all()
+
+
+class Control:
+    def __init__(self, owner):
+        self.owner = owner
+        self.held = False
+        self.on_acquire = None
+
+    def acquire(self, timeout=None):
+        if self.owner.slot_cv._is_owned():
+            raise AssertionError("blocking control acquire holds slot_cv")
+        if self.on_acquire:
+            return self.on_acquire()
+        self.held = True
+        return True
+
+    def release(self):
+        self.held = False
+
+
+def owner():
+    e = SimpleNamespace(waiting=1, wait_lens=[], ctl_epoch=0, starting=False, live=True, arrivals=collections.deque())
+    e.alive = lambda: e.live
+    e._admit_next = lambda: StrataEngine._admit_next(e)
+    e.slot_cv = Condition(e)
+    e.ctl = Control(e)
+    return e
+
+
+def finish(generator):
+    try:
+        next(generator)
+    except StopIteration as result:
+        return result.value
+    raise AssertionError("unexpected heartbeat")
+
+
+class ControlNotify(unittest.TestCase):
+    def setUp(self):
+        patch = mock.patch.object(server, "ADMIT_SHORT_FIRST", 0)
+        patch.start()
+        self.addCleanup(patch.stop)
+
+    def test_epoch_notify_between_check_and_wait_does_not_wait(self):
+        e = owner()
+        def advance():
+            with e.slot_cv:
+                e.ctl_epoch += 1
+                e.slot_cv.notify_all()
+        e.slot_cv.after_check = advance
+        self.assertTrue(finish(StrataEngine._take_control(e, threading.Event(), 10, after_epoch=0)))
+        self.assertEqual(e.slot_cv.waits, [], "eligible waiter lost its notification and entered timeout wait")
+        self.assertTrue(e.ctl.held)
+        self.assertEqual(e.waiting, 1)
+        self.assertEqual(e.wait_lens, [])
+
+    def test_cancel_removal_notifies_remaining_fairness_waiter(self):
+        e, cancel = owner(), threading.Event()
+        e.slot_cv.on_wait = cancel.set
+        self.assertFalse(finish(StrataEngine._take_control(e, cancel, 10, after_epoch=0)))
+        self.assertEqual(e.waiting, 1)
+        self.assertEqual(e.wait_lens, [])
+        self.assertGreater(e.slot_cv.notifications, 0)
+        self.assertFalse(e.ctl.held)
+
+    def test_fairness_waits_until_epoch_advances(self):
+        e = owner()
+        e.slot_cv.on_wait = lambda: setattr(e, "ctl_epoch", 1)
+        self.assertTrue(finish(StrataEngine._take_control(e, threading.Event(), 10, after_epoch=0)))
+        self.assertEqual(e.slot_cv.waits, [0.5])
+        self.assertEqual(e.ctl_epoch, 2)
+
+    def test_dead_engine_cleans_registration(self):
+        e = owner()
+        e.live = False
+        with self.assertRaises(EngineDied):
+            finish(StrataEngine._take_control(e, threading.Event(), 10))
+        self.assertEqual(e.waiting, 1)
+        self.assertEqual(e.wait_lens, [])
+        self.assertFalse(e.ctl.held)
+
+    def test_restart_wait_does_not_spin_or_hold_control(self):
+        e = owner()
+        e.live, e.starting = False, True
+        e.slot_cv.on_wait = lambda: setattr(e, "live", True)
+        self.assertTrue(finish(StrataEngine._take_control(e, threading.Event(), 10)))
+        self.assertEqual(e.slot_cv.waits, [0.5])
+        self.assertTrue(e.ctl.held)
+
+    def test_control_timeout_observes_cancel(self):
+        e, cancel = owner(), threading.Event()
+        def timeout():
+            cancel.set()
+            return False
+        e.ctl.on_acquire = timeout
+        self.assertFalse(finish(StrataEngine._take_control(e, cancel, 10)))
+        self.assertEqual(e.waiting, 1)
+        self.assertEqual(e.wait_lens, [])
+
+    def test_closing_heartbeat_generator_cleans_and_notifies(self):
+        e = owner()
+        g = StrataEngine._take_control(e, threading.Event(), 10, after_epoch=0)
+        with mock.patch("serve.server.time.monotonic", side_effect=[0, 0, 11, 11]):
+            self.assertIsNone(next(g))
+            g.close()
+        self.assertEqual(e.waiting, 1)
+        self.assertEqual(e.wait_lens, [])
+        self.assertGreater(e.slot_cv.notifications, 0)
+
+    def test_uncontended_acquire_never_waits(self):
+        e = owner()
+        self.assertTrue(finish(StrataEngine._take_control(e, threading.Event(), 10)))
+        self.assertEqual(e.slot_cv.waits, [])
+        self.assertTrue(e.ctl.held)
+
+
+class OrderedControlNotify(unittest.TestCase):
+    def setUp(self):
+        patch = mock.patch.multiple(server, ADMIT_SHORT_FIRST=4, ADMIT_MAX_WAIT_S=10**12)
+        patch.start()
+        self.addCleanup(patch.stop)
+
+    def other(self, e, length=1):
+        entry = [length, 0, True]
+        e.wait_lens.append(entry)
+        return entry
+
+    def remove(self, e, entry):
+        with e.slot_cv:
+            e.wait_lens.remove(entry)
+            e.waiting -= 1
+            e.slot_cv.notify_all()
+
+    def test_shorter_removal_between_check_and_wait_rechecks_order(self):
+        e = owner()
+        shorter = self.other(e)
+        e.slot_cv.after_check = lambda: self.remove(e, shorter)
+        self.assertTrue(finish(StrataEngine._take_control(e, threading.Event(), 100, new=True)))
+        self.assertEqual(e.slot_cv.waits, [])
+        self.assertEqual(e.waiting, 0)
+
+    def test_still_shorter_waiter_is_not_bypassed_by_recheck(self):
+        e = owner()
+        shorter = self.other(e)
+        e.slot_cv.on_wait = lambda: self.remove(e, shorter)
+        self.assertTrue(finish(StrataEngine._take_control(e, threading.Event(), 100, new=True)))
+        self.assertEqual(e.slot_cv.waits, [0.5])
+
+    def test_shorter_arriving_during_acquire_keeps_priority(self):
+        e = owner()
+        calls = []
+        def acquire():
+            calls.append(1)
+            e.ctl.held = True
+            if len(calls) == 1:
+                e.waiting += 1
+                shorter = self.other(e)
+                e.slot_cv.on_wait = lambda: self.remove(e, shorter)
+            return True
+        e.ctl.on_acquire = acquire
+        self.assertTrue(finish(StrataEngine._take_control(e, threading.Event(), 100, new=True)))
+        self.assertEqual(len(calls), 2)
+        self.assertEqual(e.slot_cv.waits, [0.5])
+        self.assertTrue(e.ctl.held)
+
+    def test_three_waiters_cancel_notifies_new_ordered_winner(self):
+        e, cancel = owner(), threading.Event()
+        e.waiting = 2
+        self.other(e, 100)
+        self.other(e, 200)
+        e.slot_cv.on_wait = cancel.set
+        self.assertFalse(finish(StrataEngine._take_control(e, cancel, 1, after_epoch=0, new=True)))
+        self.assertEqual(e.waiting, 2)
+        self.assertEqual(len(e.wait_lens), 2)
+        self.assertGreater(e.slot_cv.notifications, 0)
+
+    def test_three_waiters_generator_close_notifies_new_ordered_winner(self):
+        e = owner()
+        e.waiting = 2
+        self.other(e, 100)
+        self.other(e, 200)
+        g = StrataEngine._take_control(e, threading.Event(), 1, after_epoch=0, new=True)
+        with mock.patch("serve.server.time.monotonic", side_effect=[0, 0, 0, 11, 11]):
+            self.assertIsNone(next(g))
+            g.close()
+        self.assertEqual(e.waiting, 2)
+        self.assertGreater(e.slot_cv.notifications, 0)
+
+    def test_expired_queue_deadline_cleans_without_acquire(self):
+        e, cancel = owner(), threading.Event()
+        cancel._strata_queue_deadline = 1
+        with mock.patch("serve.server.time.monotonic", return_value=2):
+            with self.assertRaises(QueueWaitExpired):
+                finish(StrataEngine._take_control(e, cancel, 100, new=True))
+        self.assertEqual(e.waiting, 1)
+        self.assertEqual(e.wait_lens, [])
+        self.assertFalse(e.ctl.held)
+        self.assertEqual(e.slot_cv.waits, [])
+
+    def test_queue_deadline_after_acquire_releases_control(self):
+        e, cancel = owner(), threading.Event()
+        cancel._strata_queue_deadline = 1
+        now = [0]
+        def acquire():
+            e.ctl.held = True
+            now[0] = 2
+            return True
+        e.ctl.on_acquire = acquire
+        with mock.patch("serve.server.time.monotonic", side_effect=lambda: now[0]):
+            with self.assertRaises(QueueWaitExpired):
+                finish(StrataEngine._take_control(e, cancel, 100, new=True))
+        self.assertEqual(e.waiting, 1)
+        self.assertEqual(e.wait_lens, [])
+        self.assertFalse(e.ctl.held)
+
+
+if __name__ == "__main__":
+    unittest.main()
