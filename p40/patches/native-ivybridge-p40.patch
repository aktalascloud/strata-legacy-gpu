+        if tail.startswith(KEY) or tail.startswith(CALL_END) or (complete and not tail):
+            return at
+        if not tail or KEY.startswith(tail) or CALL_END.startswith(tail):
+            return -2
+        at = text.find(VALUE_END, at + len(VALUE_END))
+    return -1
+
