+  "A request that continues a parked conversation gets its state back instead of reading it again; the oldest goes when the slots or the memory are full.": "При продолжении сохранённого диалога его состояние восстанавливается из кэша. Если места недостаточно, удаляется самый старый диалог.",
+  "GB": "ГБ",
+  "MB/s": "МБ/с",
+  "W": "Вт"
+};
+let lang;try{lang=JSON.parse(localStorage.getItem("strata.language")||'"ru"')}catch(_){lang="ru"}
+if(!["ru","en"].includes(lang))lang="ru";
+const originals=new WeakMap(), attributes=new WeakMap();let observer=null;
+const normalize=s=>s.replace(/\s+/g," ").trim();
+function translate(source){
+ if(lang==="en")return source;
+ const key=normalize(source);let value=RU[key];
+ if(value===undefined){
+  const patterns=[
+   [/^last: (\d+) tokens? at (.+) tok\/s$/,(_,n,speed)=>`последний запрос: ${n} ток., ${speed} ток/с`],
+   [/^([\d\s,.]+) experts cached$/,(_,n)=>`Экспертов в кэше: ${n}`],
+   [/^of ([\d.,]+) W limit$/,(_,n)=>`лимит ${n} Вт`],
+   [/^to GPU (.+)$/,(_,n)=>`в GPU ${n}`],
+   [/^write (.+)$/,(_,n)=>`запись ${n}`],
+   [/^(\d+) cores · (\d+) threads$/,(_,a,b)=>`${a} ядер · ${b} потоков`],
+   [/^(.+), (\d+) threads$/,(_,a,n)=>`${a}, ${n} потоков`],
+   [/^MTP drafts up to ([\d\s.,]+)(?: tokens?)?$/,(_,n)=>`MTP: до ${n.trim()} черновых токенов`],
+   [/^(\d+)-bit \(Hadamard-rotated\), all in VRAM$/,(_,n)=>`${n} бит, преобразование Адамара; целиком в VRAM`],
+   [/^(.+) runs on this PC\. Nothing leaves it\.$/,(_,model)=>`${model} работает на этом компьютере. Данные остаются здесь.`],
+   [/^You · (.*)$/,(_,time)=>`Вы · ${time}`],
+   [/^Thought for ([\d.,]+) s$/,(_,n)=>`Рассуждение: ${n} с`],
+   [/^(\d+) tool calls?$/,(_,n)=>`Вызовы инструментов: ${n}`],
+   [/^(\d+) requests?$/,(_,n)=>`Запросов: ${n}`],
+   [/^(\d+) files?$/,(_,n)=>`Файлов: ${n}`]
+  ];
+  for(const [pattern,replace] of patterns)if(pattern.test(key)){value=key.replace(pattern,replace);break}
+ }
+ if(value===undefined)value=key.replace(/\btokens\/s\b|\btok\/s\b|\bt\/s\b/g,"ток/с").replace(/\bMB\/s\b/g,"МБ/с").replace(/\btokens\b/g,"ток.").replace(/\bMiB\b/g,"МиБ").replace(/\bGiB\b/g,"ГиБ").replace(/\bms\b/g,"мс");
+ value=value.replace(/\bGB\b/g,"ГБ").replace(/\bMB\/s\b/g,"МБ/с");
+ return source.slice(0,source.length-source.trimStart().length)+value+source.slice(source.trimEnd().length);
+}
+function skip(el,attr=false){
+ if(!el)return true;
+ if(el.closest("script,style,[data-i18n-ignore]"))return true;
+ if(nativeCatalog&&el.closest("[data-i18n],[data-i18n-title],[data-i18n-label],[data-i18n-placeholder]"))return true;
+ if(el.closest("button,select,label,option,.msg-error,.think-title,.meta-text,.st-msg__meta,.tool-call__label,.tool-call .st-badge"))return false;
+ if(attr&&el.matches("input,textarea"))return false;
+ return !!el.closest(".st-bubble,.thinking,pre,code,textarea,input,.msg-images,#attachments,.tool-call__pre,.tool-call__preview,.req-preview,.request-preview,[data-user-content]");
+}
+function apply(root=document){
+ if(observer)observer.disconnect();
+ const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let node;
+ while(node=walker.nextNode()){
+  if(skip(node.parentElement)||!node.data.trim())continue;
+  if(!originals.has(node))originals.set(node,node.data);
+  const next=translate(originals.get(node));if(node.data!==next)node.data=next;
+ }
+ const all=root.querySelectorAll?root.querySelectorAll("[title],[aria-label],[placeholder]"):[];
+ for(const el of all){
+  if(skip(el,true))continue;let data=attributes.get(el);if(!data){data={};attributes.set(el,data)}
+  for(const key of ["title","aria-label","placeholder"]){
+   if(!el.hasAttribute(key))continue;if(!(key in data))data[key]=el.getAttribute(key);
+   const next=translate(data[key]);if(el.getAttribute(key)!==next)el.setAttribute(key,next);
+  }
+ }
+ if(!nativeCatalog)document.documentElement.lang=lang;
+ if(observer)observer.observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:["title","aria-label","placeholder"]});
+}
+function setup(){
+ const header=document.querySelector(".st-header,header");
+ if(!nativeCatalog&&header&&!document.getElementById("strata-language")){
+  const select=document.createElement("select");select.id="strata-language";select.className="st-language";select.setAttribute("aria-label","Language");
+  select.innerHTML='<option value="ru">Русский</option><option value="en">English</option>';select.value=lang;
+  select.onchange=()=>{lang=select.value;localStorage.setItem("strata.language",JSON.stringify(lang));apply();window.dispatchEvent(new Event("strata-language-change"))};header.appendChild(select);
+ }
+ observer=new MutationObserver(mutations=>{
+  let changed=false;
+  for(const mutation of mutations){
+   const el=mutation.target.nodeType===3?mutation.target.parentElement:mutation.target;
+   if(skip(el))continue;
+   if(mutation.type==="characterData")originals.delete(mutation.target);
+   if(mutation.type==="attributes"){const data=attributes.get(mutation.target);if(data)delete data[mutation.attributeName]}
+   changed=true;
+  }
+  if(changed)apply();
+ });
+ apply();
+}
+window[nativeCatalog?"StrataI18nChrome":"StrataI18n"]={t:translate,apply,language:()=>lang,keys:Object.keys(RU),setLanguage(code){
+ if(observer)for(const mutation of observer.takeRecords()){
+  if(mutation.type==="characterData")originals.delete(mutation.target);
+  if(mutation.type==="attributes"){const data=attributes.get(mutation.target);if(data)delete data[mutation.attributeName]}
+ }
+ lang=code;apply();
+}};
+if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",setup,{once:true});else setup();
+})();
