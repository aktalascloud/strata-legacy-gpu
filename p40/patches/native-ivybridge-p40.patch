+        check(chain[0].dev_tag == 11 && chain[1].dev_tag == 12 && chain[2].gdn[0] == 5,
+              "dropping a parked image does not consume or alter the live chain");
+        check(cache.bytes() == 0, "the dropped entry is no longer charged");
+
+        std::vector<ConversationCheckpoint> two;
+        ConversationCheckpoint whole = cp({1, 2, 3}, 31, 6);
+        whole.stage_parts.push_back(cp({1, 2, 3}, 32, 7));
+        two.push_back(std::move(whole));
+        auto split = conversation_checkpoints_split(std::move(two), 1);
+        check(split.stage0.size() == 1 && split.stage0[0].dev_tag == 31 && split.parts[0].size() == 1 &&
+              split.parts[0][0].dev_tag == 0 && split.parts[0][0].gdn[0] == 7 && split.parts[0][0].ids == split.stage0[0].ids,
+              "the split preserves bytes/identity but clears the stage part's transient VRAM-copy tag");
+        std::vector<ConversationCheckpoint> back;
+        check(conversation_checkpoints_merge(std::move(split), back) && back.size() == 1 && back[0].dev_tag == 31 &&
+              back[0].stage_parts.size() == 1 && back[0].stage_parts[0].dev_tag == 0 && back[0].stage_parts[0].gdn[0] == 7,
+              "the merge preserves exact stage bytes without reviving a discarded device tag");
+    }
+    {
+        ConversationCache cache(1 << 20, 2);
+        auto long_one = image({1, 2, 3, 4, 5});
+        long_one.live.gdn.resize(4096, 1);
+        check(cache.put(std::move(long_one)), "slot-pressure long conversation first");
+        check(cache.put(image({7, 8})), "slot-pressure small conversation second");
+        check(cache.put(image({9, 10})), "slot-pressure incoming conversation fits");
+        check(cache.best(std::vector<int32_t>{1, 2, 3, 4, 5, 6}, {}, true).tokens > 0,
+              "slot pressure preserves the large older conversation");
+        check(cache.best(std::vector<int32_t>{7, 8, 11}, {}, true).tokens == 0,
+              "slot pressure evicts the smaller conversation");
+    }
     std::printf("conversation_cache_test: %d checks passed\n", checks);
 }
