diff --git a/src/kernels/cuda/staged_table_copy.cuh b/src/kernels/cuda/staged_table_copy.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..9b47ff916030513fc0c8af67cecd83a593fb641d
--- /dev/null
+++ b/src/kernels/cuda/staged_table_copy.cuh
@@ -0,0 +1,25 @@
+#pragma once
+#include <cuda_runtime.h>
+#include <cstdint>
+
+namespace strata::kernels::table_copy {
+// Copy opaque table words; alignment and tails retain the scalar contract.
+__device__ __forceinline__ void u32(uint32_t* dst, const uint32_t* src, int words, int tid, int threads) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 500 && !defined(__HIPCC__)
+    const uintptr_t alignment = reinterpret_cast<uintptr_t>(dst) | reinterpret_cast<uintptr_t>(src);
+    if ((alignment & 15u) == 0 && (words & 3) == 0) {
+        auto* out = reinterpret_cast<uint4*>(dst);
+        const auto* in = reinterpret_cast<const uint4*>(src);
+        for (int i = tid; i < words / 4; i += threads) out[i] = in[i];
+        return;
+    }
+    if ((alignment & 7u) == 0 && (words & 1) == 0) {
+        auto* out = reinterpret_cast<uint2*>(dst);
+        const auto* in = reinterpret_cast<const uint2*>(src);
+        for (int i = tid; i < words / 2; i += threads) out[i] = in[i];
+        return;
+    }
+#endif
+    for (int i = tid; i < words; i += threads) dst[i] = src[i];
+}
+}
