+// STRATA_Q8_SM60_EXACT=1 (with STRATA_Q8_SM60=1): the same packed planes, the same activation staging and one warp per
+// row, but native_small_mmvq_kernel's arithmetic (native_mmvq.cu), so every output is bitwise the exact kernels'.  That
+// kernel runs a row on 4 warps x 32 threads; thread tid takes the blocks tid / 4 + 32 k at ints 2 (tid % 4) and
+// 2 (tid % 4) + 1 (sumi = dp4a(v0, u0, 0), then dp4a(v1, u1, sumi); tmp += d0 * d1 * float(sumi)), then warp 0 adds
+// warps 1, 2, 3 in that order and runs warp_sum (xor 16 .. 1).  Here lane L of the row's warp carries the four threads
+// L, L + 32, L + 64, L + 96 (blocks L / 4 + 8 w of each run of 32) as acc[.][w] and adds them in the same order before the
+// same butterfly.  Its multi-column kernels are bitwise the single-column one, so one twin covers every column count.
+template<int NCOLS>
+__launch_bounds__(THREADS)
+__global__ void kernel_exact(const int8_t* __restrict__ qs, const half* __restrict__ dpl, const Q81Block* __restrict__ x,
+                             float* __restrict__ y, int n_in, int n_out) {
+    extern __shared__ int4 q8sm60_smem[];
+    int8_t* sx = reinterpret_cast<int8_t*>(q8sm60_smem);                         // [NCOLS][n_in]
+    float* sd = reinterpret_cast<float*>(sx + std::size_t(NCOLS) * n_in);       // [NCOLS][n_in / 32]
+    const int nb = n_in / 32;
+    for (int b = int(threadIdx.x); b < NCOLS * nb; b += THREADS) {
+        const Q81Block* xb = x + b;
+        const int* src = reinterpret_cast<const int*>(xb->qs);
+        int* dst = reinterpret_cast<int*>(sx + std::size_t(b) * 32);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) dst[i] = src[i];
+        sd[b] = __low2float(xb->ds);
+    }
+    __syncthreads();
+    constexpr int RPB = THREADS / 32;
+    const int lane = int(threadIdx.x) % 32;
+    const int rloc = int(threadIdx.x) / 32;
+    const int kq = 2 * (lane % 4);                                               // the thread's first int of a block
+    const int groups = (n_out + RPB - 1) / RPB;
+    for (int g = int(blockIdx.x); g < groups; g += int(gridDim.x)) {
+        const int row = g * RPB + rloc;
+        float acc[NCOLS][4];
+#pragma unroll
+        for (int j = 0; j < NCOLS; ++j)
+#pragma unroll
+            for (int w = 0; w < 4; ++w) acc[j][w] = 0.0f;
+        if (row < n_out) {
+            const int8_t* wrow = qs + std::size_t(row) * n_in;
+            const half* d = dpl + std::size_t(row) * nb;
+            for (int base = 0; base < nb; base += 32) {                          // one pass of the exact kernel's loop
+#pragma unroll
+                for (int w = 0; w < 4; ++w) {
+                    const int kbx = base + lane / 4 + 8 * w;                     // thread lane + 32 w's block of this pass
+                    if (kbx < nb) {
+                        const int2 wv = __ldg(reinterpret_cast<const int2*>(wrow + std::size_t(kbx) * 32 + 4 * kq));
+                        const float d0 = __half2float(d[kbx]);
+#pragma unroll
+                        for (int j = 0; j < NCOLS; ++j) {
+                            const int2 xv = *reinterpret_cast<const int2*>(sx + std::size_t(j) * n_in + std::size_t(kbx) * 32 + 4 * kq);
+                            int sumi = STRATA_DP4A(wv.x, xv.x, 0);
+                            sumi = STRATA_DP4A(wv.y, xv.y, sumi);
+                            const float d1 = sd[j * nb + kbx];
+                            acc[j][w] += d0 * d1 * float(sumi);
+                        }
+                    }
+                }
+            }
+        }
+#pragma unroll
+        for (int j = 0; j < NCOLS; ++j) {                                       // every lane takes part, row or not
+            float v = acc[j][0];
+            v += acc[j][1];
+            v += acc[j][2];
+            v += acc[j][3];
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o, 32);
+            if (lane == 0 && row < n_out) y[std::size_t(j) * n_out + row] = v;
+        }
+    }
+}
+
+inline bool exact_on() {
+    static const bool v = [] {
+        const char* e = std::getenv("STRATA_Q8_SM60_EXACT");
+        const bool yes = e && e[0] == '1' && e[1] == '\0';
+        if (yes) std::fprintf(stderr, "strata q8 sm60: the bitwise twin of the exact kernels (STRATA_Q8_SM60_EXACT=1)\n");
+        return yes;
+    }();
+    return v;
+}
+
 // One workgroup per SM would leave too few rows in flight on a 48-SM die; four per SM is what the shapes of
 // Qwen3.8-Flash-Next measured best (STRATA_Q8_SM60_BPS overrides it).
 inline int blocks_per_sm() {
@@ -103,6 +184,12 @@ inline int sm_count() {
 
 template<int NCOLS, int TPR>
 void launch_one(const int8_t* qs, const half* d, const Q81Block* x, float* y, int n_in, int n_out, cudaStream_t s) {
+    if (exact_on()) {   // one warp per row whatever the width (the exact kernels' arithmetic, see kernel_exact)
+        const int groups = (n_out + THREADS / 32 - 1) / (THREADS / 32);
+        const int grid = (std::min)(groups, sm_count() * blocks_per_sm());
+        kernel_exact<NCOLS><<<unsigned(grid), THREADS, smem_bytes(NCOLS, n_in), s>>>(qs, d, x, y, n_in, n_out);
+        return;
+    }
     constexpr int RPB = THREADS / TPR;
     const int groups = (n_out + RPB - 1) / RPB;
     const int grid = (std::min)(groups, sm_count() * blocks_per_sm());
diff --git a/tools/q8_sm60_exact_check.cu b/tools/q8_sm60_exact_check.cu
new file mode 100644
--- /dev/null
+++ b/tools/q8_sm60_exact_check.cu
@@ -0,0 +1,73 @@
+// tools/q8_sm60_exact_check.cu - STRATA_Q8_SM60_EXACT=1 against the exact kernels, bit for bit, through the engine's own
+// native_mmvq: random Q8_0 weights in two device copies, one packed for the Pascal kernel (native_q8_0_sm60_pack_quiet: its
+// native_mmvq calls take q8sm60, here the bitwise twin) and one left in the GGUF layout (the exact kernels); the same q8_1
+// activations; every float of y compared as bits. The Qwen3.8-Flash-Next Q8_0 shapes and more (n_in 512 .. 10240, the
+// small-K path below 1024 included; n_out 512 .. 12288; the head 2560 -> 248320), 1 .. 8 columns. A shape the card has no
+// VRAM for is skipped and counted. Needs a GP100 (sm_60). No CMake target; build by hand against a CUDA build:
+//
+//   nvcc -O2 -std=c++17 -arch=sm_60 -Iinclude tools/q8_sm60_exact_check.cu build/libstrata_kernels.a -o q8_sm60_exact_check
+//   STRATA_Q8_SM60=1 STRATA_Q8_SM60_EXACT=1 ./q8_sm60_exact_check     # exit 0: every output bitwise equal
+//   STRATA_Q8_SM60=1 ./q8_sm60_exact_check                            # the control: the plain kernel differs
+#include "strata/kernels/native_mmvq.hpp"
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+namespace K = strata::kernels;
+#define CK(x) do { cudaError_t e_ = (x); if (e_ != cudaSuccess) { printf("CUDA %s at %d\n", cudaGetErrorString(e_), __LINE__); exit(2); } } while (0)
+static cudaStream_t g_s;
+static long run(int n_in, int n_out, int ncols, std::mt19937& rng) {
+    const int nb = n_in / 32;
+    std::vector<uint8_t> w((size_t) n_out * nb * 34);
+    std::uniform_int_distribution<int> q(-127, 127);
+    std::uniform_real_distribution<float> sc(0.0005f, 0.02f), xs(-2.f, 2.f);
+    for (size_t b = 0; b < (size_t) n_out * nb; ++b) {
+        const __half d = __float2half(sc(rng));
+        std::memcpy(&w[b * 34], &d, 2);
+        for (int i = 0; i < 32; ++i) w[b * 34 + 2 + i] = (uint8_t) (int8_t) q(rng);
+    }
+    std::vector<float> x((size_t) ncols * n_in);
+    for (auto& v : x) v = xs(rng);
+    void *wa, *wb, *xq; float *xd, *ya, *yb;
+    CK(cudaMalloc(&wa, w.size())); CK(cudaMalloc(&wb, w.size()));
+    CK(cudaMemcpy(wa, w.data(), w.size(), cudaMemcpyHostToDevice)); CK(cudaMemcpy(wb, w.data(), w.size(), cudaMemcpyHostToDevice));
+    CK(cudaMalloc(&xd, x.size() * 4)); CK(cudaMemcpy(xd, x.data(), x.size() * 4, cudaMemcpyHostToDevice));
+    CK(cudaMalloc(&xq, (size_t) ncols * nb * 36));
+    CK(cudaMalloc(&ya, (size_t) ncols * n_out * 4)); CK(cudaMalloc(&yb, (size_t) ncols * n_out * 4));
+    if (!K::native_q8_0_sm60_pack_quiet(wa, n_in, n_out, "check")) { printf("skip %d x %d (no VRAM)\n", n_out, n_in); cudaFree(wa); cudaFree(wb); cudaFree(xq); cudaFree(xd); cudaFree(ya); cudaFree(yb); return -1; }
+    K::native_quantize_q8_1(xd, xq, n_in, ncols, g_s);
+    K::native_mmvq(8, wa, xq, ya, n_in, n_out, ncols, g_s);   // packed: the twin
+    K::native_mmvq(8, wb, xq, yb, n_in, n_out, ncols, g_s);   // GGUF layout: the exact kernels
+    CK(cudaDeviceSynchronize());
+    std::vector<uint32_t> a((size_t) ncols * n_out), b(a.size());
+    CK(cudaMemcpy(a.data(), ya, a.size() * 4, cudaMemcpyDeviceToHost)); CK(cudaMemcpy(b.data(), yb, b.size() * 4, cudaMemcpyDeviceToHost));
+    long diff = 0;
+    for (size_t i = 0; i < a.size(); ++i) diff += a[i] != b[i];
+    K::native_q8_0_sm60_release(wa);
+    cudaFree(wa); cudaFree(wb); cudaFree(xq); cudaFree(xd); cudaFree(ya); cudaFree(yb);
+    return diff;
+}
+int main() {
+    CK(cudaStreamCreate(&g_s));
+    std::mt19937 rng(1234);
+    const int ins[] = {512, 640, 1024, 2048, 2560, 4096, 6144, 10240};
+    const int outs[] = {512, 2560, 12288};
+    long cases = 0, bad = 0, skipped = 0;
+    for (int n_in : ins) for (int n_out : outs) for (int c = 1; c <= 8; ++c) {
+        const long d = run(n_in, n_out, c, rng);
+        if (d < 0) { ++skipped; continue; }
+        ++cases;
+        if (d) { ++bad; printf("DIFF n_in %d n_out %d cols %d: %ld of %d floats\n", n_in, n_out, c, d, c * n_out); }
+    }
+    for (int c : {1, 4, 8}) {                                     // the output head
+        const long d = run(2560, 248320, c, rng);
+        if (d < 0) { ++skipped; continue; }
+        ++cases;
+        if (d) { ++bad; printf("DIFF head cols %d: %ld of %d floats\n", c, d, c * 248320); }
+    }
+    printf("q8_sm60_exact_check: %ld cases, %ld with any differing bit, %ld skipped (VRAM)\n", cases, bad, skipped);
+    return bad ? 1 : 0;
+}
