+        events += p.feed(NS + '</content>' + NS + '</invoke>' + NS + '</tool_call>')
+        self.assertEqual(calls(events)[0][1], {'content': payload})
+
+    def test_long_unclosed_tag_in_plain_text_is_not_an_action(self):
+        raw = NS + '<' + 'x' * 1100
