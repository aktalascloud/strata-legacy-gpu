+        self.assertEqual(text(events, 'content'), raw)
+
+    def test_nested_string_refs_and_array(self):
+        body = value('opts', value('code', '00123') + value('item', 'true')) + value('tags', value('item', '001') + value('item', 'false'))
+        for width in (None, 1):
