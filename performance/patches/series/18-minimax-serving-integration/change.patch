+                self.assertEqual(text(events, 'content'), quoted)
+
+    def test_truncation_does_not_finish_action(self):
+        raw = NS + '<tool_call>' + NS + '<invoke name="files.write">' + value('content', 'x')
+        for stream in (False, True):
