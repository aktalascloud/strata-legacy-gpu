+template <typename Restore>
+void restore_checkpoint(Restore restore, const char * error) {
+    // The older pinned library reported restore failures internally and returned void.
+    if constexpr (std::is_same_v<decltype(restore()), bool>) {
+        if (!restore()) throw std::runtime_error(error);
+    } else {
+        restore();
+    }
+}
