+std::vector<GlmImage> glm_images(Request & r, mtmd_context * projector, const llama_vocab * vocab, size_t context) {
+    if (r.media.empty()) return {};
+    if (!projector) throw std::runtime_error("CPU mmproj is unavailable");
+    std::ifstream file(std::filesystem::u8path(r.media), std::ios::binary);
+    auto bytes = [&](char * dst, size_t n) {
+        if (!file.read(dst, n)) throw std::runtime_error("Incomplete GLM image request");
+    };
+    auto u32 = [&] {
+        std::array<unsigned char, 4> b;
+        bytes(reinterpret_cast<char *>(b.data()), b.size());
+        return uint32_t(b[0]) | uint32_t(b[1]) << 8 | uint32_t(b[2]) << 16 | uint32_t(b[3]) << 24;
+    };
+    char magic[4];
+    bytes(magic, sizeof(magic));
+    if (std::string(magic, 4) != "GRB1") throw std::runtime_error("Invalid GLM image request");
+    const auto count = u32();
+    if (count < 1 || count > 8) throw std::runtime_error("Invalid GLM image count");
+    auto markers = common_tokenize(vocab, "<|begin_of_image|><|image|><|end_of_image|>", false, true);
+    if (markers.size() != 3) throw std::runtime_error("Invalid GLM image tokens");
+    std::vector<GlmImage> images;
+    size_t expanded = r.ids.size(), next = 0, pixel_bytes = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        const size_t start = u32(), width = u32(), height = u32();
+        if (start < next || start + 3 >= r.ids.size() ||
+            !std::equal(markers.begin(), markers.end(), r.ids.begin() + start) ||
+            !width || !height || width > 4096 || height > 4096 ||
+            (pixel_bytes += width * height * 3) > 48 * 1024 * 1024)
+            throw std::runtime_error("GLM image does not match prompt or image limits");
+        std::vector<unsigned char> rgb(width * height * 3);
+        bytes(reinterpret_cast<char *>(rgb.data()), rgb.size());
+        mtmd::bitmap image(width, height, rgb.data());
+        mtmd::input_chunks_ptr chunks(mtmd_input_chunks_init());
+        const mtmd_bitmap * bitmap = image.ptr.get();
+        const std::string marker = mtmd_default_marker();
+        const mtmd_input_text input{marker.data(), marker.size(), false, true};
+        if (mtmd_tokenize(projector, chunks.get(), &input, &bitmap, 1) != 0)
+            throw std::runtime_error("GLM image preprocessing failed");
+        expanded = expanded - 3 + mtmd_helper_get_n_tokens(chunks.get());
+        if (expanded + r.limit > context) throw std::runtime_error("GLM image prompt exceeds context");
+        images.push_back({start, std::move(chunks)});
+        next = start + 3;
+    }
+    if (file.peek() != EOF) throw std::runtime_error("Unexpected data after GLM images");
+    return images;
+}
+int mtp_image_batch(const mtmd_helper_embd_batch * image, void * user) {
+    auto & state = *static_cast<std::pair<llama_context *, common_speculative *> *>(user);
+    if (!state.second) return 0;
+    if (image->n_pos < 1 || image->n_pos > 4) return 1;
+    common_batch batch(state.first);
+    for (int i = 0; i < image->n_tokens; ++i) {
+        llama_pos positions[4]{};
+        for (int j = 0; j < image->n_pos; ++j) positions[j] = image->pos[j * image->n_tokens + i];
+        batch.add_embd({image->embd + size_t(i) * image->n_embd, 1, size_t(image->n_embd)},
+                       positions, image->seq_id, false);
+    }
+    return common_speculative_process(state.second, batch) ? 0 : 1;
+}
+#endif
+bool needs_checkpoint(llama_context * ctx, std::optional<bool> & saved) {
+    if (saved) return *saved;
+    const auto support = common_context_can_seq_rm(ctx);
+    const bool full = support == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
+    // A failed probe may be transient. Cache only a successfully identified memory mode.
+    if (support != COMMON_CONTEXT_SEQ_RM_TYPE_NO) saved = full;
+    return full;
+}
