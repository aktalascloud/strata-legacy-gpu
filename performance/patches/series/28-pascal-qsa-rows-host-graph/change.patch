+#if defined(STRATA_EXPERIMENTAL_SM60) && !defined(STRATA_USE_HIP) && !defined(STRATA_GPU_METAL)
+    static const int64_t minimum = [] {
+        const char* raw = std::getenv("STRATA_QSA_ROWS_AT");
+        const char* forced = std::getenv("STRATA_QSA_ROWS");
+        const char* multi = std::getenv("STRATA_SCORES_MULTI");
