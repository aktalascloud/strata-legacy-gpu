new file mode 100644
index 0000000000000000000000000000000000000000..2fbcddcd062f4ec8118e7725c7e94ff3791b46b5
--- /dev/null
+++ b/backends/minimax/CMakeLists.txt
@@ -0,0 +1,64 @@
+# Isolated Maya CPU ABI: never link this target to Strata's strata_kernels_cpu.
+if(NOT STRATA_ENABLE_CUDA OR NOT TARGET ggml-cpu OR NOT TARGET ggml-base)
+  message(FATAL_ERROR "MiniMax requires CUDA and the existing native GGML CPU/base targets")
+endif()
+if(NOT STRATA_ISA_FLOOR STREQUAL "avx")
+  message(FATAL_ERROR "This MiniMax port requires STRATA_ISA_FLOOR=avx (AVX1 baseline)")
+endif()
+if(MSVC AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
+  message(FATAL_ERROR "Windows MiniMax AVX1 port requires clang-cl, as in the reviewed build profile")
+endif()
+set(_maya "${CMAKE_CURRENT_SOURCE_DIR}/vendor/project-maya")
+set(_cpu_names pool expert_layout exl3_ref expert q2_avx2 exl3_cpu native_expert
+               iq_avx512 iq_avx2 kq_avx512 iq_avx512_one)
+set(_cpu_sources)
+foreach(_name IN LISTS _cpu_names)
+  list(APPEND _cpu_sources "${_maya}/src/kernels/cpu/${_name}.cpp")
+endforeach()
+add_library(strata_minimax_cpu STATIC ${_cpu_sources})
+target_include_directories(strata_minimax_cpu PUBLIC "${_maya}/include" PRIVATE "${_maya}/third_party/ggml")
+target_compile_definitions(strata_minimax_cpu PUBLIC STRATA_NATIVE_EXPERTS=1)
+target_link_libraries(strata_minimax_cpu PUBLIC ggml-cpu ggml-base Threads::Threads)
+
+set(_mm3_cpp host main cpu cpu_gg)
+set(_mm3_cu kernels exl3 gguf gv dspark model tp vision)
+set(_engine_sources)
+foreach(_name IN LISTS _mm3_cpp)
+  list(APPEND _engine_sources "${_maya}/src/mm3/mm3_${_name}.cpp")
+endforeach()
+foreach(_name IN LISTS _mm3_cu)
+  list(APPEND _engine_sources "${_maya}/src/mm3/mm3_${_name}.cu")
+endforeach()
+list(APPEND _engine_sources "${_maya}/src/ds4/ds4_iq.cu" "${_maya}/src/ds4/ds4_lt.cu"
+                           "${_maya}/src/ds4/ds4_iq_cpu.cpp" "${_maya}/src/ds4/ds4_gguf_cpu.cpp")
+add_executable(strata-minimax ${_engine_sources})
+target_include_directories(strata-minimax PRIVATE "${_maya}/include" "${_maya}/src/mm3" "${_maya}/third_party/ggml")
+target_compile_definitions(strata-minimax PRIVATE MAYA_DS4_IQ_ONLY)
+target_link_libraries(strata-minimax PRIVATE strata_minimax_cpu CUDA::cudart CUDA::cublas)
+set_target_properties(strata-minimax PROPERTIES CUDA_ARCHITECTURES 61 CUDA_RUNTIME_LIBRARY Shared
+                                              CXX_STANDARD 20 CUDA_STANDARD 20)
+strata_utf8_manifest(strata-minimax)
+
+if(MSVC)
+  set(_baseline /arch:AVX /fp:precise /clang:-march=ivybridge /clang:-mtune=ivybridge
+      /clang:-mno-avx2 /clang:-mno-fma /clang:-mno-f16c /clang:-ffp-contract=off /clang:-fno-fast-math)
+  set(_wide /clang:-mavx2 /clang:-mfma /clang:-mf16c /clang:-fno-vectorize /clang:-fno-slp-vectorize)
+  set(_wide512 ${_wide} /clang:-mavx512f /clang:-mavx512bw /clang:-mavx512vl /clang:-mavx512dq
+      /clang:-mavx512vnni /clang:-mavx512vbmi /clang:-mbmi2)
+  target_compile_options(strata-minimax PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=/O2,/Ob3,/favor:INTEL64,/fp:precise,/arch:AVX>)
+else()
+  set(_baseline -march=ivybridge -mtune=ivybridge -mno-avx2 -mno-fma -mno-f16c -ffp-contract=off -fno-fast-math)
+  set(_wide -mavx2 -mfma -mf16c -fno-tree-vectorize -fno-tree-slp-vectorize)
+  set(_wide512 ${_wide} -mavx512f -mavx512bw -mavx512vl -mavx512dq -mavx512vnni -mavx512vbmi -mbmi2)
+endif()
+foreach(_target strata_minimax_cpu strata-minimax)
+  target_compile_options(${_target} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:${_baseline}>)
+endforeach()
+# These existing wider files dispatch only after their own CPU feature checks.
+foreach(_name expert iq_avx512 kq_avx512 iq_avx512_one)
+  set_source_files_properties("${_maya}/src/kernels/cpu/${_name}.cpp" PROPERTIES COMPILE_OPTIONS "${_wide512}")
+endforeach()
+foreach(_name q2_avx2 iq_avx2)
+  set_source_files_properties("${_maya}/src/kernels/cpu/${_name}.cpp" PROPERTIES COMPILE_OPTIONS "${_wide}")
+endforeach()
+target_compile_options(strata-minimax PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-O3;-Xptxas=-dlcm=ca>)
diff --git a/backends/minimax/README.md b/backends/minimax/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..ae8baf92767f3f78d9b4d15f608ee506546e9c46
--- /dev/null
+++ b/backends/minimax/README.md
@@ -0,0 +1,31 @@
+# MiniMax M3.1-Flash / DSpark backend
+
+This opt-in backend vendors the source closure of Project Maya at the commit and
+file hashes in `UPSTREAM.json`, with the reviewed AVX1/Pascal adaptations. The
+original MIT license, GGML license and MiniMax model license are retained in the
+vendor directory. Model weights are separate and are not included.
+
+Enable `STRATA_ENABLE_MINIMAX=ON` in an existing CUDA/native-experts build with
+`STRATA_ISA_FLOOR=avx`. Build only `strata-minimax`, using the project's reviewed
+build profile and at most 12 concurrent jobs. The CUDA target is sm_61; CPU entry
+points use Ivy Bridge without baseline AVX2/FMA/F16C. Existing wider CPU kernels
+remain behind their feature checks. Windows builds require clang-cl for the CPU
+translation units and the configured CUDA host compiler for CUDA units.
+
+The separate `strata_minimax_cpu` library is required: Maya's native expert ABI
+and buffers differ from Strata's Qwen engine. Do not substitute
+`strata_kernels_cpu`. Only the unchanged GGML CPU/base dependency is shared.
+
+Create GGUF packs with `tools/minimax/pack_gguf.py`. The serving backend kind is
+`mm3`, architecture `minimax-m3`, with an explicit DSpark policy. It checks the
+loaded READY facts before accepting a required draft. Native KV formats are
+`bf16`, `int8`, `fp8`, and `fp4`; `q4_0` is not an alias for `fp4`. Native
+`--cpu-threads` includes the caller, so 15 threads represent 14 workers.
+
+The complete adapted source has previously compiled and linked as a separate
+prototype. The new build target configures successfully, with generated commands
+checked for all 27 translation units. Building from those commands and actual
+model, numerical, DSpark and throughput qualification remain pending.
+This module does not select a model, rewrite user settings or replace the
+running engine. Use the existing graceful owner control and startup for any
+qualified deployment.
