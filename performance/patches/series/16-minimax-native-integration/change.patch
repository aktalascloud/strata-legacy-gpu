+// src/mm3/mm3_exl3.hpp - EXL3 (exllamav3) quantized weights on the device for maya-mm3 (MiniMax-M3.1-Flash): the
+// decode GEMV, the routed experts, and the full reconstruction for the prompt path.
+//
+// maya-mm3's own copy of include/strata/kernels/exl3.hpp (the GLM and DeepSeek engines keep theirs): the same format
+// and interface in namespace strata::mm3::exl3, with the routed experts' activation MiniMax's swigluoai -
+// g = min(g, limit), u = clamp(u, -limit, limit), h = g * sigmoid(kSwigluAlpha g) * (u + 1) - instead of the clamped
+// swiglu.  Before sm_80: Volta / Turing's tensor cores (nvcuda::wmma) for every tile, and the prompt path's busy
+// matrices through cuBLAS' FP16 GEMMs over their decoded weights (blas_enable).
+//
+// The format (exllamav3, MIT, turboderp).  A weight with k inputs and n outputs (y = x W) is stored as
+//   trellis  int16 [k/16][n/16][16 K]: each 16x16 tile is a tail-biting trellis of 256 K-bit steps read MSB-first
+//            from its 8 K uint32 words (little-endian pairs of the int16s).  Step p's state is the 16-bit window that
+//            ends at bit S(p) = (p + 1) K, modulo the tile's 256 K bits.  exllamav3 1.6 also writes the half-integer
+//            K = KA + 0.5 (1.5 / 2.5 / 3.5: 24 / 40 / 56 int16 a tile, mul1 only): its steps alternate KA bits (even p)
+//            and KA + 1 (odd p), so S(p) = floor((p + 1) k2 / 2) with k2 = 2 K - which is (p + 1) K for an integer K
+//            too.  The engine carries every bitrate as k2 (2..16 even, or 3 / 5 / 7).  The codebook turns the state
+//            into a value:
+//              mul1 (cb 2):  fp16(1024 + bytesum(state * 0x83DCD12D)) * fp16(0x1eee) + fp16(0xc931), one FP16 FMA
+//              mcg (cb 1):   x = state * 0xCBAC1FED, 3inst (cb 0): x = state * 89226354 + 64248484; then
+//                            x = (x & 0x8fff8fff) ^ 0x3b603b60 and the value is the FP16 sum of x's two halves.
+//            Step p sits at tile row (p/8 % 4) * 2 + (p & 1) + 8 (p/2 & 1), column p/32 + 8 (p/4 & 1) (the tensor-
+//            core fragment order).
+//   suh, svh FP16 [k], [n]: the input and output channel scales (signs and magnitudes).
+// With H the 128-point Sylvester Hadamard over sqrt(128), applied to each 128 consecutive values:
+//   y = H(H(x * suh) W') * svh,   W' the decoded k x n matrix.
+//
+// Activations enter as F32 or as the engine's q8_1 blocks; the kernels rotate them on the fly (each block rotates
+// the slice it reads), so callers keep their existing buffers.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cuda_runtime.h>
+
+namespace strata::mm3::exl3 {
+
+/// The weight type the engine's MvJob / WSlot carry for EXL3: their weight pointer is a (host) const Mat*.
+constexpr int kTypeEXL3 = 200;
+
+/// MiniMax-M3.1-Flash's swiglu_alpha (its config's; the engine refuses another).
+constexpr float kSwigluAlpha = 1.702f;
+
+/// One EXL3 matrix, or a column range of one (a view: trellis/svh advanced to its first column, ld the row stride).
+struct Mat {
+    const uint32_t* trellis = nullptr;   // device; 4-byte aligned
+    const uint16_t* suh = nullptr;       // device FP16 bits [k]
+    const uint16_t* svh = nullptr;       // device FP16 bits [n]
+    int k = 0, n = 0;
+    int k2 = 0;                          // twice the bits per weight: 2..16 even (K 1..8), 3 / 5 / 7 (K 1.5 / 2.5 / 3.5)
+    int cb = 2;                          // codebook: 0 3inst, 1 mcg, 2 mul1 (the only one with a half-integer K)
+    int ld = 0;                          // tiles per 16-row slice in memory (the full matrix's n / 16); 0: n / 16
+    // a GGUF's matrix instead (fmt 4, mm3_gguf.cuh's kFmtGG): raw = [n][blocks] of gg_type (row r = output r, ld bytes
+    // a row; 0: whole rows), the EXL3 fields unused - the entry points below hand it to mm3_gguf.cu
+    int fmt = 0;
+    const void* raw = nullptr;
+    int gg_type = 0;   // fmt 4: the ggml block type
+};
+
+/// Trellis bytes of a k x n matrix at k2 / 2 bits: 16 k2 bytes a 16x16 tile.
+inline size_t trellis_bytes_k2(int64_t k, int64_t n, int k2) {
+    return (size_t) (k / 16) * (size_t) (n / 16) * 16u * (size_t) k2;
+}
+/// The columns [c0, c0 + nc) of m (c0 and nc multiples of 128: the output rotation's blocks stay whole).
+Mat view(const Mat& m, int c0, int nc);
+/// Whether the kernels take this bitrate and codebook: K 1..8 (k2 2..16 even) with any codebook, K 1.5 / 2.5 / 3.5
+/// (k2 3 / 5 / 7) with mul1.
+bool k2_supported(int k2, int cb);
+/// Whether the kernels take this matrix (k, n multiples of 128, k2_supported).
+bool supported(const Mat& m);
+
+/// y[r] = alpha * (x W)[r] + (bias ? bias[r] : 0).  x: xf (F32) when given, else xq (q8_1 blocks of k values).
+/// ncol > 1: as many activations (a verify window's tokens), activation c at xf + c xf_cs / xq + c xq_cs bytes, its
+/// y at y + c y_cs - the weights read and decoded once for up to 8 of them, and each y bit for bit its own job's.
+struct MvJob {
+    const Mat* m = nullptr;
+    const float* xf = nullptr;
+    const void* xq = nullptr;
+    float* y = nullptr;
+    const float* bias = nullptr;
+    float alpha = 1.0f;
+    int ncol = 1;
+    size_t xf_cs = 0, xq_cs = 0, y_cs = 0;
+};
+constexpr int kMaxMvJobs = 8;
+constexpr int kMaxMvCols = 16;   // a job's activations at most
+bool mv(const MvJob* jobs, int n, cudaStream_t s);
+/// The calling thread's launches of mv(), moe_gate_up() and moe_down() read `flag` (a device int) first and do no work
+/// while it is non-zero (glmf::set_skip's, which sets it: a pipelined window's tokens past a wrong draft); nullptr (the
+/// default): no check.  The flag changes only between launches (skip_gate, on the same stream).  (v1.1.8's kernels
+/// before sm_80 do not read it.)
+void set_skip(const int* flag);
+/// How many pieces mv cuts m's inputs into on the current device (0: not covered) - one piece, and every column's
+/// sum is the same whatever columns the job holds (a view's, or the whole matrix's).
+int mv_splits(const Mat& m);
+/// How many activations a lone job of m can take with its weights read once on the current device (the input split's
+/// partials of them in the scratch; 0: not covered) - a caller with more cuts them in runs of this many.
+int mv_cols(const Mat& m);
+
+/// Allocates the per-stream scratch of mv / moe / win_experts on the current device (call once per stream before a
+/// graph capture; the first use does it otherwise).
+bool prepare(cudaStream_t s);
+
+/// One routed expert's blob: three parts (gate, up, down) at byte offsets from the blob base, each holding the FP16
+/// suh, the FP16 svh and the trellis of that matrix.
+struct ExpertLayout {
+    size_t suh[3] = {0, 0, 0}, svh[3] = {0, 0, 0}, trellis[3] = {0, 0, 0};
+    int k2[3] = {0, 0, 0};   // each part's bitrate as twice its K (Mat::k2); gate and up alike
+    int cb = 2;
+    int fmt = 0;   // 4: a GGUF's expert (mm3_gguf.cuh's kFmtGG): trellis[r] = matrix r's offset, [out][blocks]
+    int gg_type[3] = {0, 0, 0};   // fmt 4: each role's ggml type (gate, up and down may differ)
+};
+/// The routed experts of one token (the engine's device plan: plan_ptr[i] = the blob in VRAM, 0 = not on the device;
+/// plan_w[i] its weight).  gate/up over x (n_embd F32) -> swigluoai -> h (F32 [k][n_ff], scratch the caller
+/// owns), then down over h, the weighted sum in plan order, + cpu_part when *cpu_flag, + sh_out when given -> out.
+/// A mixed-precision quant's layer (the experts of one layer at different K, gate / up / down of one expert
+/// too): its experts in classes, class c's blobs in VRAM within [lo[c], hi[c]) with the layout lay[c].  n == 0: one
+/// layout for the layer (the args' lay), as before.  The kernels pick each expert's class by its blob's address; a
+/// class's K: 1-4 (K2 2, 4, 6, 8), mul1 (cb 2).
+constexpr int kMaxClasses = 32;
+struct MixedLayouts {
+    int n = 0;
+    unsigned long long lo[kMaxClasses] = {}, hi[kMaxClasses] = {};
+    ExpertLayout lay[kMaxClasses];
+};
+bool mixed_supported(const ExpertLayout& lay);   // a class layout the mixed kernels take
+
+struct MoeArgs {
+    const unsigned long long* plan_ptr = nullptr;
+    const float* plan_w = nullptr;
+    const float* cpu_part = nullptr;
+    const int* cpu_flag = nullptr;
+    ExpertLayout lay;
+    MixedLayouts mix;     // (n > 0: the experts' layouts by class - lay is not used)
+    int k = 8, n_embd = 4096, n_ff = 2048;
+    float limit = 0.0f;   // 0: no clamp
+};
+void moe_gate_up(const MoeArgs& a, const float* x, float* h, cudaStream_t s);
+void moe_down(const MoeArgs& a, const float* h, const float* sh_out, float* out, cudaStream_t s);
+
+/// A verify window's routed experts, each distinct expert read once for all the tokens it serves (after exllamav3's
+/// fused MoE, which runs the slots that picked one expert as the rows of one tile): T tokens' plans [T][8] grouped by
+/// expert (glmf::moe_win_group: group g's blob at grp_ptr[g], its entries e = t * 8 + i at grp_ent[grp_start[g] ..
+/// grp_start[g + 1])), token t's F32 input at x + t x_stride, its output at out + t out_stride (plus the CPU lane's
+/// part when cpu_flag[t], plus sh_out's row t) - every token's output is moe_gate_up + moe_down's for it alone, bit for
+/// bit.  h [T * 8][n_ff] and part [T * 8][n_embd] are the caller's scratch.
+struct WinArgs {
+    const unsigned long long* grp_ptr = nullptr;
+    const int *grp_start = nullptr, *grp_ent = nullptr, *n_groups = nullptr;
+    const unsigned long long* plan_ptr = nullptr;   // [T][8]
+    const float* plan_w = nullptr;                  // [T][8]
+    const float* cpu_part = nullptr;                // [T][n_embd] (rows cpu_stride apart when given)
+    size_t cpu_stride = 0;
+    const int* cpu_flag = nullptr;                  // [T]
+    const float* x = nullptr;
+    size_t x_stride = 0;
+    float* h = nullptr;
+    float* part = nullptr;
+    const float* sh_out = nullptr;                  // [T][n_embd] or null
+    float* out = nullptr;
+    size_t out_stride = 0;
+    ExpertLayout lay;
+    MixedLayouts mix;     // (n > 0: the experts' layouts by class - lay is not used)
+    int T = 0, k = 8, n_embd = 4096, n_ff = 2048;
+    float limit = 0.0f;
+    // (given) the combine first waits on the device until *wait_ptr == wait_val (the host's answer to the CPU lane's
+    // part arrives while the device computes the experts); cpu_flag may be null (no CPU part)
+    const unsigned* wait_ptr = nullptr;
+    unsigned wait_val = 0;
+};
+bool win_experts(const WinArgs& a, cudaStream_t s);
+/// Whether the current device runs the several-activation kernels (win_experts; mv's ncol > 1): every device does
+/// (they take ~10 KB of shared memory a block).
+bool several_ok();
+
+/// The prompt path's tensor-core GEMMs (sm_80 and later; mma_supported() says whether this device runs them).
+bool mma_supported();
+/// A set of n_exp routed experts in VRAM, expert e's blob at wbase + e * stride (the layout in lay), owning the sorted
+/// rows [bounds[e], bounds[e + 1]) (device, n_exp + 1 entries); a sorted row's LOCAL row is bounds[e] - row0 + r.
+struct SetArgs {
+    const uint8_t* wbase = nullptr;
+    size_t stride = 0;
+    ExpertLayout lay;
+    MixedLayouts mix;     // (n > 0: expert e's blob at eptr[e] (device), its layout by class - wbase, stride, lay unused)
+    const unsigned long long* eptr = nullptr;
+    int n_exp = 0;
+    const int* bounds = nullptr;
+    int row0 = 0;
+    int max_rows = 0;   // the most rows one expert of the set has
+    int n_embd = 4096, n_ff = 2048;
+    float limit = 0.0f;
+    int skip_ge = 0;    // (ds4's low-bit GGUF experts) > 0: experts of at least this many rows are the caller's (FP16 GEMMs)
+    // (given: a host copy of bounds) before sm_80 the busy experts - blas_enable's rows or more - go through the FP16
+    // GEMM (each decoded once, the product on the tensor cores), the rest through the tiles
+    const int* hbounds = nullptr;
+    // (a GGUF's experts, lay.fmt mm3_gguf.cuh's kFmtGG) x16: set_gate_up's x rows as FP16 too (ldx apart; the tiles
+    // load them 8 at a time - the same bits as from x), graw: [local rows][n_ff] F32 scratch for a layer whose gate and
+    // up differ in type (the gate's sums between its two passes)
+    const uint16_t* x16 = nullptr;
+    float* graw = nullptr;
+};
+/// h[local row] = FP16 swigluoai of gate and up over x[row_idx[local row]] (F32 rows, ldx floats apart).
+void set_gate_up(const SetArgs& a, const float* x, int ldx, const int* row_idx, uint16_t* h16, int ldh, cudaStream_t s);
+/// y[local row] = down(h[local row]) (F32 rows, ldy floats apart).
+void set_down(const SetArgs& a, const uint16_t* h16, int ldh, float* y, int ldy, cudaStream_t s);
+/// Y[r] = beta Y[r] + (X[r] W) for r < rows: one matrix over FP16 rows (ldx), F32 output rows (ldy).
+/// (before sm_80, with blas_enable on the stream: rows >= MM3_EXL3_BLAS_ROWS (64) through the FP16 GEMM; Volta /
+/// Turing's tiles on the tensor cores below that, the portable kernels elsewhere)
+void gemm_rows(const Mat& m, const uint16_t* x16, int ldx, int rows, float* y, int ldy, float beta, cudaStream_t s);
+
+/// GPUs before sm_80 (V100, T4, RTX 20): the prompt path's FP16 GEMMs through cuBLAS for stream s on the current
+/// device - a handle of its own (the tensor cores' math) and scratch_mb of VRAM (8 at least; a MiniMax-M3.1 expert needs 96); blas_bytes: what it
+/// took (0: not enabled), blas_wanted: whether the current device uses it (before sm_80, MM3_EXL3_BLAS_ROWS != 0).
+bool blas_enable(cudaStream_t s, size_t scratch_mb);
+size_t blas_bytes(cudaStream_t s);
+bool blas_wanted();
+
+/// The full weight in the engine's row layout: dst[r][c] = W[c][r] (n rows of k values), BF16 or F16 bits.
+void reconstruct_rows(const Mat& m, uint16_t* dst, bool bf16, cudaStream_t s);
+/// The decoded W' alone in that layout: dst[c][r] = W'[r][c], F16 bits (exactly the decoded values) - for a product
+/// that rotates its activations and outputs instead of the weight (x W = H(H(x * suh) W') * svh): rows_rot_f16 before
+/// the GEMM, rows_rot_out after it.  No Hadamard over the k x n weight: a plain decode, at the memory's speed.
+void reconstruct_inner_rows(const Mat& m, uint16_t* dst, cudaStream_t s);
+/// out[r][c] = FP16(H(x_r * suh)[c]) for r < nrows, c < ncols (ncols % 128 == 0), x_r = x[idx ? idx[r] : r] (F32, ldx
+/// floats a row): an EXL3 matrix's rotated input rows, as the decode kernels rotate theirs.
+void rows_rot_f16(const float* x, int ldx, const int* idx, int nrows, int ncols, const uint16_t* suh, uint16_t* out,
+                  cudaStream_t s);
+/// y[r][c] = H(y_r)[c] * svh[c] in place for r < nrows, c < ncols (each 128 values one block; ldy floats a row).
+void rows_rot_out(float* y, int ldy, int nrows, int ncols, const uint16_t* svh, cudaStream_t s);
+/// The decoded W' alone, row-major [k][n] F16 bits (tests).
+void reconstruct_inner(const Mat& m, uint16_t* dst, cudaStream_t s);
+
+/// out[r][c] = FP16(x[idx ? idx[r] : r][c]) for r < nrows, c < ncols (x: ldx floats a row): the prompt path's rows of
+/// one expert, gathered for its GEMMs.
+void rows_f16(const float* x, int ldx, const int* idx, int nrows, int ncols, uint16_t* out, cudaStream_t s);
+
+/// Launch failures of this family since the process started (each is also printed).
+int launch_errors();
+/// The current device's win_experts waits on the host's word that gave up after 120 s (the host never answered).
+unsigned wait_timeouts();
+
+}  // namespace strata::mm3::exl3
diff --git a/backends/minimax/vendor/project-maya/src/mm3/mm3_geo.hpp b/backends/minimax/vendor/project-maya/src/mm3/mm3_geo.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c316ecde1216ec5af03bd65d5605cbe045dcb8dd
--- /dev/null
+++ b/backends/minimax/vendor/project-maya/src/mm3/mm3_geo.hpp
@@ -0,0 +1,73 @@
+// src/mm3/mm3_geo.hpp - maya-mm3: MiniMax-M3.1-Flash's geometry from mm3.txt (both engine paths' - mm3_model.cu,
+// mm3_tp.cu), with the checks of what the kernels cover.
+#pragma once
+
+#include <cmath>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "mm3_exl3.hpp"
+#include "mm3_env.hpp"
+#include "mm3_pack.hpp"
+
+namespace mm3 {
+
+struct Geo {
+    int dim, n_layers, n_head, n_kv, hd, n_rot, vocab, n_exp, k_exp, ff, ff_dense, ff_shared;
+    float theta, eps, alpha, limit, scale;
+    std::vector<int> moe, sparse;
+    int ix_heads, ix_dim, blk, topk, local;
+    int bos, eos;
+    int topk_override = 0;   // (experiments: MM3_TOPK keeps that many blocks instead of the model's)
+
+    bool read(const Pack& p, std::string& err) {
+        dim = (int) p.num("hidden_size");
+        topk_override = ::mm3::env("MM3_TOPK") ? std::atoi(::mm3::env("MM3_TOPK")) : 0;
+        n_layers = (int) p.num("num_hidden_layers");
+        n_head = (int) p.num("num_attention_heads");
+        n_kv = (int) p.num("num_key_value_heads");
+        hd = (int) p.num("head_dim");
+        n_rot = (int) p.num("rotary_dim", hd * p.num("partial_rotary_factor", 1.0));
+        vocab = (int) p.num("vocab_size");
+        n_exp = (int) p.num("num_local_experts");
+        k_exp = (int) p.num("num_experts_per_tok");
+        ff = (int) p.num("intermediate_size");
+        ff_dense = (int) p.num("dense_intermediate_size");
+        ff_shared = (int) p.num("shared_intermediate_size");
+        theta = (float) p.num("rope_theta");
+        eps = (float) p.num("rms_norm_eps");
+        alpha = (float) p.num("swiglu_alpha");
+        limit = (float) p.num("swiglu_limit");
+        scale = (float) p.num("routed_scaling_factor");
+        moe = p.ints("moe_layer_freq");
+        sparse = p.ints("sparse_attention_config.sparse_attention_freq");
+        ix_heads = (int) p.num("sparse_attention_config.sparse_num_index_heads");
+        ix_dim = (int) p.num("sparse_attention_config.sparse_index_dim");
+        blk = (int) p.num("sparse_attention_config.sparse_block_size");
+        topk = (int) p.num("sparse_attention_config.sparse_topk_blocks");
+        local = (int) p.num("sparse_attention_config.sparse_local_block");
+        bos = (int) p.num("bos_token_id");
+        eos = (int) p.num("eos_token_id");
+        const auto no = [&](const std::string& what) {
+            err = "geometry not covered: " + what;
+            return false;
+        };
+        if (hd != 128 || n_rot % 2 || n_rot > hd) return no("head_dim " + std::to_string(hd));
+        if (n_head != 16 * n_kv) return no("query heads per KV head " + std::to_string(n_head / std::max(1, n_kv)));
+        if (ix_heads != n_kv || ix_dim != 128 || ix_heads != 4) return no("indexer heads / dim");
+        if (topk_override > 0) topk = topk_override;
+        if (blk != 128 || local != 1 || topk < 1 || topk > 64) return no("sparse blocks (block 128, local 1)");
+        if (p.num("sparse_attention_config.sparse_init_block", 0) != 0) return no("init blocks");
+        if ((int) moe.size() != n_layers || (int) sparse.size() != n_layers) return no("per-layer lists");
+        for (int s : sparse)
+            if (!s) return no("a full-attention layer (every layer of M3.1 is sparse)");
+        if (std::fabs(alpha - strata::mm3::exl3::kSwigluAlpha) > 1e-6f) return no("swiglu_alpha " + std::to_string(alpha));
+        if (k_exp > 8 || n_exp > 256) return no("experts");
+        if (dim % 128 || ff % 128 || ff_dense % 128 || ff_shared % 128) return no("matrix sides");
+        return true;
+    }
+};
+
+
+}  // namespace mm3
diff --git a/backends/minimax/vendor/project-maya/src/mm3/mm3_gguf.cu b/backends/minimax/vendor/project-maya/src/mm3/mm3_gguf.cu
new file mode 100644
index 0000000000000000000000000000000000000000..64949e4f7b966223e95681b532d5e53ca1d0a685
--- /dev/null
+++ b/backends/minimax/vendor/project-maya/src/mm3/mm3_gguf.cu
@@ -0,0 +1,576 @@
+// src/mm3/mm3_gguf.cu - maya-mm3's GGUF weights on the device (mm3_gguf.cuh): the activations' rounding, the dense
+// GEMVs and GEMMs, the routed experts' passes and their combine around maya-ds4's kernels (src/ds4/ds4_iq.cu).
+#include "mm3_gguf.cuh"
+
+#include "mm3_env.hpp"
+#include "mm3_gv.cuh"
+#include "../ds4/ds4_iq.cuh"
+#include "../ds4/ds4_lt.hpp"
+
+#include <cublas_v2.h>
+#include <cuda_fp16.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+namespace mm3::gg {
+
+namespace iq = strata::ds4::gguf::iq;
+
+namespace {
+
+std::atomic<int> g_errors{0};
+std::atomic<int> g_gemm{0};   // set_gemm's backend: 0 the BLAS, 1 hipBLASLt (measured kernels) where it runs
+
+void check(const char* what) {
+    const cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "mm3 gguf %s: %s\n", what, cudaGetErrorString(e));
+        g_errors.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+void fail(const char* what) {
+    std::fprintf(stderr, "mm3 gguf %s\n", what);
+    g_errors.fetch_add(1, std::memory_order_relaxed);
+}
+
+constexpr int kWarps = 8, kThreads = kWarps * 32;
+constexpr int kMaxEnt = 16;          // a window's tokens at most (mm3_model.cu's kWin)
+constexpr int kMaxEmbd = 8192;       // n_embd and n_ff at most (MiniMax-M3.1: 6144, 3072)
+constexpr int kMaxQK = 16384;        // a GEMV's inputs at most (the dense MLP's down: 12288)
+constexpr size_t kBand = 64u << 20;  // a GEMM's FP16 weight band (bytes): the rows decoded at a time
+
+// ---- int8 activations
+// per 32 values (llama.cpp's q8_1 scale, ds4_gguf.cu's q8_quant - the same operations): rows of k F32 values (row r
+// at x + r ldx) -> q[r][k], d[r][k / 32] = max|x| / 127 (a warp a 32-block)
+__global__ void __launch_bounds__(kThreads) q8_kernel(const float* __restrict__ x, size_t ldx, int k,
+                                                      int8_t* __restrict__ q, float* __restrict__ d) {
+    const int r = blockIdx.y, b = blockIdx.x * kWarps + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (b * 32 >= k) return;
+    const float v = x[(size_t) r * ldx + (size_t) b * 32 + lane];
+    float am = fabsf(v);
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) am = fmaxf(am, __shfl_xor_sync(0xffffffffu, am, o));
+    const float sc = am / 127.0f;
+    q[(size_t) r * k + (size_t) b * 32 + lane] = (int8_t) (am > 0.0f ? __float2int_rn(v / sc) : 0);
+    if (lane == 0) d[(size_t) r * (k / 32) + b] = sc;
+}
+// ggml's Q8_K, the CPU lane's (quantize_row_q8_K_ref; ds4_gguf.cu's q8k_quant - the same operations): per 256 values
+// max = the signed value of the largest magnitude (the first one), iscale = -127 / max, q = min(127, nearest(iscale x)),
+// d = 1 / iscale into each of the 256's eight 32-blocks
+__device__ __forceinline__ int q8k_nearest(float fval) {
+    const float val = __fadd_rn(fval, 12582912.0f);
+    int i;
+    memcpy(&i, &val, 4);
+    return (i & 0x007fffff) - 0x00400000;
+}
+__global__ void __launch_bounds__(256) q8k_kernel(const float* __restrict__ x, size_t ldx, int k, int8_t* __restrict__ q,
+                                                  float* __restrict__ d) {
+    __shared__ float s_am[8];
+    __shared__ int s_at[8];
+    const int r = blockIdx.y, j = (int) threadIdx.x, lane = j & 31, w = j >> 5;
+    const size_t at = (size_t) blockIdx.x * 256 + (size_t) j;
+    const float v = x[(size_t) r * ldx + at];
+    float am = fabsf(v);
+    int ix = j;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        const float oa = __shfl_xor_sync(0xffffffffu, am, o);
+        const int oi = __shfl_xor_sync(0xffffffffu, ix, o);
+        if (oa > am || (oa == am && oi < ix)) am = oa, ix = oi;
+    }
+    if (lane == 0) s_am[w] = am, s_at[w] = ix;
+    __syncthreads();
+    if (j == 0) {
+        for (int i = 1; i < 8; ++i)
+            if (s_am[i] > s_am[0] || (s_am[i] == s_am[0] && s_at[i] < s_at[0])) s_am[0] = s_am[i], s_at[0] = s_at[i];
+    }
+    __syncthreads();
+    const float amax = s_am[0];
+    int8_t qv = 0;
+    float dv = 0.0f;
+    if (amax > 0.0f) {
+        const float mx = x[(size_t) r * ldx + (size_t) blockIdx.x * 256 + (size_t) s_at[0]];
+        const float iscale = __fdiv_rn(-127.0f, mx);
+        qv = (int8_t) min(127, q8k_nearest(__fmul_rn(iscale, v)));
+        dv = __fdiv_rn(1.0f, iscale);
+    }
+    q[(size_t) r * k + at] = qv;
+    if (lane == 0) d[(size_t) r * (k / 32) + at / 32] = dv;
+}
+void q8(const float* x, size_t ldx, int rows, int k, int8_t* q, float* d, cudaStream_t s) {
+    q8_kernel<<<dim3((unsigned) ((k / 32 + kWarps - 1) / kWarps), (unsigned) rows), kThreads, 0, s>>>(x, ldx, k, q, d);
+}
+// q8_kernel's rounding (the same q, d) with each 32's two 16-value sums of q (mm3_gv's minimum term: low 16 bits the
+// first half's, high the second's)
+__global__ void __launch_bounds__(kThreads) q8s_kernel(const float* __restrict__ x, size_t ldx, int k,
+                                                       int8_t* __restrict__ q, float* __restrict__ d, int* __restrict__ sums) {
+    const int r = blockIdx.y, b = blockIdx.x * kWarps + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+    if (b * 32 >= k) return;
+    const float v = x[(size_t) r * ldx + (size_t) b * 32 + lane];
+    float am = fabsf(v);
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) am = fmaxf(am, __shfl_xor_sync(0xffffffffu, am, o));
+    const float sc = am / 127.0f;
+    const int qi = am > 0.0f ? __float2int_rn(v / sc) : 0;
+    q[(size_t) r * k + (size_t) b * 32 + lane] = (int8_t) qi;
+    int sm = qi;
+#pragma unroll
+    for (int o = 8; o > 0; o >>= 1) sm += __shfl_xor_sync(0xffffffffu, sm, o);
+    const int hi = __shfl_sync(0xffffffffu, sm, 16);
+    if (lane == 0) {
+        d[(size_t) r * (k / 32) + b] = sc;
+        sums[(size_t) r * (k / 32) + b] = (sm & 0xffff) | (hi << 16);
+    }
+}
+void q8s(const float* x, size_t ldx, int rows, int k, int8_t* q, float* d, int* sums, cudaStream_t s) {
+    q8s_kernel<<<dim3((unsigned) ((k / 32 + kWarps - 1) / kWarps), (unsigned) rows), kThreads, 0, s>>>(x, ldx, k, q, d,
+                                                                                                      sums);
+}
+bool iq_q8k() {   // MAYA_MM3_IQ_Q8K=0: the experts' activations a scale a 32 (the dense GEMVs' rounding)
+    static const bool on = [] {
+        const char* v = ::mm3::env("MM3_IQ_Q8K");
+        return v == nullptr || std::atoi(v) != 0;
+    }();
+    return on;
+}
+void act(const float* x, size_t ldx, int rows, int k, int8_t* q, float* d, cudaStream_t s) {
+    if (iq_q8k() && k % 256 == 0) q8k_kernel<<<dim3((unsigned) (k / 256), (unsigned) rows), 256, 0, s>>>(x, ldx, k, q, d);
+    else q8(x, ldx, rows, k, q, d, s);
+}
+
+// ---- the routed experts' sum (mm3_exl3.cu's combine): the experts in plan order (one off the device adds 0), then
+// the CPU lane's part and the shared expert's
+struct Comb {
+    const unsigned long long* plan_ptr;   // [T][8]
+    const float* plan_w;                  // [T][8]
+    const float* part;                    // [T * 8][n_embd]
+    const float* cpu_part;
+    size_t cpu_stride;
+    const int* cpu_flag;
+    const float* sh_out;                  // [T][n_embd]
+    float* out;
+    size_t out_stride;
+    int k, n_embd;
+};
+__global__ void __launch_bounds__(128) comb_kernel(const Comb a) {
+    const int t = blockIdx.y, r = blockIdx.x * 128 + threadIdx.x;
+    if (r >= a.n_embd) return;
+    float m = 0.0f;
+    for (int i = 0; i < a.k; ++i) {
+        const int e = t * 8 + i;
+        const float p = a.plan_ptr[e] != 0ull ? a.part[(size_t) e * a.n_embd + r] : 0.0f;
+        m = __fmaf_rn(a.plan_w[e], p, m);
+    }
+    if (a.cpu_flag != nullptr && a.cpu_flag[t]) m = __fadd_rn(m, a.cpu_part[(size_t) t * a.cpu_stride + r]);
+    a.out[(size_t) t * a.out_stride + r] = __fadd_rn(m, a.sh_out != nullptr ? a.sh_out[(size_t) t * a.n_embd + r] : 0.0f);
+}
+
+// ---- the device's wait for the host's word (the CPU lane's parts), as mm3_exl3.cu's: it gives up after 120 s
+__device__ unsigned g_timeouts = 0;
+__global__ void wait_kernel(const unsigned* p, unsigned v, unsigned long long limit) {
+    if (threadIdx.x != 0) return;
+#if defined(STRATA_USE_HIP)
+    const unsigned long long t0 = wall_clock64();   // (limit: 120 s of its ticks, the host's hipDeviceAttributeWallClockRate)
+#else
+    unsigned long long t0;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));   // (ns)
+#endif
+    while (*(volatile const unsigned*) p != v) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 700
+        __nanosleep(200);
+#endif
+#if defined(STRATA_USE_HIP)
+        const unsigned long long t = wall_clock64();
+#else
+        unsigned long long t;
+        asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+#endif
+        if (t - t0 > limit) {
+            atomicAdd(&g_timeouts, 1u);
+            break;
+        }
+    }
+    __threadfence_system();
+}
+unsigned long long wait_limit() {   // 120 s in the wait kernel's clock
+#if defined(STRATA_USE_HIP)
+    static const unsigned long long l = [] {
+        int dev = 0, khz = 0;
+        if (hipGetDevice(&dev) != hipSuccess || hipDeviceGetAttribute(&khz, hipDeviceAttributeWallClockRate, dev) !=
+                                                    hipSuccess || khz <= 0)
+            khz = 100000;   // (100 MHz, RDNA's usual)
+        return 120ull * 1000ull * (unsigned long long) khz;
+    }();
+    return l;
+#else
+    return 120ull * 1000000000ull;
+#endif
+}
+
+// ---- per-stream scratch
+struct Scratch {
+    float* part = nullptr;   // [8][kMaxEmbd]: a token's experts' down outputs
+    float* h = nullptr;      // [8][kMaxEmbd]: a token's experts' activations (moe_gate_up's h when the caller gives none)
+    int8_t *xq = nullptr, *hq = nullptr, *mq = nullptr;   // int8 rows: x [kMaxEnt], h [kMaxEnt * 8], the GEMVs'
+    float *xd = nullptr, *hd = nullptr, *md = nullptr;     //   [kMaxMvJobs * kMaxMvCols] inputs; their scales
+    int* ms = nullptr;       // the GEMVs' inputs' 16-value sums (mm3_gv)
+    uint16_t* wb = nullptr;  // a GEMM's FP16 weight band (kBand bytes)
+    cublasHandle_t blas = nullptr;
+};
+std::mutex g_mu;
+std::unordered_map<cudaStream_t, Scratch> g_scratch;
+constexpr size_t kNx = (size_t) kMaxEnt * kMaxEmbd, kNh = (size_t) kMaxEnt * 8 * kMaxEmbd,
+                 kNm = (size_t) x3::kMaxMvJobs * x3::kMaxMvCols * kMaxQK;
+
+Scratch* scratch(cudaStream_t s) {
+    std::lock_guard<std::mutex> lk(g_mu);
+    auto it = g_scratch.find(s);
+    if (it != g_scratch.end()) return &it->second;
+    Scratch sc;
+    if (cudaMalloc(&sc.part, (size_t) 8 * kMaxEmbd * 4) != cudaSuccess ||
+        cudaMalloc(&sc.h, (size_t) 8 * kMaxEmbd * 4) != cudaSuccess || cudaMalloc(&sc.xq, kNx) != cudaSuccess ||
+        cudaMalloc(&sc.xd, kNx / 32 * 4) != cudaSuccess || cudaMalloc(&sc.hq, kNh) != cudaSuccess ||
+        cudaMalloc(&sc.hd, kNh / 32 * 4) != cudaSuccess || cudaMalloc(&sc.mq, kNm) != cudaSuccess ||
+        cudaMalloc(&sc.md, kNm / 32 * 4) != cudaSuccess || cudaMalloc(&sc.ms, kNm / 32 * 4) != cudaSuccess ||
+        cudaMalloc(&sc.wb, kBand) != cudaSuccess) {
+        cudaGetLastError();
+        fail("scratch: out of device memory");
+        return nullptr;
+    }
+    if (cublasCreate(&sc.blas) != CUBLAS_STATUS_SUCCESS || cublasSetStream(sc.blas, s) != CUBLAS_STATUS_SUCCESS) {
+        fail("scratch: cuBLAS");
+        return nullptr;
+    }
+    return &g_scratch.emplace(s, sc).first->second;
+}
+
+bool geometry(const char* who, int k, int n_embd, int n_ff) {
+    if (k < 1 || k > 8 || n_embd % 256 != 0 || n_ff % 256 != 0 || n_embd > kMaxEmbd || n_ff > kMaxEmbd) {
+        std::fprintf(stderr, "mm3 gguf %s: geometry not covered (k %d n_embd %d n_ff %d)\n", who, k, n_embd, n_ff);
+        g_errors.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    return true;
+}
+
+// a layer's experts as ds4_iq's arguments: the roles' offsets and types, MiniMax's swigluoai (false: types not covered)
+bool iq_args(const x3::ExpertLayout& lay, int n_embd, int n_ff, float limit, iq::Args& ia, const char* who) {
+    ia = iq::Args{};
+    for (int r = 0; r < 3; ++r) ia.tr[r] = lay.trellis[r];
+    ia.n_embd = n_embd;
+    ia.n_ff = n_ff;
+    ia.limit = limit;
+    ia.tg = lay.gg_type[0];
+    ia.td = lay.gg_type[2];
+    ia.act = iq::kActOai;
+    ia.tu = lay.gg_type[1] != lay.gg_type[0] ? lay.gg_type[1] : 0;
+    if (lay.fmt != kFmtGG || !iq::supported(lay.gg_type[0]) || !iq::supported(lay.gg_type[1]) ||
+        !iq::supported(lay.gg_type[2])) {
+        std::fprintf(stderr, "mm3 gguf %s: expert types %s / %s / %s not covered\n", who, type_name(lay.gg_type[0]),
+                     type_name(lay.gg_type[1]), type_name(lay.gg_type[2]));
+        g_errors.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    return true;
+}
+
+void combine(const x3::ExpertLayout&, const unsigned long long* plan_ptr, const float* plan_w, const float* part,
+             const float* cpu_part, size_t cpu_stride, const int* cpu_flag, const float* sh_out, float* out,
+             size_t out_stride, int T, int k, int n_embd, cudaStream_t s) {
+    Comb c{plan_ptr, plan_w, part, cpu_part, cpu_stride, cpu_flag, sh_out, out, out_stride, k, n_embd};
+    comb_kernel<<<dim3((unsigned) ((n_embd + 127) / 128), (unsigned) T), 128, 0, s>>>(c);
+}
