+// src/ds4/ds4_iq.cuh - a GGUF's routed experts in ggml's low-bit block types on the device for maya-ds4: the i-quants
+// IQ1_S, IQ1_M, IQ2_XXS, IQ2_S, IQ3_XXS, IQ3_S, IQ4_XS and the K-quants Q2_K, Q3_K, Q4_K (256 values a block, ggml's
+// layouts: ggml-common.h, llama.cpp MIT), IQ4_NL (32 values a block); Q5_K and Q6_K for a GGUF's dense matrices.  ds4_gguf.cu sends an expert
+// layer's gate / up, or its down, here when that role is not MXFP4 (x3::ExpertLayout::fmt kFmtMXFP4 with K[r] = role
+// r's ggml type; K[r] == kTypeMXFP4: ds4_gguf.cu's own kernels).
+//
+// Every weight is decoded exactly (ggml's dequantize_row_*: a block scale times an integer scale times a grid or code
+// value) and every product takes the activations rounded to int8 per 32 values with an F32 scale (ds4_gguf.cu's
+// q8_quant): a 32-value sub-block's sum is an exact integer dot (dp4a) times its scales in F32 - no integer division as
+// llama.cpp's vecdotq takes (its sums truncate), so these are the double reference's sums to F32 rounding.  A window's
+// entry gets the token path's bits (the same kernel, the same order).  IQ1_S / IQ1_M's +-1/8 shift of each grid value
+// (IQ1S_DELTA, a sign a sub-block or a group of 8) rides in the integer dot: the codes are 8 g +- 1 (g in {-1, 0, 1}),
+// the scale d / 8 - so the dot carries the int8 activations' group sums exactly.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cuda_runtime.h>
+
+namespace strata::ds4::gguf::iq {
+
+// ggml type ids
+constexpr int kQ2_K = 10, kQ3_K = 11, kQ4_K = 12, kQ5_K = 13, kIQ2_XXS = 16, kIQ2_XS = 17, kIQ3_XXS = 18, kIQ1_S = 19,
+              kIQ4_NL = 20, kIQ3_S = 21, kIQ2_S = 22, kIQ4_XS = 23, kIQ1_M = 29;
+// the dense matrices' types (a GGUF's attention, shared experts, output head - maya-mm3's MiniMax quants): the GEMVs
+// (mv), the FP16 rows (f16_rows) and decode_values only - not the routed experts' kernels
+constexpr int kQ8_0 = 8, kQ6_K = 14;
+
+/// The routed experts' activation between gate / up and down (Args::act, SetArgs::act):
+///   kActSwiglu  DeepSeek's clamped SwiGLU: g = min(g, limit), u = clamp(u, -limit, limit), silu(g) u (limit 0: none)
+///   kActOai     MiniMax's swigluoai (gpt-oss's, llama.cpp's LLM_FFN_SWIGLU_OAI_MOE): the same clamps, then
+///               g sigmoid(kOaiAlpha g) (u + 1)
+constexpr int kActSwiglu = 0, kActOai = 1;
+constexpr float kOaiAlpha = 1.702f;
+
+/// Whether the routed experts' kernels take this ggml type.
+bool supported(int type);
+/// Whether the GEMVs and FP16 rows take it (the experts' types and the dense ones: Q8_0, Q6_K).
+bool mv_supported(int type);
+/// Values a block of the type (32: Q8_0, IQ4_NL; 256: the others).
+inline int block_values(int type) { return type == kQ8_0 || type == kIQ4_NL ? 32 : 256; }
+/// Bytes of a block of the type (0: not one of these).
+int block_bytes(int type);
+/// Bytes of a row of k values (k a multiple of the type's block).
+inline size_t row_bytes(int type, int64_t k) { return (size_t) (k / block_values(type)) * (size_t) block_bytes(type); }
+/// The type's name ("?" when unknown).
+const char* name(int type);
+
+/// The token / window experts (ds4_gguf.cu's MxArgs, with the roles' types): group g = an expert (grp_ptr null: expert g
+/// of the plan, plan_ptr[g] its blob or 0, its entry g, input row 0; else blob grp_ptr[g], entries grp_ent[grp_start[g]
+/// ..], entry e's input row e >> 3).  x / h as int8 rows with an F32 scale per 32 (xq, xd: rows of n_embd; hq, hd: row e
+/// = entry e, rows of n_ff).
+struct Args {
+    const unsigned long long* plan_ptr = nullptr;
+    const unsigned long long* grp_ptr = nullptr;
+    const int *grp_start = nullptr, *grp_ent = nullptr, *n_groups = nullptr;
+    size_t tr[3] = {0, 0, 0};   // the roles' offsets in a blob
+    int n_embd = 0, n_ff = 0;
+    float limit = 0.0f;
+    const int8_t* xq = nullptr;
+    const float* xd = nullptr;
+    const int8_t* hq = nullptr;
+    const float* hd = nullptr;
+    float* h = nullptr;      // [entries][n_ff]: the activation (act's)
+    float* part = nullptr;   // [entries][n_embd]: each entry's down output
+    int tg = 0, td = 0;      // gate / up's type, down's
+    int act = kActSwiglu;    // the activation (kActOai: MiniMax's)
+    int tu = 0;              // (kActOai) the up's type when it is not the gate's (0: tg): gate and up then in two passes,
+                             // the gate's sums in h first - each value the same as one pass gives
+};
+/// grid (n_ff / 8, groups): h of every entry (ne_max: a group's most entries).  false: a type not covered.
+bool gate_up(const Args& a, int groups, int ne_max, cudaStream_t s);
+/// grid (n_embd / 8, groups): part of every entry.
+bool down(const Args& a, int groups, int ne_max, cudaStream_t s);
+
+/// The prompt path's expert sets (ds4_gguf.cu's SetK): expert i's blob at wbase + i stride owns the sorted rows
+/// [bounds[i], bounds[i + 1]) (local row = sorted row - row0); gate / up: h16[local] = F16 swiglu over x[idx[local]]
+/// (F32 rows, ldx); down: y[local] = down(h16[local]) (F16 rows in, ldx; F32 out, ldo).  A set's experts of at most 16
+/// rows take the token kernels' form (each weight read once, the rows' inputs rounded to int8 per 32 as the token path
+/// rounds them; STRATA_DS4_NO_LIGHT=1: never), the others GEMM tiles (tensor cores on CUDA, F16 operands).
+struct SetArgs {
+    const uint8_t* wbase = nullptr;
+    size_t stride = 0;
+    size_t tr[3] = {0, 0, 0};
+    const int* bounds = nullptr;
+    int row0 = 0, max_rows = 0, n_exp = 0;
+    int n_embd = 0, n_ff = 0;
+    float limit = 0.0f;
+    const float* xf = nullptr;
+    const int* idx = nullptr;
+    const uint16_t* xh = nullptr;
+    int ldx = 0;
+    uint16_t* h = nullptr;
+    float* y = nullptr;
+    int ldo = 0;
+    int tg = 0, td = 0;
+    int skip_le = 0;   // (the tiles) the experts of at most this many rows are left out: the light kernels took them
+    int xh_vec = 0;    // (launch_set's: xh 16-byte aligned rows - the tensor-core tiles load 8 values at once)
+    int skip_ge = 0;   // (the tiles) > 0: the experts of at least this many rows are left out - the caller's GEMMs
+    int act = kActSwiglu;      // the activation (Args::act)
+    int tu = 0;                // (kActOai) the up's type when it is not the gate's (0: tg) - two passes, as Args::tu
+    float* graw = nullptr;     // ... the gate's F32 sums between them: [local rows][n_ff] (the caller's scratch)
+};
+#if defined(STRATA_USE_HIP)
+// Host metadata for a prompt set, valid only within this scope; nested calls restore their caller's metadata.
+// Keeping it here leaves the shared EXL3/GGUF SetArgs ABI unchanged.
+class MmqRowsScope {
+public:
+    MmqRowsScope(int total_rows, const int* host_bounds);
+    ~MmqRowsScope();
+    MmqRowsScope(const MmqRowsScope&) = delete;
+    MmqRowsScope& operator=(const MmqRowsScope&) = delete;
+private:
+    int previous_rows_;
+    const int* previous_bounds_;
+};
+// The prompt set's scratch for its int8 activations (the fused experts, STRATA_DS4_PREFILL_FUSED): the caller's down
+// output rows, which the set's gate / up leaves unused until its down writes them; nested scopes restore their caller's.
+class FusedScratchScope {
+public:
+    FusedScratchScope(void* scratch, size_t bytes);
+    ~FusedScratchScope();
+    FusedScratchScope(const FusedScratchScope&) = delete;
+    FusedScratchScope& operator=(const FusedScratchScope&) = delete;
+private:
+    void* previous_;
+    size_t previous_bytes_;
+};
+#endif
+bool set_gate_up(const SetArgs& a, cudaStream_t s);
+bool set_down(const SetArgs& a, cudaStream_t s);
+/// The busy experts' path (a prompt's experts of many rows): one expert's matrix - n rows of k values, row_bytes(k)
+/// apart - as FP16 rows (ldd apart), the values the tensor-core tiles multiply (their loader's, rounded to FP16 the same
+/// way), for the caller's GEMM: the tiles decode an expert's weights again for every 64 of its rows.
+bool f16_rows(int type, const uint8_t* w, int k, int n, uint16_t* dst, int ldd, cudaStream_t s);
+/// dst[r] = x[idx[r]] for r < n (FP16 rows of k values; x ldx apart, dst k apart)
+void gather_f16(const uint16_t* x, int ldx, const int* idx, int n, int k, uint16_t* dst, cudaStream_t s);
+/// h[r][c] = FP16 of the tiles' clamped SwiGLU of gu[r][c] (gate) and gu[r][ff + c] (up), F32 rows ld apart
+void swiglu_f16(const float* gu, int ld, int n, int ff, float limit, uint16_t* h, int ldh, cudaStream_t s);
+/// The light form alone (the set's experts of at most 16 rows; the others untouched), for any of these types and MXFP4
+/// (tg / td 39: ds4_gguf.cu's experts): false (nothing launched) when it is switched off - the caller's tiles take every
+/// expert then; true: they take those of more rows (skip_le 16).
+bool light_gate_up(const SetArgs& a, cudaStream_t s);
+bool light_down(const SetArgs& a, cudaStream_t s);
+
+/// GEMV jobs on such matrices (an expert's views on the host-routed path): y[c][r] = alpha (row r . x_c) + bias[r] for
+/// ncol activations, x as int8 rows (xq + c k, scales xd + c k / 32).
+struct MvJob {
+    const uint8_t* w = nullptr;
+    size_t ld = 0;   // bytes a row
+    int type = 0, k = 0, n = 0, ncol = 1;
+    const int8_t* xq = nullptr;
+    const float* xd = nullptr;
+    float* y = nullptr;
+    size_t ycs = 0;
+    const float* bias = nullptr;
+    float alpha = 1.0f;
+};
+bool mv(const MvJob* jobs, int n, cudaStream_t s);
+
+/// (tests) every value of n rows of k (rows row_bytes(type, k) apart, on the device) as the kernels decode them: sub =
+/// the token / window / light kernels' codes times their scales (d s q - m; IQ1_M through the persistent kernels'
+/// code table while those are on), tile = the prompt tiles' loader (F32, before their F16) - both ggml's
+/// dequantize_row_* values to the bit.  false: a type not covered.
+bool decode_values(int type, const uint8_t* w, int k, int n, float* sub, float* tile, cudaStream_t s);
+
+/// The token / window kernels and the light sets of experts of <= 4 rows for the types of a large codebook (IQ1_S,
+/// IQ1_M, IQ2_S: 8 KiB and more), maya-ds4's on CUDA: a grid of the blocks the device holds at once, each block loading
+/// its codebook once and taking work items (a group, a tile of rows) round it - IQ1_M's codes then from a table of 4096
+/// entries (ds4_iq1_codes.hpp).  Each output the same lanes' sums in the same order as the full grid's: the same bits.
+/// DS4_IQ_PERSIST=0 (MAYA_DS4_IQ_PERSIST): the full grids, as before (HIP and maya-mm3: always); unset: on for a device of
+/// compute capability 8.0 and up, off below (a V100 is about 2% slower with them); 1: on everywhere.  (tests)
+/// set_persist(1 / 0): on / off for the calls after it, -1: the environment's again.
+bool persist_on();
+void set_persist(int on);
+
+}  // namespace strata::ds4::gguf::iq
diff --git a/backends/minimax/vendor/project-maya/src/ds4/ds4_iq1_codes.hpp b/backends/minimax/vendor/project-maya/src/ds4/ds4_iq1_codes.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..cee261fdf10a388327da0f58b4d54889d9b8a33f
--- /dev/null
+++ b/backends/minimax/vendor/project-maya/src/ds4/ds4_iq1_codes.hpp
@@ -0,0 +1,52 @@
+// src/ds4/ds4_iq1_codes.hpp - IQ1_S / IQ1_M's grid values as the int8 codes ds4_iq.cu's kernels dot, host and device
+// alike (tests/ds4_iq_host_test.cpp builds IQ1_M's code table with these and checks it against ggml's own decode).
+//
+// iq1s_grid_gpu (ggml-common.h) holds a grid entry's 8 values as nibbles n = g + 1 (g in {-1, 0, 1}): values 0..3 in
+// the low nibbles of its 4 bytes, 4..7 in the high ones.  A value's weight is d s (g +- 1/8), the sign that of its
+// group's delta (IQ1S_DELTA): as the code 8 g +- 1 the scale is d s / 8, so a sub-block's sum stays an exact integer
+// dot.  The 11-bit grid index and the delta's sign of a group are 12 bits of an IQ1_M block side by side (a qs byte,
+// then a qh nibble: 3 index bits and the sign), so IQ1_M's codes can come from one table of 4096 entries - the grid
+// lookup and the delta's bias in one load (ds4_iq.cu's persistent kernels: the table built once a block).
+#pragma once
+
+#include <cstdint>
+
+#if defined(__CUDACC__) || defined(__HIPCC__)
+#define DS4_IQ1_HD __host__ __device__ __forceinline__
+#else
+#define DS4_IQ1_HD inline
+#endif
+
+namespace strata::ds4::gguf::iq {
+
+// 4 nibbles times 8 (bits 3..6 of each byte: 0, 8 or 16) -> 4 codes, a byte each: bias 0x79 (delta +1/8: 8 n - 7) or
+// 0x77 (-1/8: 8 n - 9) a byte, its top bit flipped back after - each byte's sum stays below 0x100, so nothing carries
+// into the next
+DS4_IQ1_HD uint32_t iq1_bias(uint32_t neg) { return neg ? 0x77777777u : 0x79797979u; }
+DS4_IQ1_HD int iq1c(uint32_t n8, uint32_t bias) { return (int) (((n8 & 0x78787878u) + bias) ^ 0x80808080u); }
+
+// IQ1_M's code table: entry (neg << 11) | grid index = the grid entry's values 0..3 (lo) and 4..7 (hi) as codes, the
+// delta's sign neg (two words an entry: 32 KiB)
+constexpr int kIq1mCodes = 4096;
+DS4_IQ1_HD void iq1m_codes(uint32_t g, uint32_t neg, uint32_t& lo, uint32_t& hi) {
+    const uint32_t b = iq1_bias(neg);
+    lo = (uint32_t) iq1c(g << 3, b);
+    hi = (uint32_t) iq1c(g >> 1, b);
+}
+// the table's entry for group l (0..3) of an IQ1_M sub-block: byte l of its qs word q4, and bits 4 l .. 4 l + 3 of its
+// two qh bytes h (3 index bits, then the delta's sign) - the 12 bits as they stand
+DS4_IQ1_HD uint32_t iq1m_entry(uint32_t q4, uint32_t h, int l) {
+    return ((q4 >> (8 * l)) & 255u) | (((h >> (4 * l)) & 15u) << 8);
+}
+// IQ1_M's F16 block scale (its bits): the top nibbles of its 4 scale words (s01: words 0, 1; s23: words 2, 3)
+DS4_IQ1_HD uint16_t iq1m_d16(uint32_t s01, uint32_t s23) {
+    return (uint16_t) (((s01 >> 12) & 0xFu) | ((s01 >> 24) & 0xF0u) | ((s23 >> 4) & 0xF00u) | ((s23 >> 16) & 0xF000u));
+}
+// sub-block ib's two 3-bit scales as 2 s + 1: s0 for its values 0..15, s1 for 16..31
+DS4_IQ1_HD void iq1m_scales(uint32_t s01, uint32_t s23, int ib, int& s0, int& s1) {
+    const uint32_t w = ((ib >> 1) < 2 ? s01 : s23) >> (16 * ((ib >> 1) & 1) + 6 * (ib & 1));
+    s0 = 2 * (int) (w & 7u) + 1;
+    s1 = 2 * (int) ((w >> 3) & 7u) + 1;
+}
+
+}  // namespace strata::ds4::gguf::iq
diff --git a/backends/minimax/vendor/project-maya/src/ds4/ds4_iq512_kern.inc b/backends/minimax/vendor/project-maya/src/ds4/ds4_iq512_kern.inc
new file mode 100644
index 0000000000000000000000000000000000000000..acb1edec7a228c75f6a708c3944ca0e105e21aac
--- /dev/null
+++ b/backends/minimax/vendor/project-maya/src/ds4/ds4_iq512_kern.inc
@@ -0,0 +1,207 @@
+// src/ds4/ds4_iq512_kern.inc - the CPU lane's exact AVX-512 rows that need no VBMI: IQ2_XS, IQ3_XXS and IQ1_M.
+// ds4_iq_cpu.cpp includes it once a tier, inside its unnamed namespace (after hsum_ggml, tab4, tab8, fold, scales4),
+// with
+//   IQX_NS    the tier's namespace
+//   IQX_ATTR  the tier's instruction set as a function attribute (GCC / Clang: target(...); MSVC: nothing) on every
+//             function here, so the file is built for the baseline and each tier runs only where iq_isa() says it can
+//   IQX_POP   (the second tier) the sign bytes' parity by VPOPCNTDQ; without it, by a 16-entry table in a register
+//             (ggml's own AVX2 trick) - the same bytes, so either tier gives the same bits
+// and gets IQX_NS::rows<TY, NT>(...) for TY 17 (IQ2_XS) and 18 (IQ3_XXS), and in the first tier rows_iq1m<NT>(...)
+// (IQ1_M has no sign indices; its grid indices and delta signs come from BMI2's pdep / pext, as ggml's).  The
+// macros are undefined at the end.
+//
+// A 64-value chunk a step, as the GLM lane's AVX-512 rows (src/kernels/cpu/iq_avx512.cpp): its grid bytes (table
+// entries put together in two 256-bit halves by tab4 / tab8), one 64-bit sign mask, the scales as int16 lanes - decoded
+// once, then every token: a masked subtract, vpmaddubsw, vpmaddwd and an add.  IQ2_XS and IQ3_XXS sign their 8-value
+// groups by a 7-bit index whose eighth bit is the parity of the seven (ksigns_iq2xs); the eight indices of a chunk
+// get their parities in one vector instead of eight table loads.  The integer lanes of a block are exact and fold to
+// ggml's 8 (lane k + lane k + 8), then ggml's float steps in ggml's order: every result is ggml-cpu's AVX2 dot to the
+// bit (own_check, before the rows are used).
+namespace IQX_NS {
+
+#if defined(IQX_POP)
+// ksigns_iq2xs of eight 7-bit indices (a dword lane each) as the 64 bits of a mask: i | parity(i) << 7, the parity
+// the count's lowest bit (vpmovdb keeps each lane's low byte)
+IQX_ATTR inline uint64_t sign_bytes(__m256i s) {
+    const __m256i b = _mm256_or_si256(s, _mm256_slli_epi32(_mm256_popcnt_epi32(s), 7));
+    return (uint64_t) _mm_cvtsi128_si64(_mm256_cvtepi32_epi8(b));
+}
+// IQ2_XS: the indices are the top 7 bits of 8 words
+IQX_ATTR inline uint64_t sign_bytes_w(__m128i q) {
+    return sign_bytes(_mm256_srli_epi32(_mm256_cvtepu16_epi32(q), 9));
+}
+#else
+// the same bytes without VPOPCNTDQ: the parity of the xor of the index's two nibbles, from a pshufb table
+IQX_ATTR inline __m128i odd_nibbles() {
+    return _mm_setr_epi8(0, -128, -128, 0, -128, 0, 0, -128, -128, 0, 0, -128, 0, -128, -128, 0);
+}
+IQX_ATTR inline uint64_t sign_bytes(__m256i s) {
+    const __m256i nib = _mm256_and_si256(_mm256_xor_si256(s, _mm256_srli_epi32(s, 4)), _mm256_set1_epi32(15));
+    const __m256i par = _mm256_shuffle_epi8(_mm256_broadcastsi128_si256(odd_nibbles()), nib);
+    return (uint64_t) _mm_cvtsi128_si64(_mm256_cvtepi32_epi8(_mm256_or_si256(s, par)));
+}
+// IQ2_XS in 16-bit lanes (ggml's own steps): index s = q >> 9, the nibbles' xor s ^ (q >> 13) (below 128, so pshufb
+// reads its low nibble), the bytes packed
+IQX_ATTR inline uint64_t sign_bytes_w(__m128i q) {
+    const __m128i s = _mm_srli_epi16(q, 9);
+    const __m128i par = _mm_shuffle_epi8(odd_nibbles(), _mm_xor_si128(s, _mm_srli_epi16(q, 13)));
+    return (uint64_t) _mm_cvtsi128_si64(_mm_packus_epi16(_mm_or_si128(s, par), _mm_setzero_si128()));
+}
+#endif
+
+// a step's scale lanes out of a block's 16 scale words (sc), int16 lanes 8 g .. 8 g + 7 <- word base + S g
+template <int S>
+IQX_ATTR inline __m512i step_scales(__m256i sc, int base) {
+    const __m512i idx = _mm512_add_epi16(_mm512_set1_epi16((short) base),
+                                         _mm512_set_epi16(3 * S, 3 * S, 3 * S, 3 * S, 3 * S, 3 * S, 3 * S, 3 * S, 2 * S, 2 * S,
+                                                          2 * S, 2 * S, 2 * S, 2 * S, 2 * S, 2 * S, S, S, S, S, S, S, S, S, 0,
+                                                          0, 0, 0, 0, 0, 0, 0));
+    return _mm512_permutexvar_epi16(idx, _mm512_castsi256_si512(sc));
+}
+
+// rows [r0, r1) (out[t][r - r0]) of NT tokens, TY 17 = IQ2_XS, 18 = IQ3_XXS
+template <int TY, int NT>
+IQX_ATTR void rows(const uint8_t* w, size_t rb, int nb, const block_q8_K* const* y, float* const* out, int r0, int r1) {
+    constexpr size_t BB = TY == 17 ? sizeof(block_iq2_xs) : sizeof(block_iq3_xxs);
+    constexpr float K = TY == 17 ? 0.125f : 0.25f;
+    const __m512i zero = _mm512_setzero_si512();
+    const __m256i sh7 = _mm256_setr_epi32(0, 7, 14, 21, 0, 7, 14, 21);
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* row = w + (size_t) r * rb;
+        __m256 accf[NT];
+        for (int t = 0; t < NT; ++t) accf[t] = _mm256_setzero_ps();
+        for (int i = 0; i < nb; ++i) {
+            const uint8_t* blk = row + (size_t) i * BB;
+            // (the rows stream from DRAM: the bytes a few blocks ahead asked for, as the GLM lane's AVX-512 rows do)
+            _mm_prefetch((const char*) blk + 2048, _MM_HINT_T0);
+            _mm_prefetch((const char*) blk + 2048 + 64, _MM_HINT_T0);
+            __m512i acc[NT];
+            for (int t = 0; t < NT; ++t) acc[t] = _mm512_setzero_si512();
+            __m256i scw = _mm256_setzero_si256();   // (IQ2_XS: the block's 16 scales 2 s + 1, word 2 b + h: byte b's nibble h)
+            if constexpr (TY == 17) {
+                const __m128i b = _mm_cvtepu8_epi16(_mm_loadl_epi64((const __m128i*) (blk + 66)));
+                const __m128i lo = _mm_and_si128(b, _mm_set1_epi16(15)), hi = _mm_srli_epi16(b, 4);
+                scw = _mm256_inserti128_si256(_mm256_castsi128_si256(_mm_unpacklo_epi16(lo, hi)), _mm_unpackhi_epi16(lo, hi), 1);
+                scw = _mm256_add_epi16(_mm256_add_epi16(scw, scw), _mm256_set1_epi16(1));
+            }
+            for (int j = 0; j < 4; ++j) {
+                __m512i g, sc;
+                uint64_t sm;
+                if constexpr (TY == 17) {   // 8 words: a 9-bit grid index, a 7-bit sign index; 2 scale bytes
+                    const uint8_t* q = blk + 2 + 16 * j;
+                    uint16_t v[8];
+                    std::memcpy(v, q, 16);
+                    g = _mm512_inserti64x4(
+                        _mm512_castsi256_si512(tab4(iq2xs_grid, v[0] & 511u, v[1] & 511u, v[2] & 511u, v[3] & 511u)),
+                        tab4(iq2xs_grid, v[4] & 511u, v[5] & 511u, v[6] & 511u, v[7] & 511u), 1);
+                    sm = sign_bytes_w(_mm_loadu_si128((const __m128i*) q));
+                    sc = step_scales<1>(scw, 4 * j);   // (words 4 j .. 4 j + 3)
+                } else {   // 16 grid indices; the two chunks' words of four 7-bit sign indices and a scale
+                    const uint8_t* q = blk + 2 + 16 * j;
+                    unsigned i1[8], i2[8];
+                    for (int k = 0; k < 8; ++k) {
+                        i1[k] = q[k];
+                        i2[k] = q[8 + k];
+                    }
+                    g = _mm512_inserti64x4(_mm512_castsi256_si512(tab8(iq3xxs_grid, i1)), tab8(iq3xxs_grid, i2), 1);
+                    const uint32_t a = u32(blk + 2 + QK_K / 4 + 8 * j), c = u32(blk + 2 + QK_K / 4 + 8 * j + 4);
+                    const __m256i ac =
+                        _mm256_inserti128_si256(_mm256_castsi128_si256(_mm_set1_epi32((int) a)), _mm_set1_epi32((int) c), 1);
+                    sm = sign_bytes(_mm256_and_si256(_mm256_srlv_epi32(ac, sh7), _mm256_set1_epi32(127)));
+                    const int sa = 2 * (int) (a >> 28) + 1, sb = 2 * (int) (c >> 28) + 1;
+                    sc = scales4(sa, sa, sb, sb);
+                }
+                const __mmask64 m = _cvtu64_mask64(sm);
+                for (int t = 0; t < NT; ++t) {
+                    const __m512i yv = _mm512_loadu_si512((const void*) (y[t][i].qs + 64 * j));
+                    const __m512i ys = _mm512_mask_sub_epi8(yv, m, zero, yv);
+                    acc[t] = _mm512_add_epi32(acc[t], _mm512_madd_epi16(_mm512_maddubs_epi16(g, ys), sc));
+                }
+            }
+            uint16_t dh;
+            std::memcpy(&dh, blk, 2);
+            const float dx = h2f(dh);
+            for (int t = 0; t < NT; ++t)
+                accf[t] = _mm256_fmadd_ps(_mm256_set1_ps(dx * y[t][i].d), _mm256_cvtepi32_ps(fold(acc[t])), accf[t]);
+        }
+        for (int t = 0; t < NT; ++t) out[t][r - r0] = K * hsum_ggml(accf[t]);
+    }
+}
+
+#if !defined(IQX_POP)
+// IQ1_M rows [r0, r1) of NT tokens: ggml's AVX2 dot (two sums: the grid's and the deltas') in 512-bit lanes.  The
+// grid indices of a 64-value step by two pdep each four (a qs byte and the low 3 bits of a qh nibble), the grid values
+// (-1, 0, 1) as |g| and a negative mask; each 8-value group's delta sign (the nibble's bit 3) negates that group's 4
+// scale lanes, and the delta sum takes the activations' pair sums - ggml's sign-then-sum (ggml's Q8_K rounds to
+// -127 .. 127, where negating a pair's sum is summing its negated values); d is the F16 in the scale words' top nibbles
+template <int NT>
+IQX_ATTR void rows_iq1m(const uint8_t* w, size_t rb, int nb, const block_q8_K* const* y, float* const* out, int r0,
+                        int r1) {
+    const __m512i zero = _mm512_setzero_si512(), one = _mm512_set1_epi8(1);
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* row = w + (size_t) r * rb;
+        __m256 accf[NT], accd[NT];
+        for (int t = 0; t < NT; ++t) accf[t] = accd[t] = _mm256_setzero_ps();
+        for (int i = 0; i < nb; ++i) {
+            const uint8_t* blk = row + (size_t) i * sizeof(block_iq1_m);
+            _mm_prefetch((const char*) blk + 2048, _MM_HINT_T0);
+            _mm_prefetch((const char*) blk + 2048 + 64, _MM_HINT_T0);
+            const uint8_t* qs = blk;
+            const uint8_t* qh = blk + QK_K / 8;
+            uint16_t sw[4];
+            std::memcpy(sw, blk + QK_K / 8 + QK_K / 16, 8);
+            const uint16_t dh = (uint16_t) ((sw[0] >> 12) | ((sw[1] >> 8) & 0x00f0) | ((sw[2] >> 4) & 0x0f00) | (sw[3] & 0xf000));
+            // the block's 16 3-bit scales as 2 s + 1, word 4 h + j: scale word j's bits 3 h .. 3 h + 2 (step j's lane
+            // groups: words j, 4 + j, 8 + j, 12 + j)
+            uint64_t sw64;
+            std::memcpy(&sw64, sw, 8);
+            __m256i scw = _mm256_srlv_epi64(_mm256_set1_epi64x((long long) sw64), _mm256_setr_epi64x(0, 3, 6, 9));
+            scw = _mm256_and_si256(scw, _mm256_set1_epi16(7));
+            scw = _mm256_add_epi16(_mm256_add_epi16(scw, scw), _mm256_set1_epi16(1));
+            __m512i acc[NT], acd[NT];
+            for (int t = 0; t < NT; ++t) acc[t] = acd[t] = _mm512_setzero_si512();
+            for (int j = 0; j < 4; ++j) {
+                const uint32_t h = u32(qh + 4 * j);
+                const uint64_t p1 = _pdep_u64(u32(qs + 8 * j), 0x00ff00ff00ff00ffull) |
+                                    _pdep_u64(h & 0x7777u, 0x0f000f000f000f00ull);
+                const uint64_t p2 = _pdep_u64(u32(qs + 8 * j + 4), 0x00ff00ff00ff00ffull) |
+                                    _pdep_u64((h >> 16) & 0x7777u, 0x0f000f000f000f00ull);
+                const __m512i g = _mm512_inserti64x4(
+                    _mm512_castsi256_si512(tab4(iq1s_grid, (unsigned) (p1 & 0xffff), (unsigned) ((p1 >> 16) & 0xffff),
+                                                (unsigned) ((p1 >> 32) & 0xffff), (unsigned) (p1 >> 48))),
+                    tab4(iq1s_grid, (unsigned) (p2 & 0xffff), (unsigned) ((p2 >> 16) & 0xffff),
+                         (unsigned) ((p2 >> 32) & 0xffff), (unsigned) (p2 >> 48)),
+                    1);
+                const __m512i ag = _mm512_abs_epi8(g);
+                const __mmask64 gn = _mm512_movepi8_mask(g);
+                const __m512i sc = step_scales<4>(scw, j);
+                const __mmask32 dn = (__mmask32) (_pdep_u32(_pext_u32(h, 0x88888888u), 0x11111111u) * 15u);
+                const __m512i sd = _mm512_mask_sub_epi16(sc, dn, zero, sc);
+                for (int t = 0; t < NT; ++t) {
+                    const __m512i yv = _mm512_loadu_si512((const void*) (y[t][i].qs + 64 * j));
+                    const __m512i ys = _mm512_mask_sub_epi8(yv, gn, zero, yv);
+                    acc[t] = _mm512_add_epi32(acc[t], _mm512_madd_epi16(_mm512_maddubs_epi16(ag, ys), sc));
+                    acd[t] = _mm512_add_epi32(acd[t], _mm512_madd_epi16(_mm512_maddubs_epi16(one, yv), sd));
+                }
+            }
+            const float dx = h2f(dh);
+            for (int t = 0; t < NT; ++t) {
+                const __m256 d = _mm256_set1_ps(y[t][i].d * dx);
+                accf[t] = _mm256_fmadd_ps(d, _mm256_cvtepi32_ps(fold(acc[t])), accf[t]);
+                accd[t] = _mm256_fmadd_ps(d, _mm256_cvtepi32_ps(fold(acd[t])), accd[t]);
+            }
+        }
+        // (ggml's last line one FMA as gcc builds it, or a multiply then an add: g_iq1m_fma, own()'s check)
+        for (int t = 0; t < NT; ++t) {
+            const float hf = hsum_ggml(accf[t]), hd = hsum_ggml(accd[t]);
+            out[t][r - r0] = g_iq1m_fma ? std::fma(IQ1M_DELTA, hd, hf) : hf + mul_exact(IQ1M_DELTA, hd);
+        }
+    }
+}
+#endif
+
