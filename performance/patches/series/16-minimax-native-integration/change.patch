+namespace {
+iq::SetArgs set_args(const x3::SetArgs& sa, const iq::Args& ia) {
+    iq::SetArgs q;
+    q.wbase = sa.wbase;
+    q.stride = sa.stride;
+    for (int r = 0; r < 3; ++r) q.tr[r] = sa.lay.trellis[r];
+    q.bounds = sa.bounds;
+    q.row0 = sa.row0;
+    q.max_rows = sa.max_rows;
+    q.n_exp = sa.n_exp;
+    q.n_embd = sa.n_embd;
+    q.n_ff = sa.n_ff;
+    q.limit = sa.limit;
+    q.skip_ge = sa.skip_ge;
+    q.tg = ia.tg;
+    q.td = ia.td;
+    q.act = ia.act;
+    q.tu = ia.tu;
+    q.graw = sa.graw;
+    return q;
+}
