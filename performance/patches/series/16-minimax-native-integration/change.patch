+// ---------------------------------------------------------------- per-stream scratch
+constexpr size_t kPartFloats = (size_t) 4 << 20;   // split partials: 16 MB (a head of 200K outputs: 10 columns a pass)
+constexpr size_t kCounters = 16384;
+constexpr size_t kCntGU = 8192;                    // the counters from here on: the experts' gate / up pairs
+constexpr size_t kHFloats = (size_t) 8 * 8192;     // the experts' h
+constexpr size_t kUFloats = (size_t) 128 * 4096;   // the experts' up values: a window's 16 tokens x 8, n_ff <= 4096
+struct Scratch {
+    float* part = nullptr;
+    unsigned* cnt = nullptr;
+    float* h = nullptr;
+    float* u = nullptr;
+};
+std::mutex g_mu;
+std::map<std::pair<int, cudaStream_t>, Scratch> g_scratch;
+
+Scratch* scratch(cudaStream_t s) {
+    int dev = 0;
+    cudaGetDevice(&dev);
+    // (the last stream this thread used: an engine thread per device launches without the lock)
+    thread_local int t_dev = -1;
+    thread_local cudaStream_t t_s = nullptr;
+    thread_local Scratch* t_sc = nullptr;
+    if (t_sc != nullptr && t_dev == dev && t_s == s) return t_sc;
+    std::lock_guard<std::mutex> lk(g_mu);
+    auto it = g_scratch.find({dev, s});
+    if (it != g_scratch.end()) {
+        t_dev = dev, t_s = s, t_sc = &it->second;
+        return &it->second;
+    }
+    cudaStreamCaptureStatus cs = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(s, &cs) == cudaSuccess && cs != cudaStreamCaptureStatusNone) {
+        std::fprintf(stderr, "exl3: scratch for a stream first seen inside a graph capture (call exl3::prepare)\n");
+        return nullptr;
+    }
+    Scratch sc;
+    if (cudaMalloc(&sc.part, kPartFloats * sizeof(float)) != cudaSuccess ||
+        cudaMalloc(&sc.cnt, kCounters * sizeof(unsigned)) != cudaSuccess ||
+        cudaMalloc(&sc.h, kHFloats * sizeof(float)) != cudaSuccess ||
+        cudaMalloc(&sc.u, kUFloats * sizeof(float)) != cudaSuccess ||
+        cudaMemsetAsync(sc.cnt, 0, kCounters * sizeof(unsigned), s) != cudaSuccess) {
+        std::fprintf(stderr, "exl3: scratch did not allocate\n");
+        return nullptr;
+    }
+    cudaStreamSynchronize(s);
+    return &(g_scratch[{dev, s}] = sc);
+}
+
+int sm_count() {
+    int dev = 0, sms = 0;
+    cudaGetDevice(&dev);
+    cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, dev);
+    return std::max(1, sms);
+}
+
+
+// the blocks of mv_kernel<K2> an SM of the current device keeps at once (its registers and shared memory), asked once
+// per device and bitrate
+template <int K2, int cb> struct OccMv {
+    static void run(int& n) {
+        if (cudaOccupancyMaxActiveBlocksPerMultiprocessor(&n, mv_kernel<K2, cb>, kThreads, 0) != cudaSuccess) {
+            cudaGetLastError();
+            n = 2;
+        }
+    }
+};
+int mv_occ(int k2) {
+    static std::atomic<int> cache[64][17];   // [device][k2]; 0: not asked
+    int dev = 0;
+    cudaGetDevice(&dev);
+    if (dev < 0 || dev >= 64 || !k2_supported(k2, 2)) return 2;
+    int n = cache[dev][k2].load(std::memory_order_acquire);
+    if (n == 0) {
+        n = 2;
+        dispatch<OccMv>(k2, 2, n);
+        n = std::max(1, n);
+        cache[dev][k2].store(n, std::memory_order_release);
+    }
+    return n;
+}
+
+// mv's input split for m: S blocks of kr inputs per output block, at most kMaxKR inputs a block (the same for every
+// activation count, so a job of several sums each activation as a job of one).  About two blocks per SM; where an SM
+// keeps three or more (`occ`: the RTX 3090's at K > 4) four a SM, down to 128 inputs a block - its decode sets the pace
+// there, and the more, shorter blocks balance it over the SMs (RTX 3090, K6 / K5, us: a KDA layer's 8192 x 4096
+// output 47.6 -> 45.5, the dense layers' 4096 x 12288 gate 58.9 -> 52.5 and 12288 x 4096 down 59.3 -> 52.2, the
+// shared expert's 4096 x 2048 17.4 -> 16.5); with two a SM, a launch that would spill a short second wave (more blocks
+// than the SMs keep, less than one and a half times) takes twice the splits (RTX 5060 Ti, K5: that gate 99.4 -> 84.8
+// us, that down 100.6 -> 84.9)
+// call_groups: the output blocks the call's jobs of this code count together against the target, not the job's own -
+// where an SM keeps three or more, all of them (RTX 3090, K6, a KDA layer's q, k and v, three 4096 x 8192 jobs: 1536
+// blocks 119.6 us, 384 blocks 105.9); at two a SM only jobs of the same shape (RTX 5060 Ti: those q, k and v 191 ->
+// 185 us, a shared expert's gate and up 35.9 -> 35.0; the MLA layer's q_a and kv_a together would lose 8%).  Never the
+// activations: a window's token gets the token path's split
+void mv_split(const Mat& m, int sms, int occ, int& S, int& kr, int call_groups = 0) {
+    const bool many = occ >= 3;
+    const int groups = std::max(m.n / kCols, call_groups);
+    const int kr_min = many ? 128 : 256, target = (many ? 4 : 2) * sms, P = occ * sms;
+    S = (m.k + kMaxKR - 1) / kMaxKR;
+    while (groups * S < target && m.k / (S * 2) >= kr_min) S *= 2;
+    if (!many && groups * S > P && 2 * groups * S < 3 * P && m.k / (S * 2) >= kr_min) S *= 2;
+    kr = ((m.k + S - 1) / S + 127) / 128 * 128;
+    S = (m.k + kr - 1) / kr;
+}
+
+}  // namespace
+
+Mat view(const Mat& m, int c0, int nc) {
+    Mat v = m;
+    v.ld = m.ld > 0 ? m.ld : m.n / 16;
+    v.trellis = m.trellis + (size_t) (c0 / 16) * 4 * m.k2;
+    v.svh = m.svh + c0;
+    v.n = nc;
+    return v;
+}
+
+bool k2_supported(int k2, int cb) {
+    return (k2 >= 2 && k2 <= 16 && (k2 & 1) == 0 && cb >= 0 && cb <= 2) || ((k2 == 3 || k2 == 5 || k2 == 7) && cb == 2);
+}
+
+bool supported(const Mat& m) {
+    return m.trellis != nullptr && m.suh != nullptr && m.svh != nullptr && m.k > 0 && m.n > 0 && m.k % 128 == 0 &&
+           m.n % 128 == 0 && k2_supported(m.k2, m.cb);
+}
+
+void set_skip(const int* flag) { g_skip = flag; }
+
+int mv_splits(const Mat& m) {
+    if (m.fmt == ::mm3::gg::kFmtGG) return 1;   // (a GGUF matrix: a warp a row, every column's sum the same)
+    if (!supported(m)) return 0;
+    int S = 1, kr = 0;
+    mv_split(m, sm_count(), mv_occ(m.k2), S, kr);
+    return S;
+}
+
+int mv_cols(const Mat& m) {
+    if (m.fmt == ::mm3::gg::kFmtGG) return kMaxMvCols;   // (mm3_gguf.cu's mv: up to 16 activations a job)
+    if (!supported(m)) return 0;
+    const int S = mv_splits(m);
+    if (S <= 0) return 0;
+    if (S == 1) return kTok;
+    return (int) std::max<size_t>(1, std::min<size_t>(kTok, kPartFloats / ((size_t) S * m.n)));
+}
+
+unsigned wait_timeouts() {
+    unsigned n = 0;
+    if (cudaMemcpyFromSymbol(&n, g_win_timeouts, sizeof n) != cudaSuccess) {
+        cudaGetLastError();
+        return ::mm3::gg::wait_timeouts();
+    }
+    return n + ::mm3::gg::wait_timeouts();
+}
+
+int launch_errors() {
+    return g_launch_errors.load(std::memory_order_relaxed) + ::mm3::gg::launch_errors();
+}
+
+bool prepare(cudaStream_t s) {
+    EXL3_LEGACY(prepare(s));
+    return scratch(s) != nullptr;
+}
+
+bool several_ok() {
+    EXL3_LEGACY(several_ok());
+    return true;
+}
+
+bool mv(const MvJob* jobs, int n, cudaStream_t s) {
+    EXL3_LEGACY(mv(jobs, n, s));
+    if (n <= 0 || n > kMaxMvJobs) return false;
+    {   // a GGUF's matrices among them: mm3_gguf.cu's GEMVs, the EXL3 ones here
+        MvJob gj[kMaxMvJobs], ej[kMaxMvJobs];
+        int ng = 0, ne = 0;
+        for (int i = 0; i < n; ++i) {
+            if (jobs[i].m != nullptr && jobs[i].m->fmt == ::mm3::gg::kFmtGG) gj[ng++] = jobs[i];
+            else ej[ne++] = jobs[i];
+        }
+        if (ng > 0) return ::mm3::gg::mv(gj, ng, s) && (ne == 0 || mv(ej, ne, s));
+    }
+    Scratch* sc = scratch(s);
+    if (sc == nullptr) return false;
+    const int sms = sm_count();
+    // the launch units: a job's activations in runs of up to kTok (one pass over its weights each)
+    struct Unit {
+        int j, c0, nc;
+    };
+    Unit units[kMaxMvJobs * kMaxMvCols];
+    int nu = 0;
+    const int run = kTok;
+    for (int j = 0; j < n; ++j) {
+        const Mat& m = *jobs[j].m;
+        if (!supported(m) || jobs[j].y == nullptr || (jobs[j].xf == nullptr && jobs[j].xq == nullptr) ||
+            jobs[j].ncol < 1 || jobs[j].ncol > kMaxMvCols) {
+            std::fprintf(stderr, "exl3 mv: job %d unsupported (k %d n %d K %g cb %d, %d activations)\n", j, m.k, m.n,
+                         m.k2 / 2.0, m.cb, jobs[j].ncol);
+            return false;
+        }
+        for (int c0 = 0; c0 < jobs[j].ncol; c0 += run) units[nu++] = {j, c0, std::min(run, jobs[j].ncol - c0)};
+    }
+    // each job's call_groups (mv_split): the output blocks of the call's jobs of its code - of its shape too where an SM
+    // keeps fewer than three
+    int cg[kMaxMvJobs] = {};
+    for (int j = 0; j < n; ++j) {
+        const Mat& a = *jobs[j].m;
+        const bool many = mv_occ(a.k2) >= 3;
+        for (int q = 0; q < n; ++q) {
+            const Mat& b = *jobs[q].m;
+            if (b.k2 == a.k2 && b.cb == a.cb && (many || (b.k == a.k && b.n == a.n))) cg[j] += b.n / kCols;
+        }
+    }
+    bool done[sizeof(units) / sizeof(units[0])] = {};
+    for (int i = 0; i < nu; ++i) {
+        if (done[i]) continue;
+        const Mat& m0 = *jobs[units[i].j].m;
+        // a launch: the units of one (K, codebook), as many as KBatch and the split scratch take (the next launch on
+        // the stream may use the scratch again: this one's last blocks are done with it by then)
+        KBatch b{};
+        int blocks = 0, nb = 0;
+        size_t part_at = 0, cnt_at = 0;
+        for (int u = i; u < nu && nb < kMaxMvJobs; ++u) {
+            const MvJob& job = jobs[units[u].j];
+            const Mat& m = *job.m;
+            if (done[u] || m.k2 != m0.k2 || m.cb != m0.cb) continue;
+            const int c0 = units[u].c0, nc = units[u].nc, groups = m.n / kCols;
+            int S = 1, kr = 0;
+            mv_split(m, sms, mv_occ(m.k2), S, kr, cg[units[u].j]);
+            const size_t need = S > 1 ? (size_t) S * m.n * nc : 0;
+            if (S > 1 && (part_at + need > kPartFloats || cnt_at + (size_t) groups > kCounters)) {
+                if (nb > 0) continue;   // the next launch
+                std::fprintf(stderr, "exl3 mv: scratch too small for k %d n %d (%d activations)\n", m.k, m.n, nc);
+                return false;
+            }
+            done[u] = true;
+            KJob& J = b.j[nb];
+            J.tr = m.trellis;
+            J.suh = m.suh;
+            J.svh = m.svh;
+            J.xf = job.xf != nullptr ? job.xf + c0 * job.xf_cs : nullptr;
+            J.xq = job.xq != nullptr ? (const Q81*) ((const uint8_t*) job.xq + c0 * job.xq_cs) : nullptr;
+            J.y = job.y + c0 * job.y_cs;
+            J.bias = job.bias;
+            J.alpha = job.alpha;
+            J.k = m.k;
+            J.n = m.n;
+            J.ld = m.ld > 0 ? m.ld : m.n / 16;
+            J.S = S;
+            J.kr = kr;
+            J.part = sc->part + part_at;
+            J.cnt = sc->cnt + cnt_at;
+            J.nc = nc;
+            J.xf_cs = job.xf_cs;
+            J.xq_cs = job.xq_cs;
+            J.y_cs = job.y_cs;
+            part_at += need;
+            if (S > 1) cnt_at += (size_t) groups;
+            blocks += groups * S;
+            b.blk_end[nb++] = blocks;
+        }
+        b.n = nb;
+        b.skip = g_skip;
+        if (!dispatch<RunMv>(m0.k2, m0.cb, b, blocks, s)) return false;
+    }
+    launch_check("mv");
+    return true;
+}
+
+static bool moe_args(const MoeArgs& a, KMoe& m, cudaStream_t s) {
+    Scratch* sc = scratch(s);
+    if (sc == nullptr) return false;
+    if (a.k < 1 || a.k > 8 || a.n_embd % kCols != 0 || a.n_ff % kCols != 0 || a.n_embd > kMaxMoeK ||
+        a.n_ff > kMaxMoeK || (size_t) a.k * a.n_ff > kHFloats || (size_t) a.k * a.n_embd > kPartFloats ||
+        (size_t) (a.n_embd / kCols) > kCntGU || kCntGU + (size_t) a.k * (a.n_ff / kCols) > kCounters) {
+        std::fprintf(stderr, "exl3 moe: geometry not covered (k %d n_embd %d n_ff %d)\n", a.k, a.n_embd, a.n_ff);
+        return false;
+    }
+    m = KMoe{};
+    m.plan_ptr = a.plan_ptr;
+    m.plan_w = a.plan_w;
+    m.cpu_part = a.cpu_part;
+    m.cpu_flag = a.cpu_flag;
+    m.h = sc->h;
+    m.u = sc->u;
+    m.part = sc->part;
+    m.cnt = sc->cnt;
+    m.cnt_gu = sc->cnt + kCntGU;
+    for (int r = 0; r < 3; ++r) {
+        m.suh[r] = a.lay.suh[r];
+        m.svh[r] = a.lay.svh[r];
+        m.tr[r] = a.lay.trellis[r];
+    }
+    m.k = a.k;
+    m.n_embd = a.n_embd;
+    m.n_ff = a.n_ff;
+    m.limit = a.limit;
+    m.skip = g_skip;
+    return true;
+}
+
+// a mixed layer's launch: the classes' codebook (one for all of them; mixed_ok checked it), as a template argument
+template <class F>
+static bool mix_launch(const MixedLayouts& mx, F&& f) {
+    switch (mx.lay[0].cb) {
+    case 0: f(std::integral_constant<int, 0>{}); return true;
+    case 1: f(std::integral_constant<int, 1>{}); return true;
+    case 2: f(std::integral_constant<int, 2>{}); return true;
+    default: return false;
+    }
+}
+bool mixed_supported(const ExpertLayout& lay) {
+    if (lay.fmt != 0 || lay.cb < 0 || lay.cb > 2) return false;
+    for (int r = 0; r < 3; ++r)
+        if (lay.k2[r] != 2 && lay.k2[r] != 4 && lay.k2[r] != 6 && lay.k2[r] != 8) return false;
+    return true;
+}
+static bool mixed_ok(const MixedLayouts& mx, const char* what) {
+    bool ok = mx.n >= 1 && mx.n <= kMaxClasses;
+    for (int c = 0; ok && c < mx.n; ++c) ok = mixed_supported(mx.lay[c]) && mx.lay[c].cb == mx.lay[0].cb;
+    if (!ok) {
+        std::fprintf(stderr, "exl3 %s: a mixed layer's classes not covered (K 1-4, one codebook)\n", what);
+        g_launch_errors.fetch_add(1, std::memory_order_relaxed);
+    }
+    return ok;
+}
+
+void moe_gate_up(const MoeArgs& a, const float* x, float* h, cudaStream_t s) {
+    if (a.lay.fmt == ::mm3::gg::kFmtGG) return ::mm3::gg::moe_gate_up(a, x, h, s);
+    if (a.mix.n > 0) {   // (a mixed layer: the same arithmetic on every GPU, no legacy kernels)
+        KMoe m;
+        if (!mixed_ok(a.mix, "moe_gate_up") || !moe_args(a, m, s)) return;
+        m.x = x;
+        if (h != nullptr) m.h = h;
+        const KMix k = kmix(a.mix);
+        mix_launch(a.mix, [&](auto cb) {
+            moe_gate_up_mix_kernel<decltype(cb)::value><<<dim3((unsigned) (a.n_ff / kCols), (unsigned) a.k, 2u), kThreads, 0, s>>>(m, k);
+        });
+        launch_check("moe_gate_up (mixed)");
+        return;
+    }
+    EXL3_LEGACY_MOE(a, moe_gate_up(a, x, h, s));
+    KMoe m;
+    if (!moe_args(a, m, s)) return;
+    if (a.lay.k2[0] != a.lay.k2[1]) {
+        std::fprintf(stderr, "exl3 moe_gate_up: gate K %g != up K %g\n", a.lay.k2[0] / 2.0, a.lay.k2[1] / 2.0);
+        return;
+    }
+    m.x = x;
+    if (h != nullptr) m.h = h;
+    if (!dispatch<RunGU>(a.lay.k2[0], a.lay.cb, m, s))
+        std::fprintf(stderr, "exl3 moe_gate_up: K %g cb %d\n", a.lay.k2[0] / 2.0, a.lay.cb);
+    launch_check("moe_gate_up");
+}
+
+void moe_down(const MoeArgs& a, const float* h, const float* sh_out, float* out, cudaStream_t s) {
+    if (a.lay.fmt == ::mm3::gg::kFmtGG) return ::mm3::gg::moe_down(a, h, sh_out, out, s);
+    if (a.mix.n > 0) {
+        KMoe m;
+        if (!mixed_ok(a.mix, "moe_down") || !moe_args(a, m, s)) return;
+        if (h != nullptr) m.h = const_cast<float*>(h);
+        m.sh_out = sh_out;
+        m.out = out;
+        const KMix k = kmix(a.mix);
+        mix_launch(a.mix, [&](auto cb) {
+            moe_down_mix_kernel<decltype(cb)::value><<<dim3((unsigned) (a.n_embd / kCols), (unsigned) a.k), kThreads, 0, s>>>(m, k);
+        });
+        launch_check("moe_down (mixed)");
+        return;
+    }
+    EXL3_LEGACY_MOE(a, moe_down(a, h, sh_out, out, s));
+    KMoe m;
+    if (!moe_args(a, m, s)) return;
+    if (h != nullptr) m.h = const_cast<float*>(h);
+    m.sh_out = sh_out;
+    m.out = out;
+    if (!dispatch<RunDown>(a.lay.k2[2], a.lay.cb, m, s))
+        std::fprintf(stderr, "exl3 moe_down: K %g cb %d\n", a.lay.k2[2] / 2.0, a.lay.cb);
+    launch_check("moe_down");
+}
+
+bool win_experts(const WinArgs& a, cudaStream_t s) {
+    if (a.lay.fmt == ::mm3::gg::kFmtGG) return ::mm3::gg::win_experts(a, s);
+    if (a.mix.n == 0) EXL3_LEGACY_MOE(a, win_experts(a, s));
+    if (a.mix.n > 0 && !mixed_ok(a.mix, "win_experts")) return false;
+    if (a.T < 1 || a.k < 1 || a.k > 8 || a.n_embd % kCols != 0 || a.n_ff % kCols != 0 || a.n_embd > kMaxMoeK ||
+        a.n_ff > kMaxMoeK || (a.mix.n == 0 && a.lay.k2[0] != a.lay.k2[1]) || a.h == nullptr || a.part == nullptr ||
+        a.out == nullptr) {
+        std::fprintf(stderr, "exl3 win_experts: not covered (T %d k %d n_embd %d n_ff %d, gate K %g up K %g)\n", a.T,
+                     a.k, a.n_embd, a.n_ff, a.lay.k2[0] / 2.0, a.lay.k2[1] / 2.0);
+        return false;
+    }
+    Scratch* sc = scratch(s);
+    if (sc == nullptr) return false;
+    const int groups = a.T * a.k;   // at most (the blocks past the real count return at once)
+    if ((size_t) a.T * 8 * a.n_ff > kUFloats || kCntGU + (size_t) groups * (a.n_ff / kCols) > kCounters) {
+        std::fprintf(stderr, "exl3 win_experts: %d tokens are more than the scratch takes\n", a.T);
+        return false;
+    }
+    KWin w{};
+    w.grp_ptr = a.grp_ptr;
+    w.grp_start = a.grp_start;
+    w.grp_ent = a.grp_ent;
+    w.n_groups = a.n_groups;
+    w.plan_ptr = a.plan_ptr;
+    w.plan_w = a.plan_w;
+    w.cpu_part = a.cpu_part;
+    w.cpu_stride = a.cpu_stride != 0 ? a.cpu_stride : (size_t) a.n_embd;
+    w.cpu_flag = a.cpu_flag;
+    w.x = a.x;
+    w.x_stride = a.x_stride;
+    w.h = a.h;
+    w.u = sc->u;
+    w.cnt_gu = sc->cnt + kCntGU;
+    w.part = a.part;
+    w.sh_out = a.sh_out;
+    w.out = a.out;
+    w.out_stride = a.out_stride;
+    for (int r = 0; r < 3; ++r) {
+        w.suh[r] = a.lay.suh[r];
+        w.svh[r] = a.lay.svh[r];
+        w.tr[r] = a.lay.trellis[r];
+    }
+    w.k = a.k;
+    w.n_embd = a.n_embd;
+    w.n_ff = a.n_ff;
+    w.limit = a.limit;
+    if (a.mix.n > 0) {
+        const KMix k = kmix(a.mix);
+        mix_launch(a.mix, [&](auto cb) {
+            win_gu_mix_kernel<decltype(cb)::value><<<dim3((unsigned) (a.n_ff / kCols), (unsigned) groups, 2u), kThreads, 0, s>>>(w, k);
+            win_down_mix_kernel<decltype(cb)::value><<<dim3((unsigned) (a.n_embd / kCols), (unsigned) groups), kThreads, 0, s>>>(w, k);
+        });
+    } else if (!dispatch<RunWin>(a.lay.k2[0], a.lay.cb, w, groups, s) ||
+               !dispatch<RunWinDown>(a.lay.k2[2], a.lay.cb, w, groups, s)) {
+        return false;
+    }
+    if (a.wait_ptr != nullptr) win_wait_kernel<<<1, 32, 0, s>>>(a.wait_ptr, a.wait_val, win_wait_limit());
+    win_combine_kernel<<<dim3((unsigned) (a.n_embd / kCols), (unsigned) a.T), kCols, 0, s>>>(w);
+    launch_check("win_experts");
+    return true;
+}
+
+// mma_supported() for the current device, cached (the prompt path's launches ask it each time)
+bool mma_now() {
+#if defined(STRATA_USE_HIP)
+    return false;
+#else
+    static int known[64];   // 0: not asked yet, 1: no, 2: yes
+    int dev = 0;
+    cudaGetDevice(&dev);
+    if (dev < 0 || dev >= 64) return mma_supported();
+    if (known[dev] == 0) known[dev] = mma_supported() ? 2 : 1;
+    return known[dev] == 2;
+#endif
+}
+
+// the prompt path on the matrix cores (wmma_set_kernel): an RDNA 3 GPU (gfx11), unless EXL3_WMMA=0 - cached a device
+static bool wmma_now() {
+#if defined(STRATA_USE_HIP)
+    static const bool off = std::getenv("EXL3_WMMA") != nullptr && std::atoi(std::getenv("EXL3_WMMA")) == 0;
+    static int known[64];   // 0: not asked yet, 1: no, 2: yes
+    int dev = 0;
+    cudaGetDevice(&dev);
+    if (off || dev < 0 || dev >= 64) return false;
+    if (known[dev] == 0) {
+        cudaDeviceProp p{};
+        known[dev] = cudaGetDeviceProperties(&p, dev) == cudaSuccess && std::strncmp(p.gcnArchName, "gfx11", 5) == 0
+                         ? 2 : 1;
+    }
+    return known[dev] == 2;
+#else
+    return false;
+#endif
+}
+#if defined(STRATA_USE_HIP)
+// the matrix-core prompt kernels' rows a block: 16 (EXL3_WMMA_ROWS=32: each weight tile decoded once for 32 rows -
+// slower on a Radeon 8065S, 167 against 208 tokens/s on a 4K prompt: twice the shared memory, half the blocks a CU)
+static int wmma_rows() {
+    static const char* v = std::getenv("EXL3_WMMA_ROWS");
+    static const int r = v != nullptr && std::atoi(v) == 32 ? 32 : 16;
+    return r;
+}
+template <class F>
+static void with_rows(F&& f) {   // (f(std::integral_constant<int, wmma_rows()>{}))
+    if (wmma_rows() == 16) f(std::integral_constant<int, 16>{});
+    else f(std::integral_constant<int, 32>{});
+}
+template <int K2, int cb> struct RunWmmaGateUp {
+    static void run(const SetArgs& a, const float* x, int ldx, const int* idx, uint16_t* h, int ldh, cudaStream_t s) {
+        with_rows([&](auto nr) {
+            constexpr int NR = decltype(nr)::value;
+            wmma_set_kernel<K2, cb, true, NR><<<dim3((a.max_rows + NR - 1) / NR, a.n_ff / kCols, a.n_exp), kThreads, 0,
+                                                s>>>(a, x, ldx, idx, h, ldh, nullptr, 0);
+        });
+    }
+};
+template <int K2, int cb> struct RunWmmaDown {
+    static void run(const SetArgs& a, const uint16_t* h, int ldh, float* y, int ldy, cudaStream_t s) {
+        with_rows([&](auto nr) {
+            constexpr int NR = decltype(nr)::value;
+            wmma_set_kernel<K2, cb, false, NR><<<dim3((a.max_rows + NR - 1) / NR, a.n_embd / kCols, a.n_exp), kThreads,
+                                                 0, s>>>(a, nullptr, 0, nullptr, const_cast<uint16_t*>(h), ldh, y, ldy);
+        });
+    }
+};
+#endif
+
+#if !defined(STRATA_USE_HIP)
+// Volta / Turing (cc 7.x): the prompt path's tile kernels on the tensor cores (EXL3_WM70: wmma_set_kernel,
+// wm_rows_kernel) - cached a device; MM3_EXL3_WM70=0: the CUDA cores' portable kernels instead (A/B)
+static bool wm70_now() {
+    static const bool off = ::mm3::env("MM3_EXL3_WM70") != nullptr && std::atoi(::mm3::env("MM3_EXL3_WM70")) == 0;
+    static std::atomic<int> known[64];   // 0: not asked yet, 1: no, 2: yes
+    int dev = 0;
+    cudaGetDevice(&dev);
+    if (off || dev < 0 || dev >= 64) return false;
+    int k = known[dev].load(std::memory_order_acquire);
+    if (k == 0) {
+        int major = 0;
+        cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev);
+        k = major == 7 ? 2 : 1;
+        known[dev].store(k, std::memory_order_release);
+    }
+    return k == 2;
+}
+
+// ---- the FP16 GEMMs (blas_enable): a stream's cuBLAS handle (its default math: the tensor cores) and scratch
+struct BlasCtx {
+    cublasHandle_t h = nullptr;
+    uint16_t* w16 = nullptr;   // a matrix's decoded W' (reconstruct_inner_rows), or a column piece of it
+    size_t w16_n = 0;
+    uint16_t* x16 = nullptr;   // the rotated input rows
+    size_t x16_n = 0;
+    float* f32 = nullptr;      // products before their output rotation (gate, up; a beta != 0 product)
+    size_t f32_n = 0;
+    size_t bytes = 0;
+};
+std::mutex g_blas_mu;
+std::map<std::pair<int, cudaStream_t>, BlasCtx> g_blas;
+BlasCtx* blas_ctx(cudaStream_t s) {
+    int dev = 0;
+    cudaGetDevice(&dev);
+    std::lock_guard<std::mutex> lk(g_blas_mu);
+    auto it = g_blas.find({dev, s});
+    return it == g_blas.end() ? nullptr : &it->second;
+}
+int blas_rows_env() {
+    static const int r = [] {
+        const char* v = ::mm3::env("MM3_EXL3_BLAS_ROWS");
+        return v != nullptr ? std::max(0, std::atoi(v)) : 64;
+    }();
+    return r;
+}
+bool gemm16(BlasCtx& c, int m, int n, int k, const uint16_t* A, int lda, const uint16_t* B, int ldb, float* C, int ldc) {
+    const float one = 1.0f, zero = 0.0f;
+    const cublasStatus_t st = cublasGemmEx(c.h, CUBLAS_OP_T, CUBLAS_OP_N, m, n, k, &one, A, CUDA_R_16F, lda, B,
+                                           CUDA_R_16F, ldb, &zero, C, CUDA_R_32F, ldc, CUBLAS_COMPUTE_32F,
+                                           CUBLAS_GEMM_DEFAULT_TENSOR_OP);
+    if (st != CUBLAS_STATUS_SUCCESS) {
+        std::fprintf(stderr, "exl3: cublasGemmEx status %d\n", (int) st);
+        g_launch_errors.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    return true;
+}
+void launch_rot_f16h(const uint16_t* x, int ldx, int nrows, int ncols, const uint16_t* suh, uint16_t* out,
+                     cudaStream_t s) {
+    const long long warps = (long long) nrows * (ncols / kCols);
+    rows_rot_f16h_kernel<<<(unsigned) ((warps + kWarps - 1) / kWarps), kThreads, 0, s>>>(x, ldx, nrows, ncols, suh, out);
+}
+void launch_rot_acc(const float* t, int ldt, float* y, int ldy, int nrows, int ncols, const uint16_t* svh, float beta,
+                    cudaStream_t s) {
+    const long long warps = (long long) nrows * (ncols / kCols);
+    rows_rot_acc_kernel<<<(unsigned) ((warps + kWarps - 1) / kWarps), kThreads, 0, s>>>(t, ldt, y, ldy, nrows, ncols,
+                                                                                        svh, beta);
+}
+// one EXL3 matrix over FP16 rows through the FP16 GEMM: W' decoded once a column piece, the rows rotated by suh, the
+// product's output rotation by svh (x W = H(H(x * suh) W') * svh), y = beta y + it
+bool blas_rows_mat(BlasCtx& c, const Mat& m, const uint16_t* x16, int ldx, int rows, float* y, int ldy, float beta,
+                   cudaStream_t s) {
+    const int cols = (int) std::min<size_t>((size_t) m.n, c.w16_n / (size_t) m.k / kCols * kCols);
+    if (cols < kCols) return false;
+    const int rp = (int) std::min<size_t>({(size_t) rows, c.x16_n / (size_t) m.k, c.f32_n / (size_t) cols});
+    if (rp <= 0) return false;
+    for (int c0 = 0; c0 < m.n; c0 += cols) {
+        const int nc = std::min(cols, m.n - c0);
+        const Mat v = nc == m.n ? m : view(m, c0, nc);
+        reconstruct_inner_rows(v, c.w16, s);
+        for (int r0 = 0; r0 < rows; r0 += rp) {
+            const int nr = std::min(rp, rows - r0);
+            launch_rot_f16h(x16 + (size_t) r0 * ldx, ldx, nr, m.k, m.suh, c.x16, s);
+            if (beta == 0.0f) {
+                if (!gemm16(c, nc, nr, m.k, c.w16, m.k, c.x16, m.k, y + (size_t) r0 * ldy + c0, ldy)) return false;
+                rows_rot_out(y + (size_t) r0 * ldy + c0, ldy, nr, nc, v.svh, s);
+            } else {
+                if (!gemm16(c, nc, nr, m.k, c.w16, m.k, c.x16, m.k, c.f32, nc)) return false;
+                launch_rot_acc(c.f32, nc, y + (size_t) r0 * ldy + c0, ldy, nr, nc, v.svh, beta, s);
+            }
+        }
+    }
+    launch_check("gemm_rows (FP16 GEMM)");
+    return true;
+}
+Mat expert_mat(const SetArgs& sa, int e, int r) {
+    const uint8_t* blob = sa.wbase + (size_t) e * sa.stride;
+    Mat m;
+    m.trellis = (const uint32_t*) (blob + sa.lay.trellis[r]);
+    m.suh = (const uint16_t*) (blob + sa.lay.suh[r]);
+    m.svh = (const uint16_t*) (blob + sa.lay.svh[r]);
+    m.k = r < 2 ? sa.n_embd : sa.n_ff;
+    m.n = r < 2 ? sa.n_ff : sa.n_embd;
+    m.k2 = sa.lay.k2[r];
+    m.cb = sa.lay.cb;
+    return m;
+}
+// a busy expert's gate / up (its sorted rows [lr0, lr0 + n) of the set, local): h16 rows = FP16 swigluoai
+bool blas_gate_up(BlasCtx& c, const SetArgs& sa, int e, int lr0, int n, const float* x, int ldx, const int* idx,
+                  uint16_t* h16, int ldh, cudaStream_t s) {
+    const int E = sa.n_embd, F = sa.n_ff;
+    if ((size_t) F * E > c.w16_n) return false;
+    const int rp = (int) std::min<size_t>({(size_t) n, c.x16_n / (size_t) E, c.f32_n / (2 * (size_t) F)});
+    if (rp <= 0) return false;
+    const Mat mg = expert_mat(sa, e, 0), mu = expert_mat(sa, e, 1);
+    float* G = c.f32;
+    float* U = c.f32 + (size_t) rp * F;
+    for (int r0 = 0; r0 < n; r0 += rp) {
+        const int nr = std::min(rp, n - r0);
+        for (int r = 0; r < 2; ++r) {   // (gate, then up: W' of one at a time in w16)
+            const Mat& m = r == 0 ? mg : mu;
+            reconstruct_inner_rows(m, c.w16, s);
+            rows_rot_f16(x, ldx, idx + lr0 + r0, nr, E, m.suh, c.x16, s);
+            if (!gemm16(c, F, nr, E, c.w16, E, c.x16, E, r == 0 ? G : U, F)) return false;
+            rows_rot_out(r == 0 ? G : U, F, nr, F, m.svh, s);
+        }
+        const size_t tot = (size_t) nr * F;
+        swiglu_rows_kernel<<<(unsigned) ((tot + 255) / 256), 256, 0, s>>>(G, U, F, nr, F, sa.limit,
+                                                                           h16 + (size_t) (lr0 + r0) * ldh, ldh);
+    }
+    launch_check("set_gate_up (FP16 GEMM)");
+    return true;
+}
+// ... and its down: y rows (local [lr0, lr0 + n)) = down(h16 rows)
+bool blas_down(BlasCtx& c, const SetArgs& sa, int e, int lr0, int n, const uint16_t* h16, int ldh, float* y, int ldy,
+               cudaStream_t s) {
+    const int E = sa.n_embd, F = sa.n_ff;
+    if ((size_t) F * E > c.w16_n) return false;
+    const int rp = (int) std::min<size_t>((size_t) n, c.x16_n / (size_t) F);
+    if (rp <= 0) return false;
+    const Mat md = expert_mat(sa, e, 2);
+    reconstruct_inner_rows(md, c.w16, s);
+    for (int r0 = 0; r0 < n; r0 += rp) {
+        const int nr = std::min(rp, n - r0);
+        launch_rot_f16h(h16 + (size_t) (lr0 + r0) * ldh, ldh, nr, F, md.suh, c.x16, s);
+        float* yr = y + (size_t) (lr0 + r0) * ldy;
+        if (!gemm16(c, E, nr, F, c.w16, F, c.x16, F, yr, ldy)) return false;
+        rows_rot_out(yr, ldy, nr, E, md.svh, s);
+    }
+    launch_check("set_down (FP16 GEMM)");
+    return true;
+}
+#endif
+
+bool mma_supported() {
+#if defined(STRATA_USE_HIP)
+    return false;
+#else
+    int dev = 0, major = 0;
+    cudaGetDevice(&dev);
+    cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev);
+    return major >= 8;
+#endif
+}
+
+void set_gate_up(const SetArgs& sa, const float* x, int ldx, const int* row_idx, uint16_t* h16, int ldh,
+                 cudaStream_t s) {
+    if (sa.lay.fmt == ::mm3::gg::kFmtGG) return ::mm3::gg::set_gate_up(sa, x, ldx, row_idx, h16, ldh, s);
+    if (sa.mix.n > 0) {   // (a mixed layer: every expert's own address and class, the portable kernels everywhere)
+        if (sa.n_exp <= 0 || sa.max_rows <= 0) return;
+        if (sa.eptr == nullptr || !mixed_ok(sa.mix, "set_gate_up")) return;
+        const KMix k = kmix(sa.mix);
+#if defined(STRATA_USE_HIP)
+        if (wmma_now()) {
+            mix_launch(sa.mix, [&](auto cb) {
+                with_rows([&](auto nr) {
+                    constexpr int NR = decltype(nr)::value;
+                    wmma_set_mix_kernel<decltype(cb)::value, true, NR>
+                        <<<dim3((sa.max_rows + NR - 1) / NR, sa.n_ff / kCols, sa.n_exp), kThreads, 0, s>>>(
+                            sa, k, x, ldx, row_idx, h16, ldh, nullptr, 0);
+                });
+            });
+            launch_check("set_gate_up (mixed, matrix cores)");
+            return;
+        }
+#endif
+        mix_launch(sa.mix, [&](auto cb) {
+            set_mix_kernel<decltype(cb)::value, true>
+                <<<dim3((sa.max_rows + kTok - 1) / kTok, sa.n_ff / kCols, sa.n_exp), kThreads, 0, s>>>(
+                    sa, k, x, ldx, row_idx, h16, ldh, nullptr, 0);
+        });
+        launch_check("set_gate_up (mixed)");
+        return;
+    }
+#if !defined(STRATA_USE_HIP)
+    if (!mma_now()) {   // (before sm_80: Volta / Turing's tensor cores, else the portable kernels)
+        if (sa.n_exp <= 0 || sa.max_rows <= 0) return;
+        SetArgs sb = sa;
+        if (BlasCtx* bc = sa.hbounds != nullptr && blas_rows_env() > 0 ? blas_ctx(s) : nullptr) {
+            // the busy experts (blas_rows_env rows or more) through the FP16 GEMM, the rest through the tiles
+            const int R = blas_rows_env();
+            bool busy = false;
+            for (int e = 0; e < sa.n_exp; ++e) {
+                const int n = sa.hbounds[e + 1] - sa.hbounds[e];
+                if (n < R) continue;
+                if (!blas_gate_up(*bc, sa, e, sa.hbounds[e] - sa.row0, n, x, ldx, row_idx, h16, ldh, s)) {
+                    std::fprintf(stderr, "exl3 set_gate_up: the FP16 GEMM's scratch is too small\n");
+                    g_launch_errors.fetch_add(1, std::memory_order_relaxed);
+                    return;
+                }
+                busy = true;
+            }
+            if (busy) sb.skip_ge = R;
+        }
+        if (sa.lay.k2[0] == sa.lay.k2[1] && wm70_now() &&
+            dispatch<RunWm70GateUp>(sa.lay.k2[0], sa.lay.cb, sb, x, ldx, row_idx, h16, ldh, s)) {
+            launch_check("set_gate_up (tensor cores, sm_7x)");
+            return;
+        }
+        if (sa.lay.k2[0] != sa.lay.k2[1] || !dispatch<RunHipGateUp>(sa.lay.k2[0], sa.lay.cb, sb, x, ldx, row_idx, h16, ldh, s)) {
+            std::fprintf(stderr, "exl3 set_gate_up: unsupported layout\n");
+            g_launch_errors.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        launch_check("set_gate_up (portable)");
+        return;
+    }
+    if (sa.lay.k2[0] != sa.lay.k2[1]) {
+        std::fprintf(stderr, "exl3 set_gate_up: gate K %g != up K %g\n", sa.lay.k2[0] / 2.0, sa.lay.k2[1] / 2.0);
+        g_launch_errors.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    if (sa.n_exp <= 0 || sa.max_rows <= 0) return;
+    tc::GArgs a{};
+    a.wbase = sa.wbase;
+    a.stride = sa.stride;
+    for (int r = 0; r < 2; ++r) {
+        a.tr[r] = sa.lay.trellis[r];
+        a.suh[r] = sa.lay.suh[r];
+        a.svh[r] = sa.lay.svh[r];
+        a.ld[r] = sa.n_ff / 16;
+    }
+    a.bounds = sa.bounds;
+    a.row0 = sa.row0;
+    a.k = sa.n_embd;
+    a.n = sa.n_ff;
+    a.xf = x;
+    a.idx = row_idx;
+    a.ldx = ldx;
+    a.h = (__half*) h16;
+    a.ldh = ldh;
+    a.limit = sa.limit;
+    const dim3 grid((unsigned) ((sa.max_rows + tc::BM - 1) / tc::BM), (unsigned) (sa.n_ff / kCols), (unsigned) sa.n_exp);
+    if (!dispatch<RunGateUp>(sa.lay.k2[0], sa.lay.cb, a, grid, s))
+        std::fprintf(stderr, "exl3 set_gate_up: K %g cb %d\n", sa.lay.k2[0] / 2.0, sa.lay.cb);
+    launch_check("set_gate_up");
+#else
+    if (sa.n_exp <= 0 || sa.max_rows <= 0) return;
+    if (wmma_now() && sa.lay.k2[0] == sa.lay.k2[1] &&
+        dispatch<RunWmmaGateUp>(sa.lay.k2[0], sa.lay.cb, sa, x, ldx, row_idx, h16, ldh, s)) {
+        launch_check("HIP set_gate_up (matrix cores)");
+        return;
+    }
+    if (sa.lay.k2[0] != sa.lay.k2[1] || !dispatch<RunHipGateUp>(sa.lay.k2[0], sa.lay.cb, sa, x, ldx, row_idx, h16, ldh, s)) {
+        std::fprintf(stderr, "exl3 HIP set_gate_up: unsupported layout\n");
+        g_launch_errors.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    launch_check("HIP set_gate_up");
+#endif
+}
