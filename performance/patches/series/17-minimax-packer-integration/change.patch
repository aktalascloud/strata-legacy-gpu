@@ -0,0 +1,182 @@
+"""Bounded metadata readers for the MiniMax pack; no NumPy, weight copies or tensor reads."""
+from __future__ import annotations
+import importlib.util
+from contextlib import contextmanager
+import json
+import math
+from pathlib import Path
+import struct
+import sys
+import os
+import tempfile
+
+_spec = importlib.util.spec_from_file_location('_minimax_gguf_reader', Path(__file__).resolve().parents[1] / 'gguf_reader.py')
+_reader = importlib.util.module_from_spec(_spec)
+sys.modules[_spec.name] = _reader
+_spec.loader.exec_module(_reader)
+
+_SUPPORTED = (0, 1, 8, 10, 11, 12, 13, 14, 16, 17, 18, 19, 20, 21, 22, 23, 29, 30)
+TYPES = {t: (_reader.GGML_TYPES[t], *_reader.BLOCK_GEOMETRY[_reader.GGML_TYPES[t]]) for t in _SUPPORTED}
+DTYPE_BYTES = {'F32': 4, 'F16': 2, 'BF16': 2, 'I32': 4, 'I16': 2, 'F8_E4M3': 1, 'F8_E8M0': 1, 'U8': 1, 'I8': 1, 'I64': 8}
+
+
+def unique_object(pairs):
+    out = {}
+    for key, value in pairs:
+        if key in out:
+            raise ValueError('duplicate JSON metadata key')
+        out[key] = value
+    return out
+
+
+@contextmanager
+def output_directory(destination):
+    destination = checked_path(destination)
+    if destination.exists():
+        raise ValueError('pack output already exists')
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix='.minimax-prepare-', dir=destination.parent) as temporary:
+        staging = Path(temporary)
+        if staging.resolve().parent != destination.parent.resolve():
+            raise ValueError('temporary pack left the selected output parent')
+        yield staging
+        if destination.exists():
+            raise ValueError('pack output appeared during preparation')
+        os.rename(staging, destination)
+
+
+def checked_path(path):
+    path = Path(path).expanduser()
+    text = str(path).replace('\\', '/')
+    if (text.startswith('//') or '..' in path.parts or path.drive and not path.is_absolute()
+            or any(ord(c) < 32 for c in text) or any(':' in p for p in path.parts if p != path.anchor)):
+        raise ValueError('UNC, ADS, traversal or control characters in model path')
+    return path.resolve()
+
+
+class _Header(_reader.GGUFFile):
+    def _read(self, stream, n):
+        if self._pos + n > 32 * 1024 * 1024:
+            raise ValueError('GGUF header exceeds32MiB')
+        return super()._read(stream, n)
+
+
+class Gguf:
+    def __init__(self, path):
+        self.path = Path(path)
+        g = _Header(self.path)
+        self.kv, self.data_start = g.metadata, g.data_start
+        self.alignment = g.alignment
+        self.tensors = [(t.name, t.type_id, t.shape, t.offset) for t in g.tensors]
+
+
+def short(g):
+    need = g.data_start
+    for name, typ, dims, off in g.tensors:
+        if type(off) is not int or off < 0 or off % getattr(g, 'alignment', 32):
+            return name + ': invalid tensor offset/alignment'
+        if typ not in TYPES:
+            return name + ': unsupported MiniMax GGUF type ' + str(typ)
+        _, block, size = TYPES[typ]
+        if not dims or any(type(d) is not int or d <= 0 for d in dims) or dims[0] % block:
+            return name + ': invalid dimensions/block alignment'
+        need = max(need, g.data_start + off + math.prod(dims) // block * size)
+    have = g.path.stat().st_size
+    return None if have >= need else f'{g.path.name}: {have} of {need} bytes'
+
+
+def relative_file(root, path):
+    root, path = checked_path(root), checked_path(path)
+    try:
+        relative = path.relative_to(root)
+    except ValueError:
+        raise ValueError('model file leaves the explicitly selected model root') from None
+    text = relative.as_posix()
+    if not text or text == '.' or any(c.isspace() or ord(c) < 32 for c in text) or ':' in text:
+        raise ValueError('model file name cannot be represented safely in the native pack')
+    return text
+
+
+def contained_file(root, name):
+    name = Path(name)
+    if name.is_absolute() or '..' in name.parts or ':' in str(name):
+        raise ValueError('absolute, ADS or traversing file name in model metadata')
+    path = Path(root) / name
+    relative_file(root, path)
+    return path.resolve()
+
+
+def safetensor_header(path):
+    path = Path(path)
+    size = path.stat().st_size
+    with path.open('rb') as f:
+        prefix = f.read(8)
+        if len(prefix) != 8:
+            raise ValueError('incomplete safetensors header length')
+        n = struct.unpack('<Q', prefix)[0]
+        if n > 16 * 1024 * 1024 or 8 + n > size:
+            raise ValueError('safetensors header outside file/budget')
+        header = json.loads(f.read(n), object_pairs_hook=unique_object)
+    if not isinstance(header, dict):
+        raise ValueError('safetensors header must be an object')
+    result = []
+    ranges = []
+    for name, item in header.items():
+        if name == '__metadata__':
+            continue
+        if not name or any(c.isspace() or ord(c) < 32 for c in name):
+            raise ValueError('tensor name cannot be represented in native pack')
+        if not isinstance(item, dict):
+            raise ValueError('safetensors tensor description must be an object')
+        dtype, shape, bounds = item.get('dtype'), item.get('shape'), item.get('data_offsets')
+        if (not isinstance(dtype, str) or dtype not in DTYPE_BYTES or not isinstance(shape, list) or
+                any(type(d) is not int or d < 0 for d in shape) or
+                not isinstance(bounds, list) or len(bounds) != 2 or any(type(x) is not int for x in bounds)):
+            raise ValueError('invalid safetensors tensor description')
+        a, b = bounds
+        if not 0 <= a <= b <= size - 8 - n or b - a != math.prod(shape) * DTYPE_BYTES[dtype]:
+            raise ValueError('safetensors tensor range or byte count is invalid')
+        result.append((name, dtype, tuple(shape), 8 + n + a, b - a))
+        if b > a:
+            ranges.append((a, b))
+    ranges.sort()
+    if any(left[1] > right[0] for left, right in zip(ranges, ranges[1:])):
+        raise ValueError('overlapping safetensors tensor ranges')
+    return result
+
+
+class SafeTensors:
+    """Only index-declared files, every indexed name present in its declared file."""
+    def __init__(self, directory):
+        self.dir = Path(directory)
+        index = json.loads((self.dir / 'model.safetensors.index.json').read_text('utf-8'), object_pairs_hook=unique_object)['weight_map']
+        if not isinstance(index, dict) or not index or not all(isinstance(k, str) and isinstance(v, str) for k, v in index.items()):
+            raise ValueError('invalid safetensors weight map')
+        self.files = sorted(set(index.values()))
+        self.t = {}
+        for name in self.files:
+            path = contained_file(self.dir, name)
+            for tensor, dtype, shape, off, n in safetensor_header(path):
+                if index.get(tensor) != name:
+                    raise ValueError('safetensors header/index mismatch')
+                if tensor in self.t:
+                    raise ValueError('duplicate safetensors tensor name')
+                self.t[tensor] = (name, dtype, shape, off, n)
+        if set(self.t) != set(index):
+            raise ValueError('incomplete safetensors index')
+
+
+def flat(stream, prefix, data):
+    for key, value in data.items():
+        if not isinstance(key, str) or not key or any(c.isspace() or ord(c) < 32 for c in key):
+            raise ValueError('invalid pack geometry key')
+        if isinstance(value, bool):
+            value = int(value)
+        if isinstance(value, (int, float)):
+            if not math.isfinite(value):
+                raise ValueError('nonfinite pack geometry')
+            stream.write(f'{prefix}{key} {value}\n')
+        elif isinstance(value, list) and value and all(isinstance(x, (int, float)) for x in value):
+            if not all(math.isfinite(x) for x in value):
+                raise ValueError('nonfinite pack geometry list')
+            stream.write(f'{prefix}{key} ' + ','.join(str(int(x) if isinstance(x, bool) else x) for x in value) + '\n')
