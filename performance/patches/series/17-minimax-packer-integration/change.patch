+import tempfile
+import hashlib
+import json
+import struct
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+from tools.minimax import validate_pack as v
+
+
+class PackLayoutValidation(unittest.TestCase):
+    def test_complete_receipt_flow_then_sealed_wrong_offset_is_rejected(self):
+        root=Path(__file__).resolve().parents[2]
+        with tempfile.TemporaryDirectory(prefix='layout-flow-',dir=root) as directory:
+            project=Path(directory);weights=project/'weights';weights.mkdir();pack=project/'pack';pack.mkdir()
+            tok=pack/'tokenizer';tok.mkdir()
+            native=[];raw=[]
+            names=[(name,native) for name,native in v.p.GLOBAL.items()]
+            names += [(f'blk.{l}.{role}',v.p.P+f'layers.{l}.'+v.p.LAYER[role]) for l in range(60) for role in v.p.INDEXER]
+            for i,(name,mapped) in enumerate(names):
+                raw.append((name,0,[1],i*32));native.append(f't {mapped} F32 0 {i*32} 4 1')
+            model=weights/'main.gguf';model.write_bytes(bytes(len(names)*32))
+            # Only the GGUF header object is mocked. Safetensors, receipt, native text and sealing are real tiny files.
+            name='language_model.model.dspark.fc.weight';header=json.dumps({name:{'dtype':'BF16','shape':[1],'data_offsets':[0,2]}}).encode()
+            draft=weights/'draft.safetensors';draft.write_bytes(struct.pack('<Q',len(header))+header+b'\0\0')
+            index=weights/'model.safetensors.index.json';index.write_text(json.dumps({'weight_map':{name:draft.name}}))
+            native.append(f't dspark.{name} BF16 1 {8+len(header)} 2 1')
+            tensor_file=pack/'tensors.txt';tensor_file.write_text('file 0 main.gguf\nfile 1 draft.safetensors\n'+'\n'.join(native)+'\n')
+            tokens=['a','b',']~b]','[e~[','<mm:think>','</mm:think>',']<]minimax[>[']
+            (pack/'mm3.txt').write_text(f'format gguf\nmodel_dir {weights}\nhidden_size 4\nnum_hidden_layers 60\nvocab_size {len(tokens)}\ngguf.identity_expert_scales 0\n')
+            kv={'general.architecture':'minimax-m3','minimax-m3.block_count':60,'minimax-m3.embedding_length':4,
+                'tokenizer.ggml.tokens':tokens,'tokenizer.ggml.token_type':[1,1,3,3,3,3,3],
+                'tokenizer.ggml.model':'gpt2','tokenizer.ggml.pre':'minimax-m2',
+                'tokenizer.ggml.bos_token_id':2,'tokenizer.ggml.eos_token_id':3}
+            v.p.write_tokenizer(tok,kv)
+            g=SimpleNamespace(path=model,data_start=0,alignment=32,tensors=raw,kv=kv)
+            receipt=project/'receipt.json'
+            def seal():
+                data={'status':'pack_prepared_native_qualification_pending','output':'pack',
+                    'verified_inputs':{str(p):{'size':p.stat().st_size,'mtime_ns':p.stat().st_mtime_ns} for p in (model,draft,index)},
+                    'files':{str(p.relative_to(pack)):{'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in pack.rglob('*') if p.is_file()}}
+                receipt.write_text(json.dumps(data))
+            seal()
+            with patch.object(v.m,'Gguf',return_value=g):
+                result=v.verify(project,pack,weights,receipt)
+                self.assertTrue(result['layout_only']);self.assertFalse(result['model_GPU_qualified'])
+                vocab=tok/'vocab.json';valid=vocab.read_text()
+                for invalid in (tokens,dict(zip(tokens,[1,0,2,3,4,5,6])),dict(zip(tokens,[0,True,2,3,4,5,6]))):
+                    vocab.write_text(json.dumps(invalid));seal()
+                    with self.assertRaisesRegex(ValueError,'Tokenizer vocabulary'):v.verify(project,pack,weights,receipt)
+                vocab.write_text(valid);seal()
+                tensor_file.write_text(tensor_file.read_text().replace(' F32 0 0 4 1',' F32 0 1 4 1',1));seal()
+                with self.assertRaisesRegex(ValueError,'offset'):v.verify(project,pack,weights,receipt)
+
+    def test_native_roles_resolve_to_exact_source_names(self):
+        self.assertEqual(v.origin('language_model.lm_head.weight'),('output.weight',None))
+        self.assertEqual(v.origin('language_model.model.layers.59.block_sparse_moe.experts.127.w2.weight'),
+                         ('blk.59.ffn_down_exps.weight',127))
+        self.assertEqual(v.origin('language_model.model.layers.0.self_attn.index_q_proj.weight'),
+                         ('blk.0.indexer.q_proj.weight',None))
+        self.assertEqual(v.origin('dspark.language_model.model.dspark.fc.weight'),
+                         ('language_model.model.dspark.fc.weight',None))
+        with self.assertRaises(ValueError):v.origin('language_model.model.layers.0.invented.weight')
+        with self.assertRaises(ValueError):v.origin('language_model.model.layers.3.block_sparse_moe.experts.w1')
+
+    def test_offsets_dtype_shape_and_expert_partition_are_bound_to_header(self):
+        raw=('F32',64,128,(2,4,4));value=('F32',0,128,64,(4,4))
+        v.check_tensor(value,raw,1)
+        for bad in [('BF16',0,128,64,(4,4)),('F32',0,129,64,(4,4)),
+                    ('F32',0,128,63,(4,4)),('F32',0,128,64,(16,))]:
+            with self.assertRaises(ValueError):v.check_tensor(bad,raw,1)
+        with self.assertRaises(ValueError):v.check_tensor(value,raw,2)
+        with self.assertRaises(ValueError):v.check_tensor(value,raw,-1)
+        with self.assertRaises(ValueError):v.check_tensor(('F32',0,72,8,(2,)),('F32',64,16,(2,2)),1)
+        v.check_tensor(('F32',0,64,16,(2,2)),('F32',64,16,(2,2)),None)
+
+    def test_duplicate_geometry_files_and_tensor_names_are_rejected(self):
+        root=Path(__file__).resolve().parents[2]
+        with tempfile.TemporaryDirectory(prefix='pack-validation-',dir=root) as directory:
+            p=Path(directory);(p/'mm3.txt').write_text('format gguf\nmodel_dir weights\n')
+            line='t language_model.lm_head.weight F32 0 64 16 2 2\n'
+            (p/'tensors.txt').write_text('file 0 a.gguf\n'+line)
+            self.assertEqual(len(v.parse(p)[2]),1)
+            for text in ('file 0 a.gguf\nfile 0 b.gguf\n'+line,'file 1 a.gguf\n'+line,'file 0 a.gguf\n'+line+line):
+                (p/'tensors.txt').write_text(text)
+                with self.assertRaises(ValueError):v.parse(p)
+            (p/'mm3.txt').write_text('format gguf\nformat gguf\n')
+            with self.assertRaises(ValueError):v.parse(p)
+
+
+if __name__=='__main__':unittest.main()
