+"""Metadata/safety delta only; tiny fixtures are not real-model qualification."""
+import io
+import json
+from pathlib import Path
+import struct
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+from tools.minimax import metadata as m
+from tools.minimax import pack_gguf as p
+from tools.strata_tokenizer import BYTE_TO_UNICODE, Tokenizer
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def st(path, header, payload=b'12345678'):
+    raw = json.dumps(header).encode()
+    raw += b' ' * (-len(raw) % 8)
+    path.write_bytes(struct.pack('<Q', len(raw)) + raw + payload)
+
+
+class MiniMaxPack(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='.minimax-test-', dir=ROOT)
+        self.root = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_bounded_safetensors_and_exact_index(self):
+        st(self.root / 'a.safetensors', {'a': {'dtype': 'F32', 'shape': [2], 'data_offsets': [0, 8]}})
+        (self.root / 'model.safetensors.index.json').write_text(json.dumps({'weight_map': {'a': 'a.safetensors'}}))
+        result = m.SafeTensors(self.root)
+        self.assertEqual(result.files, ['a.safetensors'])
+        self.assertEqual(result.t['a'][1:3], ('F32', (2,)))
+        self.assertEqual(result.t['a'][4], 8)
+        (self.root / 'model.safetensors.index.json').write_text(json.dumps({'weight_map': {'missing': 'a.safetensors'}}))
+        with self.assertRaises(ValueError):m.SafeTensors(self.root)
+
+    def test_invalid_offsets_dtype_and_duplicate_keys(self):
+        for item in ({'dtype': 'F32', 'shape': [2], 'data_offsets': [0, 9]},
+                     {'dtype': 'F32', 'shape': [2], 'data_offsets': [18446744073709551612, 18446744073709551620]},
+                     {'dtype': ['F32'], 'shape': [2], 'data_offsets': [0, 8]}):
+            st(self.root / 'bad.safetensors', {'a': item})
+            with self.assertRaises(ValueError):m.safetensor_header(self.root / 'bad.safetensors')
+        with self.assertRaises(ValueError):json.loads('{"a":1,"a":2}', object_pairs_hook=m.unique_object)
+
+    def test_traversal_ads_and_external_file_are_rejected(self):
+        for name in ('../outside.safetensors', 'a:stream', '/absolute'):
+            with self.assertRaises(ValueError):m.contained_file(self.root, name)
+        with self.assertRaises(ValueError):m.relative_file(self.root, self.root.parent / 'outside')
+        self.assertEqual(m.relative_file(self.root, self.root / 'inside.gguf'), 'inside.gguf')
+
+    def test_tensor_size_and_alignment(self):
+        path = self.root / 'data.gguf';path.write_bytes(b'0' * 40)
+        g = SimpleNamespace(path=path, data_start=32, tensors=[('x', 0, [2], 0)])
+        self.assertIsNone(m.short(g))
+        path.write_bytes(b'0' * 39)
+        self.assertIn('39 of 40', m.short(g))
+        g.tensors = [('x', 0, [1], 1)]
+        self.assertIn('alignment', m.short(g))
+
+    def test_only_exact_identity_expert_scales_can_be_omitted(self):
+        path = self.root / 'scales.bin';path.write_bytes(struct.pack('<2f', 1, 1))
+        g = SimpleNamespace(path=path, data_start=0)
+        self.assertEqual(p.identity_expert_scale(g, 0, [2], 0, 2), 8)
+        path.write_bytes(struct.pack('<2f', 1, 0.999999))
+        with self.assertRaises(ValueError):p.identity_expert_scale(g, 0, [2], 0, 2)
+        path.write_bytes(b'1234')
+        with self.assertRaises(ValueError):p.identity_expert_scale(g, 0, [2], 0, 2)
+
+    def test_output_transaction_and_existing_pack(self):
+        target = self.root / 'pack'
+        with self.assertRaises(RuntimeError):
+            with m.output_directory(target) as staged:
+                (staged / 'mm3.txt').write_text('partial')
+                raise RuntimeError('fixture failure')
+        self.assertFalse(target.exists())
+        with m.output_directory(target) as staged:(staged / 'mm3.txt').write_text('complete')
+        self.assertEqual((target / 'mm3.txt').read_text(), 'complete')
+        with self.assertRaises(ValueError):
+            with m.output_directory(target):pass
+        self.assertEqual((target / 'mm3.txt').read_text(), 'complete')
+
+    def test_canonical_minimax_tokenizer_export(self):
+        tokens = [BYTE_TO_UNICODE[i] for i in range(256)] + [']~b]', '[e~[', '<mm:think>', '</mm:think>', ']<]minimax[>[']
+        kv = {'general.architecture': 'minimax-m3', 'tokenizer.ggml.model': 'gpt2', 'tokenizer.ggml.pre': 'minimax-m2',
+              'tokenizer.ggml.tokens': tokens, 'tokenizer.ggml.token_type': [1] * 256 + [3] * 5,
+              'tokenizer.ggml.bos_token_id': 256, 'tokenizer.ggml.eos_token_id': 257}
+        out = self.root / 'tok';p.write_tokenizer(out, kv)
+        self.assertEqual(json.loads((out / 'tokenizer.json').read_text())['pre'], 'minimax')
+        tok = Tokenizer.from_dir(out)
+        self.assertEqual(tok.decode(tok.encode('e\u0301')), 'é')
+        self.assertEqual(tok.encode(']~b]', parse_special=True), [256])
+        kv['tokenizer.ggml.bos_token_id'] = 1
+        with self.assertRaises(SystemExit):p.write_tokenizer(self.root / 'bad-tok', kv)
+        self.assertFalse((self.root / 'bad-tok').exists())
+
+    def test_partial_and_missing_shards_leave_no_output(self):
+        out = self.root / 'pack'
+        (self.root / 'a.gguf.part').write_bytes(b'GGUF')
+        with patch.object(sys, 'argv', ['pack', '--model', str(self.root), '--out', str(out), '--shards', 'a.gguf.part']):
+            with self.assertRaises(SystemExit):p.main()
+        self.assertFalse(out.exists())
+        with patch.object(sys, 'argv', ['pack', '--model', str(self.root), '--out', str(out), '--shards', 'missing.gguf']):
+            with self.assertRaises(SystemExit):p.main()
+        self.assertFalse(out.exists())
+
+    def test_geometry_rejects_nonfinite_and_line_injection(self):
+        for data in ({'x': float('nan')}, {'x\nmodel_dir': 1}, {'x': [1, float('inf')]}):
+            with self.assertRaises(ValueError):m.flat(io.StringIO(), '', data)
+
+    def test_draft_target_geometry_is_bound(self):
+        geo = {'hidden_size': 6144, 'vocab_size': 200064, 'num_hidden_layers': 60}
+        cfg = {'hidden_size': 6144, 'vocab_size': 200064, 'num_hidden_layers': 5,
+               'dflash_config': {'num_target_layers': 60, 'target_layer_ids': [3, 17, 31, 45, 59]}}
+        p.validate_draft(geo, cfg)
+        for change in ({'hidden_size': 4096}, {'vocab_size': 200061},
+                       {'dflash_config': {'num_target_layers': 60, 'target_layer_ids': [60]}}):
+            with self.assertRaises(ValueError):p.validate_draft(geo, {**cfg, **change})
+
+    def test_split_indexes_and_shared_metadata(self):
+        base = {'general.architecture': 'minimax-m3', 'general.name': 'fixture', 'split.count': 2,
+                'split.no': 0, 'split.tensors.count': 2, 'minimax-m3.rope.freq_base': 1e7}
+        first = SimpleNamespace(kv=base, tensors=[1])
+        second = SimpleNamespace(kv={**base, 'split.no': 1}, tensors=[2])
+        p.validate_shards([first, second], base)
+        for change in ({'split.no': 0}, {'minimax-m3.rope.freq_base': 1e6}, {'split.tensors.count': 3}):
+            with self.assertRaises(ValueError):
+                p.validate_shards([first, SimpleNamespace(kv={**second.kv, **change}, tensors=[2])], base)
+
+
+if __name__ == '__main__':unittest.main()
