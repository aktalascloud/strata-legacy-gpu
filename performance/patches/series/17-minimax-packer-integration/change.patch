@@ -0,0 +1,151 @@
+"""Read-only MiniMax pack/header correspondence; producer SHA receipts replace duplicate weight hashing."""
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import re
+import sys
+
+HERE=Path(__file__).resolve().parent
+spec=importlib.util.spec_from_file_location('_mm3_pack_tables',HERE/'pack_gguf.py')
+p=importlib.util.module_from_spec(spec);spec.loader.exec_module(p)
+m=p.metadata
+sha=lambda path:hashlib.sha256(path.read_bytes()).hexdigest()
+
+def lines(path):
+    if path.stat().st_size>16<<20:raise ValueError('Pack metadata exceeds16MiB')
+    return path.read_text('utf-8').splitlines()
+
+def parse(pack):
+    geo={}
+    for line in lines(pack/'mm3.txt'):
+        key,sep,value=line.partition(' ')
+        if not sep or not re.fullmatch(r'[A-Za-z0-9_.]+',key) or key in geo:raise ValueError('Invalid/duplicate geometry key')
+        geo[key]=value
+    files={};tensors={}
+    for line in lines(pack/'tensors.txt'):
+        a=line.split()
+        if len(a)==3 and a[0]=='file':
+            i=int(a[1])
+            if i<0 or i in files:raise ValueError('Invalid/duplicate file index')
+            files[i]=a[2]
+        elif len(a)>=6 and a[0]=='t':
+            name,dtype,fi,off,nb=a[1:6];dims=tuple(map(int,a[6:]))
+            if name in tensors or any(x<=0 for x in dims):raise ValueError('Duplicate tensor or invalid shape')
+            fi,off,nb=map(int,(fi,off,nb))
+            if fi<0 or off<0 or nb<=0:raise ValueError('Invalid tensor extent')
+            tensors[name]=(dtype,fi,off,nb,dims)
+        else:raise ValueError('Invalid native pack line')
+    if set(files)!=set(range(len(files))) or not tensors:raise ValueError('Noncontiguous files or empty pack')
+    return geo,files,tensors
+
+def origin(name):
+    if name.startswith('dspark.'):return name[len('dspark.'):],None
+    reverse={v:k for k,v in p.GLOBAL.items()}
+    if name in reverse:return reverse[name],None
+    match=re.fullmatch(re.escape(p.P)+r'layers\.(\d+)\.(.+)',name)
+    if not match:raise ValueError('Unmapped native name: '+name)
+    layer,role=match.groups()
+    expert=re.fullmatch(r'block_sparse_moe\.experts\.(\d+)\.(w[123])\.weight',role)
+    if expert:
+        eid,which=expert.groups();raw={'w1':'gate','w2':'down','w3':'up'}[which]
+        return f'blk.{layer}.ffn_{raw}_exps.weight',int(eid)
+    reverse={v:k for k,v in p.LAYER.items()}
+    if role not in reverse or reverse[role].endswith('_exps.weight'):raise ValueError('Unmapped native layer role')
+    return f'blk.{layer}.'+reverse[role],None
+
+def check_tensor(value,raw,expert):
+    dtype,fi,offset,nbytes,shape=value
+    rdtype,begin,size,rshape=raw
+    expected_shape=tuple(rshape)
+    if expert is not None:
+        if len(rshape)!=3 or not 0<=expert<rshape[0] or size%rshape[0]:raise ValueError('Expert index/partition invalid')
+        size//=rshape[0];begin+=expert*size;expected_shape=tuple(rshape[1:])
+    if (dtype,offset,nbytes,shape)!=(rdtype,begin,size,expected_shape):
+        raise ValueError('Tensor dtype/offset/bytes/shape differs from source header')
+
+def verify(project,pack,model_root,receipt):
+    project=m.checked_path(project);pack=m.checked_path(pack);model_root=m.checked_path(model_root)
+    for path in (pack,model_root,receipt):m.relative_file(project,path)
+    proof=json.loads(receipt.read_text('utf-8'))
+    if proof.get('status')!='pack_prepared_native_qualification_pending':raise ValueError('No completed producer/pack receipt')
+    if m.checked_path(project/proof['output'])!=pack:raise ValueError('Pack receipt names another output')
+    actual={str(x.relative_to(pack)) for x in pack.rglob('*') if x.is_file()}
+    if actual!=set(proof['files']):raise ValueError('Pack inventory changed')
+    for rel,item in proof['files'].items():
+        path=m.contained_file(pack,rel)
+        if path.stat().st_size!=item['bytes'] or sha(path)!=item['sha256']:raise ValueError('Prepared metadata bytes changed')
+    for name,item in proof['verified_inputs'].items():
+        path=Path(name);m.relative_file(model_root,path);s=path.stat()
+        if (s.st_size,s.st_mtime_ns)!=(item['size'],item['mtime_ns']):raise ValueError('Verified model input changed')
+    geo,files,tensors=parse(pack)
+    if geo.get('format')!='gguf' or m.checked_path(geo.get('model_dir',''))!=model_root:raise ValueError('Wrong format/model root')
+    paths={i:m.contained_file(model_root,name) for i,name in files.items()}
+    if len(set(paths.values()))!=len(paths):raise ValueError('Duplicate weight file path')
+    expected={Path(x) for x in proof['verified_inputs'] if Path(x).suffix in ('.gguf','.safetensors')}
+    if set(paths.values())!=expected:raise ValueError('Pack data file set differs from pinned inputs')
+    catalogs={};source_keys=set();scales=0;kv=None
+    for i,path in paths.items():
+        cat={}
+        if path.suffix=='.gguf':
+            g=m.Gguf(path)
+            if m.short(g):raise ValueError('Incomplete GGUF')
+            if kv is None and 'general.architecture' in g.kv:kv=g.kv
+            for name,typ,dims,off in g.tensors:
+                if re.fullmatch(r'blk\.\d+\.ffn_(gate|up|down)_exps\.scale',name):scales+=1;continue
+                if name in cat:raise ValueError('Duplicate source tensor')
+                dtype,per,bpb=m.TYPES[typ]
+                cat[name]=(dtype,g.data_start+off,math.prod(dims)//per*bpb,tuple(reversed(dims)))
+        elif path.suffix=='.safetensors':
+            st=m.SafeTensors(path.parent)
+            for name,(file,dtype,shape,off,nb) in st.t.items():
+                if file==path.name:cat[name]=(dtype,off,nb,tuple(shape))
+        else:raise ValueError('Unexpected weight file type')
+        catalogs[i]=cat;source_keys.update((i,k) for k in cat)
+    covered={}
+    for name,value in tensors.items():
+        raw_name,expert=origin(name);fi=value[1]
+        if fi not in catalogs or raw_name not in catalogs[fi]:raise ValueError('Native role references wrong source file/name')
+        check_tensor(value,catalogs[fi][raw_name],expert)
+        seen=covered.setdefault((fi,raw_name),set())
+        if expert in seen:raise ValueError('Duplicate source tensor/slice')
+        seen.add(expert)
+    if set(covered)!=source_keys:raise ValueError('Source tensor missing from native pack')
+    for (fi,name),ids in covered.items():
+        if ids!={None}:
+            n=catalogs[fi][name][3][0]
+            if len(ids)!=n or min(ids)!=0 or max(ids)!=n-1:raise ValueError('Incomplete expert slices')
+    if not kv or kv['general.architecture']!='minimax-m3':raise ValueError('Architecture identity mismatch')
+    layers=int(kv['minimax-m3.block_count'])
+    if layers!=60:raise ValueError('This prepared target requires the MiniMax-M3.1 depth')
+    raw_names={name for cat in catalogs.values() for name in cat}
+    if not set(p.GLOBAL).issubset(raw_names):raise ValueError('Main embedding/norm/head missing')
+    if any(f'blk.{layer}.{role}' not in raw_names for layer in range(layers) for role in p.INDEXER):
+        raise ValueError('Sparse indexer missing; dense substitution is forbidden')
+    if not any(name.startswith('dspark.') for name in tensors):raise ValueError('Requested DSpark absent')
+    expected={'hidden_size':int(kv['minimax-m3.embedding_length']),'num_hidden_layers':layers,
+              'vocab_size':len(kv['tokenizer.ggml.tokens'])}
+    if any(int(geo[key])!=value for key,value in expected.items()):raise ValueError('Target geometry differs from headers')
+    if int(geo.get('gguf.identity_expert_scales','-1'))!=scales:raise ValueError('Identity-scale proof count differs')
+    tok=json.loads((pack/'tokenizer/tokenizer.json').read_text('utf-8'))
+    if tok.get('pre')!='minimax' or tok.get('model_arch')!='minimax-m3':raise ValueError('Tokenizer identity mismatch')
+    expected_tokens=kv['tokenizer.ggml.tokens']
+    expected_vocab={token:i for i,token in enumerate(expected_tokens)}
+    vocab=json.loads((pack/'tokenizer/vocab.json').read_text('utf-8'))
+    if (not isinstance(vocab,dict) or len(expected_vocab)!=len(expected_tokens) or vocab!=expected_vocab or
+        any(type(i) is not int for i in vocab.values()) or
+        json.loads((pack/'tokenizer/token_type.json').read_text('utf-8'))!=kv.get('tokenizer.ggml.token_type',[1]*len(expected_tokens)) or
+        (pack/'tokenizer/merges.txt').read_text('utf-8').splitlines()!=kv.get('tokenizer.ggml.merges',[])):
+        raise ValueError('Tokenizer vocabulary/types/merges differ from source')
+    return {'status':'passed','native_tensors':len(tensors),'source_tensors':len(source_keys),'weight_files':len(files),
+            'all_role_offsets_types_shapes_verified':True,'all_expert_slices_covered':True,'identity_scale_count':scales,
+            'layout_only':True,'matrix_payload_read':False,'full_weights_rehashed':False,'model_GPU_qualified':False}
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    for flag in ('project-root','pack','model-root','receipt'):ap.add_argument('--'+flag,type=Path,required=True)
+    a=ap.parse_args();print(json.dumps(verify(a.project_root,a.pack,a.model_root,a.receipt)))
+
+if __name__=='__main__':main()
