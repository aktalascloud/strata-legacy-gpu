+#if defined(STRATA_EXPERIMENTAL_SM60) && !defined(__HIPCC__)
+__global__ void fetch_stripes(const unsigned long long* __restrict__ src, const int32_t* __restrict__ n,
+                              uint4* __restrict__ dst, int per) {
+    for (int blob = blockIdx.y; blob < *n; blob += gridDim.y) {
+        const auto* from = reinterpret_cast<const uint4*>(src[blob]);
+        auto* to = dst + static_cast<size_t>(blob) * per;
+        for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < per; i += gridDim.x * blockDim.x)
+            to[i] = from[i];
+    }
+}
+
+bool fetch_stripes_sm61() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("STRATA_PCIE_FETCH_STRIPES");
+        return value && value[0] == '1' && value[1] == '\0';
+    }();
+    if (!enabled) return false;
+    int dev = -1;
+    if (cudaGetDevice(&dev) != cudaSuccess) return false;
+    static thread_local int cached_dev = -1;
+    static thread_local bool sm61 = false;
+    if (cached_dev != dev) {
+        int major = 0, minor = 0;
+        sm61 = cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev) == cudaSuccess &&
+               cudaDeviceGetAttribute(&minor, cudaDevAttrComputeCapabilityMinor, dev) == cudaSuccess &&
+               major == 6 && minor == 1;
+        cached_dev = dev;
+    }
+    return sm61;
+}
+#endif
+
 __global__ void res_patch_kernel(int32_t* __restrict__ table, const volatile int32_t* pairs, int n) {
     for (int k = blockIdx.x * blockDim.x + threadIdx.x; k < n; k += gridDim.x * blockDim.x) table[pairs[2 * k]] = pairs[2 * k + 1];
 }
