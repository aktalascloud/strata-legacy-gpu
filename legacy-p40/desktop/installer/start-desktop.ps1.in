Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$root = [IO.Path]::GetFullPath((Split-Path -Parent $PSScriptRoot))
$app = Join-Path $root 'app\strata-desktop.exe'
$python = Join-Path $root 'app\control\python\python.exe'
$manifest = Join-Path $root 'bundle-integrity.json'
$manifestHash = '@@BUNDLE_HASH@@'
function Get-Sha256([string]$path) {
  $stream = [IO.File]::OpenRead($path)
  $sha = [Security.Cryptography.SHA256]::Create()
  try { [BitConverter]::ToString($sha.ComputeHash($stream)).Replace('-', '') }
  finally { $sha.Dispose(); $stream.Dispose() }
}
if (-not [Environment]::UserInteractive -or [Diagnostics.Process]::GetCurrentProcess().SessionId -eq 0) { throw 'Strata Desktop requires an interactive user session.' }
if ((Get-Sha256 $manifest) -ine $manifestHash) { throw 'The installer integrity manifest changed.' }
$metadata = Get-Content -LiteralPath $manifest -Raw | ConvertFrom-Json
if ((Get-Sha256 $app) -ine $metadata.desktop_sha256) { throw 'The reviewed Desktop EXE changed.' }
$modelsFile = Join-Path $root 'install\models-directory.txt'
$modelsDir = [IO.File]::ReadAllText($modelsFile, [Text.Encoding]::UTF8).TrimEnd([char[]]"`r`n")
if (-not [IO.Path]::IsPathRooted($modelsDir) -or -not (Test-Path -LiteralPath $modelsDir -PathType Container)) { throw 'The selected models folder is unavailable.' }
$receiptHash = & $python -B (Join-Path $root 'tools\prepare_receipt.py') --root $root --integrity-sha256 $manifestHash
if ($LASTEXITCODE -ne 0 -or $receiptHash -notmatch '^[0-9a-f]{64}$') { throw 'The runtime receipt is invalid.' }
$mutex = [Threading.Mutex]::new($false, 'Local\StrataDesktopProfileStart')
$held = $false
try {
  try { $held = $mutex.WaitOne(0) } catch [Threading.AbandonedMutexException] { $held = $true }
  if (-not $held) { Write-Output 'Strata Desktop is already starting.'; return }
  $session = [Diagnostics.Process]::GetCurrentProcess().SessionId
  $running = @([Diagnostics.Process]::GetProcessesByName('strata-desktop') | Where-Object { $_.SessionId -eq $session -and $_.MainModule.FileName -ieq $app })
  if ($running.Count) { Write-Output 'Strata Desktop is already running.'; return }
  $si = [Diagnostics.ProcessStartInfo]::new($app)
  $si.UseShellExecute = $false
  $si.WorkingDirectory = $root
  $envs = @{
    STRATA_HOME = Join-Path $root 'home'
    STRATA_MODELS_DIR = $modelsDir
    STRATA_WORKSPACE = Join-Path $root 'workspace'
    STRATA_COMPONENTS_DIR = Join-Path $root 'components'
    STRATA_INSTALL_DIR = Join-Path $root 'install'
    STRATA_PROFILE_DIR = Join-Path $root 'profiles'
    STRATA_RUNTIME_DIR = Join-Path $root 'runtime\control'
    STRATA_STATE_DIR = Join-Path $root 'state'
    STRATA_SETTINGS_FILE = Join-Path $root 'app-settings.json'
    STRATA_DESKTOP_DATA_DIR = $root
    STRATA_DESKTOP_AUTOSTART_MODEL = 'swift-1.5-iq3-s'
    STRATA_DESKTOP_AUTOSTART_PORT = '8093'
    STRATA_DESKTOP_LEGACY_LOCK_FILE = Join-Path $root 'runtime\server.lock'
    STRATA_DESKTOP_DLL_RECEIPT = Join-Path $root 'dll-receipt.json'
    STRATA_DESKTOP_DLL_RECEIPT_SHA256 = $receiptHash
    STRATA_NO_REPAIR_ACCESS = '1'; STRATA_NO_BUNDLED_ENGINE = '1'; STRATA_NO_ACQUIRE = '1'; STRATA_KEEP_LEFTOVERS = '1'
    STRATA_SERVER_URL = 'http://127.0.0.1:1'
  }
  foreach ($key in $envs.Keys) { $si.EnvironmentVariables[$key] = $envs[$key] }
  foreach ($key in @('PYTHONHOME','PYTHONPATH','VIRTUAL_ENV','STRATA_API_KEY')) { $si.EnvironmentVariables.Remove($key) }
  $child = [Diagnostics.Process]::Start($si)
  [Threading.Thread]::Sleep(2000)
  $child.Refresh()
  if ($child.HasExited) { throw "Desktop exited during startup: $($child.ExitCode)" }
} finally {
  if ($held) { $mutex.ReleaseMutex() }
  $mutex.Dispose()
}
